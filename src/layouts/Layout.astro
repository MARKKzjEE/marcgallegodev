---
import type { Lang } from '../i18n/index';
import { getAlternatePath, useTranslations, withSlash } from '../i18n/index';

interface Props {
	title?: string;
	description?: string;
	lang?: Lang;
	/** Páginas que no deben indexarse (ej. 404): noindex y sin canonical/hreflang */
	noindex?: boolean;
}

const { lang = 'es', noindex = false } = Astro.props;
const t = useTranslations(lang);
const { title = t.meta.defaultTitle, description = t.meta.defaultDescription } = Astro.props;

const site = Astro.site!;
const currentPath = withSlash(Astro.url.pathname);
const canonicalURL = new URL(currentPath, site).href;
const siteURL = new URL('/', site).href;
const personId = `${siteURL}#person`;
const ogImage = new URL('/assets/og-image.jpg', site).href;

// Alt de la imagen OG, localizado por idioma.
const ogImageAlt = lang === 'en'
	? 'Marc Gallego — Full Stack Software Engineer in Barcelona'
	: 'Marc Gallego — Ingeniero de Software Full Stack en Barcelona';

// ┌─────────────────────────────────────────────────────────┐
// │  SPLASH DE CARGA — interruptor único                      │
// │  true  = splash activado (solo en home)                   │
// │  false = desactivado (la web entra directa)               │
// └─────────────────────────────────────────────────────────┘
const SPLASH_ENABLED = true;

const isHome = currentPath === '/' || currentPath === '/en/';
// Solo se muestra el splash si está activado Y estamos en home
const showSplash = SPLASH_ENABLED && isHome;

// hreflang alternate URLs
const { esHref, enHref } = getAlternatePath(currentPath);
const esURL = new URL(esHref, site).href;
const enURL = new URL(enHref, site).href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="MarcGallego" />
		<link rel="manifest" href="/site.webmanifest" />
		{noindex ? (
			<meta name="robots" content="noindex, follow" />
		) : (
			<>
				<link rel="canonical" href={canonicalURL} />
				<link rel="alternate" hreflang="es" href={esURL} />
				<link rel="alternate" hreflang="en" href={enURL} />
				<link rel="alternate" hreflang="x-default" href={esURL} />
			</>
		)}
		<!-- Preload fuentes críticas above-the-fold (NORD Bold solo la usa el splash de la home) -->
		<link rel="preload" href="/fonts/NORD/NORD-Black.woff2" as="font" type="font/woff2" crossorigin />
		{showSplash && <link rel="preload" href="/fonts/NORD/NORD-Bold.woff2" as="font" type="font/woff2" crossorigin />}
		<link rel="preload" href="/fonts/Monoblock/Monoblock-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Marc Gallego" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
		<meta property="og:locale:alternate" content={lang === 'en' ? 'es_ES' : 'en_US'} />
		<meta property="og:site_name" content={t.meta.siteName} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@marcgallegodev" />
		<meta name="twitter:creator" content="@marcgallegodev" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<!-- Theme color (= --primary de cada tema) -->
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

		<!-- JSON-LD: WebSite schema (autoridad del sitio + idioma) -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"@id": `${siteURL}#website`,
			"name": t.meta.siteName,
			"url": siteURL,
			"description": t.meta.defaultDescription,
			"inLanguage": lang,
			"author": { "@id": personId }
		})} />

		<!-- JSON-LD: Person schema (las páginas lo amplían referenciando el mismo @id) -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"@id": personId,
			"name": "Marc Gallego",
			"url": siteURL,
			"jobTitle": "Full Stack Software Engineer",
			"description": t.meta.defaultDescription,
			"image": ogImage,
			"sameAs": [
				"https://linkedin.com/in/marcgallegodev"
			],
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Barcelona",
				"addressCountry": "ES"
			},
			"alumniOf": {
				"@type": "EducationalOrganization",
				"name": "Universitat Autònoma de Barcelona"
			},
			"knowsAbout": ["Laravel", "Django", "React", "Angular", "Node.js", "Docker", "CI/CD", "Astro", "TypeScript"]
		})} />

		<script is:inline>
			const root = document.documentElement;
			// Con cookies/almacenamiento bloqueados, acceder a localStorage o
			// sessionStorage lanza SecurityError → siempre dentro de try/catch.
			let stored = null;
			try { stored = localStorage.getItem("theme"); } catch (e) {}
			const prefersDark = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)").matches : null;
			// Si no hay preferencia guardada, respeta el sistema; si no hay dato de sistema, usa oscuro por defecto
			const isDark = stored === "dark" || (!stored && (prefersDark ?? false));
			root.classList.toggle("dark", isDark);

			// Splash solo la 1ª vez por sesión: si ya se vio en esta sesión,
			// marcamos html antes del paint para ocultarlo por CSS (sin flash).
			try {
				if (sessionStorage.getItem("splashSeen")) root.classList.add("splash-seen");
			} catch (e) {}
		</script>
	</head>
	<body>
		<!-- ─── Splash screen (solo home) ─── -->
		{showSplash && (
			<div id="splash">
				<span class="splash-inner">
					<span class="splash-word splash-word--name" data-splash-word>
						<span class="splash-text">MARC GALLEGO</span>
						<!-- Asteriscos a mano (estilo FAQ): destellan de uno en uno -->
						<span class="deco deco--stars" aria-hidden="true">
							<svg class="deco-star deco-star--1" viewBox="0 0 40 40" fill="none"><path d="M20 4 L20 36 M6 12 L34 28 M34 12 L6 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
							<svg class="deco-star deco-star--2" viewBox="0 0 40 40" fill="none"><path d="M20 4 L20 36 M6 12 L34 28 M34 12 L6 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
							<svg class="deco-star deco-star--3" viewBox="0 0 40 40" fill="none"><path d="M20 4 L20 36 M6 12 L34 28 M34 12 L6 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
						</span>
					</span>

					<span class="splash-sep"></span>

					<span class="splash-word splash-word--role" data-splash-word>
						<span class="splash-text">portfolio</span>
						<span class="deco deco--strike" aria-hidden="true"></span>
						<svg class="deco deco--circle" viewBox="0 0 240 80" preserveAspectRatio="none" aria-hidden="true">
							<path d="M120,6 C200,2 236,22 234,42 C232,66 150,76 90,75 C30,74 6,60 6,40 C6,20 44,7 130,8" />
						</svg>
					</span>
				</span>
			</div>
		)}
		<script is:inline define:vars={{ showSplash }}>
			// El splash solo se reproduce la 1ª vez por sesión. Si ya se vio en esta
			// sesión (marca en sessionStorage + clase html.splash-seen del pre-paint),
			// se trata como si no hubiera splash: arranca el Hero directamente.
			var splashAlreadySeen = false;
			try { splashAlreadySeen = !!sessionStorage.getItem("splashSeen"); } catch (e) {}
			if (showSplash && !splashAlreadySeen) {
				try { sessionStorage.setItem("splashSeen", "1"); } catch (e) {}
				var splashReady = false;
				var splashLoaded = false;
				var splashDone = false;

				// ─── Decoraciones coreografiadas (secuencia encadenada) ───
				var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				// Cada paso: { word: índice de palabra (0=name, 1=role), deco }
				var SEQUENCE = [
					{ word: 0, deco: 'stars' },      // asteriscos en MARC GALLEGO
					{ word: 1, deco: 'circle' },     // círculo en portfolio
					{ word: 1, deco: 'strike' },     // tachar portfolio
				];

				var START_MS = 400;   // respiro inicial (todo limpio)
				var DRAW_MS  = 360;    // trazado
				var HOLD_MS  = 320;    // mantener visible
				var ERASE_MS = 220;    // borrado

				var LOOP_GAP_MS = 500;  // pausa entre vueltas de la coreografía

				function runDecoLoop() {
					if (reduceMotion) return;
					var words = Array.prototype.slice.call(document.querySelectorAll('[data-splash-word]'));
					if (words.length < 2) return;

					var i = 0;
					function step() {
						if (splashDone) return;
						// Fin de la secuencia → reinicia en bucle (mientras el splash siga visible),
						// así nunca queda estático si la página tarda en cargar.
						if (i >= SEQUENCE.length) {
							i = 0;
							setTimeout(step, LOOP_GAP_MS);
							return;
						}
						var s = SEQUENCE[i];
						var word = words[s.word];
						word.setAttribute('data-deco', s.deco);

						setTimeout(function () {
							if (splashDone) return;
							word.setAttribute('data-deco-erase', '');
							setTimeout(function () {
								if (splashDone) return;
								word.removeAttribute('data-deco');
								word.removeAttribute('data-deco-erase');
								i++;
								step();
							}, ERASE_MS);
						}, DRAW_MS + HOLD_MS);
					}

					setTimeout(step, START_MS);
				}

				function hideSplash() {
					var splash = document.getElementById('splash');
					if (!splash) return;
					splashDone = true;
					splash.classList.add('is-hidden');
					window.dispatchEvent(new CustomEvent('splash:done'));
					setTimeout(function() { splash.remove(); }, 600); // Espera a que termine la transición antes de remover del DOM
				}

				// Arrancar las decoraciones cuando las fuentes (NORD, Monoblock) estén
				// listas → el texto no "salta" (FOUT) al cambiar de la fuente de
				// fallback a la real. Si la API no existe, arranca igualmente.
				if (document.fonts && document.fonts.ready) {
					document.fonts.ready.then(runDecoLoop);
				} else {
					runDecoLoop();
				}

				// Cierre: mínimo 3s visible Y página cargada. Si la carga tarda más,
				// el splash se alarga (las animaciones siguen en bucle, no queda estático).
				setTimeout(function() {
					splashReady = true;
					if (splashLoaded) hideSplash();
				}, 3000);

				window.addEventListener('load', function() {
					splashLoaded = true;
					if (splashReady) hideSplash();
				});
			} else {
				// Sin splash (no es home, o ya se vio en esta sesión): quitamos el
				// splash del DOM si estaba renderizado (visita repetida) y disparamos
				// splash:done para que el Hero arranque ya.
				var existingSplash = document.getElementById('splash');
				if (existingSplash) existingSplash.remove();

				function fireDone() { window.dispatchEvent(new CustomEvent('splash:done')); }
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', fireDone, { once: true });
				} else {
					fireDone();
				}
			}
		</script>
		<slot />
	</body>
</html>

<style is:global>
	@import "../styles/tailwind.css";

	/* ─── Splash screen ─── */
	#splash {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: var(--primary);
		transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1), visibility 600ms;
	}

	#splash.is-hidden {
		opacity: 0;
		visibility: hidden;
	}

	/* Ya visto en esta sesión: ocultar de inmediato (sin flash ni transición) */
	:global(html.splash-seen) #splash {
		display: none;
	}

	.splash-inner {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 2rem);
		color: var(--secondary);
	}

	.splash-sep {
		width: 1px;
		height: 2em;
		background-color: var(--secondary);
		flex-shrink: 0;
	}

	/* Cada palabra es el lienzo de sus decoraciones */
	.splash-word {
		position: relative;
		display: inline-block;
		white-space: nowrap;
	}

	.splash-text { position: relative; z-index: 1; display: inline-block; }

	.splash-word--name .splash-text {
		font-family: "NORD", system-ui, sans-serif;
		font-weight: 700;
		font-size: clamp(1rem, 3vw, 1.5rem);
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.splash-word--role .splash-text {
		font-family: "Monoblock", system-ui, sans-serif;
		font-weight: 400;
		font-size: clamp(0.7rem, 1.5vw, 0.85rem);
		letter-spacing: 0.5em;
	}

	/* Base de toda decoración */
	.deco {
		position: absolute;
		pointer-events: none;
		opacity: 0;
		z-index: 2;
	}

	/* ── Tachado: línea real que se traza con scaleX ── */
	.deco--strike {
		left: -0.1em;
		right: -0.1em;
		top: 50%;
		width: auto;
		height: 1px;
		background-color: var(--secondary);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 120ms ease;
	}

	/* ── Círculo a mano alzada ── */
	/* Ancho FIJO en ch+em (no depende de la caja del texto, que iOS y el Mac
	   miden distinto) → el óvalo es idéntico en todos los dispositivos.
	   "portfolio" = 9 caracteres · letter-spacing 0.5em. */
	.deco--circle {
		left: 50%;
		top: 50%;
		width: calc(9ch + 4.5em);
		height: 2.4em;
		transform: translate(-50%, -50%);
		overflow: visible;
		fill: none;
	}
	/* Móvil: texto más pequeño → el óvalo necesita algo menos de margen extra. */
	@media (max-width: 767px) {
		.deco--circle { width: calc(9ch + 3.5em); }
	}
	.deco--circle path {
		fill: none;
		stroke: var(--secondary);
		/* 1px (non-scaling) → mismo grosor que el tachado y el separador. */
		stroke-width: 1;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
		stroke-dasharray: 620;
		stroke-dashoffset: 620;
		transition: stroke-dashoffset 480ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* ── Asteriscos a mano salpicados (a la izquierda del nombre) ── */
	.deco--stars {
		inset: 0;
		display: block;
		overflow: visible;
	}
	.deco-star {
		position: absolute;
		color: var(--secondary);
		opacity: 0;
		transform: scale(0) rotate(-20deg);
		transform-origin: center;
	}
	/* Tres posiciones/tamaños distintos, salpicados a la izquierda del nombre,
	   separados del texto para que no lo pisen. */
	.deco-star--1 { width: 22px; height: 22px; top: -0.7em;  left: -1.6em; }
	.deco-star--2 { width: 15px; height: 15px; top: 0.1em;   left: -2.2em; }
	.deco-star--3 { width: 12px; height: 12px; top: -1.3em;  left: -1.2em; }

	/* Cada asterisco hace su destello (pop in → out) en su propia ventana,
	   de forma que solo se ve UNO a la vez, saltando por las posiciones. */
	@keyframes star-blink {
		0%   { opacity: 0; transform: scale(0) rotate(-20deg); }
		25%  { opacity: 1; transform: scale(1) rotate(0deg); }
		75%  { opacity: 1; transform: scale(1) rotate(0deg); }
		100% { opacity: 0; transform: scale(0) rotate(15deg); }
	}

	/* ── Estados activados por data-deco ── */
	.splash-word[data-deco="strike"] .deco--strike { opacity: 1; transform: scaleX(1); }

	/* Asteriscos de uno en uno: cada uno destella en su turno (≈220ms),
	   encadenados con animation-delay → solo se ve uno a la vez saltando. */
	.splash-word[data-deco="stars"] .deco--stars { opacity: 1; }
	.splash-word[data-deco="stars"] .deco-star {
		animation: star-blink 220ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}
	.splash-word[data-deco="stars"] .deco-star--1 { animation-delay: 0ms; }
	.splash-word[data-deco="stars"] .deco-star--2 { animation-delay: 200ms; }
	.splash-word[data-deco="stars"] .deco-star--3 { animation-delay: 400ms; }

	.splash-word[data-deco="circle"]  .deco--circle { opacity: 1; }
	.splash-word[data-deco="circle"]  .deco--circle path { stroke-dashoffset: 0; }

	/* ── Borrado: fade out rápido (sin re-animar el trazado) ── */
	.splash-word[data-deco-erase] .deco {
		opacity: 0;
		transition: opacity 200ms ease;
	}

	@media (prefers-reduced-motion: reduce) {
		#splash .deco { display: none; }
	}

	/* Circle Reveal Effect */
	.reveal-layer {
		position: absolute;
		inset: calc(-1 * var(--reveal-extend, 0px));
		z-index: 2;
		clip-path: circle(
			var(--r, 0px) at
			calc(var(--cx, -100px) + var(--reveal-extend, 0px))
			calc(var(--cy, -100px) + var(--reveal-extend, 0px))
		);
		transition: clip-path 350ms cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal-layer {
			transition: none;
		}
	}
</style>

