---
interface Props {
	title?: string;
	description?: string;
	keywords?: string;
}

const defaultDescription = "Portfolio de Marc Gallego, Ingeniero del Software y desarrollador Full Stack freelance. Desarrollo web, aplicaciones y soluciones digitales a medida.";
const defaultKeywords = "Marc Gallego, desarrollador Full Stack, Software Engineer, Barcelona, freelance developer, desarrollo web, aplicaciones móviles";
const { title = "Marc Gallego | Desarrollador Full Stack", description = defaultDescription, keywords = defaultKeywords } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://marcgallegodev.com').href;
---

<!doctype html>
<html lang="es" class="">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<!-- Preload fuentes críticas above-the-fold -->
		<link rel="preload" href="/fonts/NORD/NORD-Black.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/NORD/NORD-Bold.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Vogun-Medium.woff2" as="font" type="font/woff2" crossorigin />
		<!-- Preload poster del vídeo hero -->
		<link rel="preload" href="/assets/bg-background-loop-poster.webp" as="image" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Marc Gallego" />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-CT" />
		<meta name="geo.placename" content="Barcelona" />
		<meta name="geo.position" content="41.3851;2.1734" />
		<meta name="ICBM" content="41.3851, 2.1734" />
		<meta name="googlebot" content="index, follow" />
		<meta name="bingbot" content="index, follow" />
		<meta name="yandexbot" content="index, follow" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://marcgallegodev.com/assets/og-image.webp" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Marc Gallego" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@marcgallegodev" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://marcgallegodev.com/assets/og-image.webp" />

		<!-- Theme color -->
		<meta name="theme-color" content="rgb(212, 212, 212)" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="rgb(18, 18, 18)" media="(prefers-color-scheme: dark)" />

		<!-- JSON-LD: Person schema -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Marc Gallego",
			"url": "https://marcgallegodev.com",
			"jobTitle": "Full Stack Software Engineer",
			"description": defaultDescription,
			"sameAs": [
				"https://linkedin.com/in/marcgallegodev",
				"https://github.com/marcgallegodev"
			],
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Barcelona",
				"addressCountry": "ES"
			}
		})} />

		<script is:inline>
			const root = document.documentElement;
			const stored = localStorage.getItem("theme");
			const prefersDark = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)").matches : null;
			// Si no hay preferencia guardada, respeta el sistema; si no hay dato de sistema, usa oscuro por defecto
			const isDark = stored === "dark" || (!stored && (prefersDark ?? true));
			root.classList.toggle("dark", isDark);
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	@import "../styles/tailwind.css";

	/* Circle Reveal Effect */
	.reveal-layer {
		position: absolute;
		inset: calc(-1 * var(--reveal-extend, 0px));
		z-index: 2;
		clip-path: circle(
			var(--r, 0px) at
			calc(var(--cx, -100px) + var(--reveal-extend, 0px))
			calc(var(--cy, -100px) + var(--reveal-extend, 0px))
		);
		transition: clip-path 350ms cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal-layer {
			transition: none;
		}
	}
</style>

<script>
	// Sync the toggle with the theme applied on initial load
	const root = document.documentElement;
	const toggle = document.querySelector<HTMLInputElement>('#theme-toggle input[type="checkbox"]');
	if (toggle) {
		toggle.checked = !root.classList.contains("dark");
		toggle.addEventListener("change", () => {
			const isDark = !toggle.checked;
			root.classList.toggle("dark", isDark);
			localStorage.setItem("theme", isDark ? "dark" : "light");
		});
	}
</script>
