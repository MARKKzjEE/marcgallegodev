---
import { getLang, useTranslations } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section id="hero-v2" aria-label={t.hero.sectionAriaLabel}>

	<!-- Gradient Unicorn -->
	<div id="hero-v2-gradient" aria-hidden="true"></div>

	<script src="/unicorn/unicornStudio.umd.js" is:inline></script>
	<script is:inline>
		var unicornScene = null;

		function getGradientFile() {
			return document.documentElement.classList.contains('dark')
				? '/unicorn/mouse-tracking-gradient.json'
				: '/unicorn/mouse-tracking-gradient-light.json';
		}

		function loadScene() {
			if (unicornScene) {
				unicornScene.destroy();
				unicornScene = null;
			}
			UnicornStudio.addScene({
				elementId: 'hero-v2-gradient',
				fps: 60,
				scale: 1,
				dpi: window.devicePixelRatio || 1,
				filePath: getGradientFile(),
				interactivity: { mouse: { disableMobile: false } }
			}).then(function(scene) {
				unicornScene = scene;
			});
		}

		document.addEventListener('DOMContentLoaded', function () {
			loadScene();

			// Recargar cuando cambie el tema
			const observer = new MutationObserver(function(mutations) {
				mutations.forEach(function(mutation) {
					if (mutation.attributeName === 'class') {
						loadScene();
					}
				});
			});
			observer.observe(document.documentElement, { attributes: true });
		});
	</script>

	<!-- Banda nombre -->
	<div class="name-band">

		<!-- Banda superior: rol repetido -->
		<div class="name-bar"></div>
		<div class="info-band info-band--role font-nord" data-role-band>Full Stack Software Engineer</div>

		<!-- Nombre -->
		<div class="name-bar"></div>
		<div class="name-content">
			<h1 class="font-nord font-black text-secondary hero-name" data-typewriter>
				<div class="name-clip"><span class="name-word">Marc</span></div>
				<div class="name-clip"><span class="name-word">Gallego</span></div>
			</h1>
		</div>

		<!-- Banda inferior: stats -->
		<div class="name-bar"></div>
		<div class="info-band info-band--stats font-nord" data-stats-band>
			<span class="stat-item">{lang === 'en' ? '+5 years exp.' : '+5 años exp.'}</span>
			<span class="sep" data-sep></span>
			<span class="stat-item">{lang === 'en' ? '+60 projects' : '+60 proyectos'}</span>
			<span class="sep" data-sep></span>
			<span class="stat-item">{lang === 'en' ? 'since 2018' : 'desde 2018'}</span>
			<span class="sep" data-sep></span>
			<span class="stat-item">Barcelona</span>
		</div>
		<div class="name-bar"></div>

	</div>

</section>

<script>
	const CHAR_MS  = 75;  // velocidad por carácter
	const WORD_GAP = 220; // pausa entre "Marc" y "Gallego"
	const CURSOR_LINGER = 900; // cuánto sigue parpadeando al acabar

	const hero = document.querySelector<HTMLElement>('[data-typewriter]');
	if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const words = hero.querySelectorAll<HTMLElement>('.name-word');
		let offset = 0;

		words.forEach((word, wi) => {
			const text = word.textContent ?? '';
			word.textContent = '';
			if (wi > 0) offset += WORD_GAP;

			[...text].forEach((ch) => {
				const span = document.createElement('span');
				span.className = 'char';
				span.style.setProperty('--d', `${offset}ms`);
				span.textContent = ch;
				word.appendChild(span);
				offset += CHAR_MS;
			});
		});

		// Cursor al final de la última palabra
		const lastWord = words[words.length - 1];
		const cursor = document.createElement('span');
		cursor.className = 'cursor';
		lastWord?.appendChild(cursor);

		// Desvanece el cursor tras acabar
		setTimeout(() => cursor.classList.add('is-done'), offset + CURSOR_LINGER);
	}

// ─── Role band: repeat role text (max 4) + fill gaps with "/" ───
function fillRoleBand() {
	const band = document.querySelector<HTMLElement>('[data-role-band]');
	if (!band) return;

	if (!band.dataset.role) band.dataset.role = band.textContent?.trim() ?? '';
	const roleText = band.dataset.role;
	if (!roleText) return;

	// Measure text and slash widths
	const probe = document.createElement('span');
	probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;font-size:inherit;font-family:inherit;font-weight:inherit;';
	probe.textContent = roleText;
	band.appendChild(probe);
	const textW = probe.getBoundingClientRect().width;
	probe.textContent = '/';
	const charW = probe.getBoundingClientRect().width;
	band.removeChild(probe);
	if (textW <= 0 || charW <= 0) return;

	const cs = getComputedStyle(band);
	const bandW = band.getBoundingClientRect().width
		- parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);

	// Rough upper bound: how many texts fit ignoring sep+padding overhead
	let count = Math.min(4, Math.max(1, Math.floor(bandW / textW)));

	function build(n: number) {
		band!.innerHTML = '';
		for (let i = 0; i < n; i++) {
			const item = document.createElement('span');
			item.className = 'role-item';
			item.textContent = roleText!;
			band!.appendChild(item);
			if (i < n - 1) {
				const sep = document.createElement('span');
				sep.className = 'role-sep';
				band!.appendChild(sep);
			}
		}
	}

	build(count);

	// If any sep can't fit at least 1 slash, reduce count and rebuild once
	const seps = [...band.querySelectorAll<HTMLElement>('.role-sep')];
	if (count > 1 && seps.some(s => s.getBoundingClientRect().width < charW)) {
		count--;
		build(count);
	}

	// Fill each sep based on its flex-computed width
	band.querySelectorAll<HTMLElement>('.role-sep').forEach(sep => {
		const w = sep.getBoundingClientRect().width;
		sep.textContent = '/'.repeat(Math.max(1, Math.floor(w / charW)));
	});
}

fillRoleBand();
const roleBand = document.querySelector('[data-role-band]');
if (roleBand) new ResizeObserver(fillRoleBand).observe(roleBand);

// ─── Stats band: fill separators with "/" ───
function fillStatSeps() {
	const band = document.querySelector<HTMLElement>('[data-stats-band]');
	if (!band) return;
	const seps = [...band.querySelectorAll<HTMLElement>('[data-sep]')];
	if (!seps.length) return;

	// Measure "/" character width using a hidden probe that inherits band styles
	const probe = document.createElement('span');
	probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;font-size:inherit;font-family:inherit;font-weight:inherit;';
	probe.textContent = '/';
	band.appendChild(probe);
	const charW = probe.getBoundingClientRect().width;
	band.removeChild(probe);
	if (charW <= 0) return;

	// Each sep has flex:1 — measure its flex-computed width and fill exactly
	seps.forEach(sep => {
		const w = sep.getBoundingClientRect().width;
		const count = Math.max(1, Math.floor(w / charW));
		sep.textContent = '/'.repeat(count);
	});
}

fillStatSeps();
const statBand = document.querySelector('[data-stats-band]');
if (statBand) new ResizeObserver(fillStatSeps).observe(statBand);
</script>

<style lang="scss">
	#hero-v2 {
		display: flex;
		flex-direction: column;
		height: 100vh;
		overflow: hidden;
	}

	#hero-v2-gradient {
		flex: 1;
		width: 100%;
		min-height: 0;
	}

	// ─── Banda nombre ───
	.name-band {
		background-color: var(--primary);
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
	}

	.name-bar {
		height: 1px;
		background-color: var(--secondary);
		flex-shrink: 0;
	}

	.name-content {
		padding: 0.5rem 1rem;

		@media (min-width: 768px) {
			padding: 0.5rem 2.5rem;
		}
	}

	// ─── Info bands ───
	.info-band {
		overflow: hidden;
		white-space: nowrap;
		padding: 0.4rem 1rem;
		font-size: 0.7rem;
		font-weight: 500;
		color: var(--secondary);

		@media (min-width: 768px) {
			padding: 0.4rem 2.5rem;
			font-size: 0.75rem;
		}
	}

	.info-band--role {
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	:global(.role-item) {
		flex-shrink: 0;
		padding: 0 0.9em;
		&:first-child { padding-left: 0; }
		&:last-child  { padding-right: 0; }
	}

	:global(.role-sep) {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
	}

	.info-band--stats {
		display: flex;
		align-items: center;

		@media (min-width: 768px) {
			padding: 0.4rem 2.5rem;
		}

		.stat-item {
			flex-shrink: 0;
			padding: 0 0.9em;

			&:first-child { padding-left: 0; }
			&:last-child  { padding-right: 0; }
		}

		.sep {
			flex: 1;
			min-width: 0;
			overflow: hidden;
			white-space: nowrap;
		}
	}

	.hero-name {
		font-size: 11vw;
		line-height: 0.8;
		letter-spacing: -0.05em;
		width: 100%;
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.22em;
	}

	.name-clip { overflow: hidden; }
	.name-word { display: block; }

	// ─── Typewriter (global: elementos creados dinámicamente por JS) ───
	:global(.char) {
		display: inline-block;
		opacity: 0;
		animation: char-in 1ms step-end forwards;
		animation-delay: var(--d, 0ms);
	}

	@keyframes char-in {
		to { opacity: 1; }
	}

	:global(.cursor) {
		display: inline-block;
		width: 0.08em;
		height: 0.82em;
		background: currentColor;
		vertical-align: middle;
		margin-left: 0.05em;
		animation: cursor-blink 500ms step-end infinite;

		&.is-done {
			animation: cursor-fade 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
		}
	}

	@keyframes cursor-blink {
		50% { opacity: 0; }
	}

	@keyframes cursor-fade {
		to { opacity: 0; }
	}
</style>

