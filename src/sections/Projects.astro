---
import { Image } from 'astro:assets';
import { getLang, useTranslations } from '../i18n/index';
import { projectImages, projectColors } from '../data/projects';

interface Props {
	/** Indices of projects to show (e.g. [0, 2, 4, 6]). Omit to show all. */
	indices?: number[];
}

const { indices } = Astro.props;

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const allProjects = t.projects.items.map((item, i) => ({
	...item,
	image: projectImages[i],
	color: projectColors[i],
}));

const projects = indices
	? indices.map(i => allProjects[i]).filter(Boolean)
	: allProjects;
---

<section class="projects-section border-t border-secondary pt-16" id="proyectos-destacados">
	<!-- Header -->
	<div class="projects-header px-4 md:px-10">
		<h2 class="font-nord font-normal text-secondary projects-title">
			{t.projects.carousel.title}
		</h2>
		<p class="text-mono-label-soft mt-2">
			{t.projects.carousel.subtitle}
		</p>
	</div>

	<!-- Zona de imágenes: drag + cursor custom -->
	<div class="projects-images-wrapper" data-projects-track>
		<div class="projects-track" data-track>
			{projects.map((project, i) => (
				<div class="project-image-slot" data-index={i}>
					<div class="project-card-image" style={`background-color: ${project.color};`}>
						<Image
							src={project.image}
							alt={`${project.title} — ${project.description}`}
							widths={[600, 900, 1400]}
							sizes="(max-width: 768px) 85vw, 45vw"
							format="webp"
							quality={90}
							loading="lazy"
							draggable={false}
							class="project-img"
						/>
					</div>
				</div>
			))}
		</div>

		<!-- Custom cursor -->
		<div class="projects-cursor" data-cursor aria-hidden="true">
			<div class="projects-cursor-inner">
				<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M18 8L22 12L18 16"/>
					<path d="M6 8L2 12L6 16"/>
					<line x1="2" y1="12" x2="22" y2="12"/>
				</svg>
			</div>
		</div>
	</div>

	<!-- Info debajo: sincronizada por JS -->
	<div class="projects-info-row">
		{projects.map((project, i) => (
			<div class="project-info-item" data-info-index={i}>
				<h2 class="project-card-title font-monoblock font-medium text-secondary">{project.title}</h2>
				<p class="project-card-desc font-cottor font-light text-secondary/80">{project.description}</p>
			</div>
		))}
	</div>

	<!-- Pagination dots -->
	<div class="projects-dots" data-projects-dots>
		{projects.map((_, i) => (
			<button type="button" class:list={['projects-dot', { 'is-active': i === 0 }]} data-dot-index={i} aria-label={`Proyecto ${i + 1}`} />
		))}
	</div>
</section>

<style lang="scss">
.projects-section {
	overflow: hidden;
	position: relative;
	display: flex;
	flex-direction: column;
}

.projects-header {
	margin-bottom: 2rem;
}

.projects-title {
	font-size: clamp(35px, 8vw, 80px);
	line-height: 1;
}

// ─── Images zone (drag + cursor) ───

.projects-images-wrapper {
	position: relative;
	width: 100%;
	cursor: none;
	overflow: hidden;
	margin-bottom: 1.25rem;

	&:hover .projects-cursor {
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
	}
}

.projects-track {
	display: flex;
	gap: 2.5rem;
	padding: 0 2.5rem;

	@media (max-width: 767px) {
		gap: 1rem;
		padding: 0 1rem;
	}
	user-select: none;
	will-change: transform;
}

.project-image-slot {
	// 2 cards visible + peek of 3rd
	flex: 0 0 calc(45% - 2.5rem);
	scroll-snap-align: start;

	@media (max-width: 767px) {
		flex: 0 0 calc(75% - 1rem);
	}
}

.project-card-image {
	width: 100%;
	aspect-ratio: 4 / 3;
	overflow: hidden;
}

.project-img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
	-webkit-user-drag: none;
	pointer-events: none;
	transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.project-image-slot:hover .project-img {
	transform: scale(1.05);
}

// ─── Info row (no drag zone) ───

.projects-info-row {
	display: flex;
	gap: 2.5rem;
	padding: 0 2.5rem;
	will-change: transform;

	@media (max-width: 767px) {
		gap: 1rem;
		padding: 0 1rem;
	}
}

.project-info-item {
	flex: 0 0 calc(45% - 2.5rem);
	display: flex;
	@media (max-width: 767px) {
		flex: 0 0 calc(75% - 1rem);
	}
	flex-direction: column;
	gap: 0.2rem;
	padding-top: 1rem;
}

.project-card-title {
	font-size: clamp(1.1rem, 2vw, 1.4rem);
}

.project-card-desc {
	font-size: 0.875rem;
}

// ─── Pagination dots ───

.projects-dots {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	padding: 4rem 0 0 0;
}

.projects-dot {
	width: 8px;
	height: 8px;
	padding: 0;
	border: none;
	background: var(--secondary);
	opacity: 0.25;
	cursor: pointer;
	transition:
		width 400ms cubic-bezier(0.22, 1, 0.36, 1),
		height 400ms cubic-bezier(0.22, 1, 0.36, 1),
		opacity 400ms cubic-bezier(0.22, 1, 0.36, 1);

	&:hover {
		opacity: 0.6;
		width: 10px;
		height: 10px;
	}

	&.is-active {
		width: 14px;
		height: 14px;
		opacity: 1;
	}
}

// ─── Custom cursor ───

.projects-cursor {
	position: absolute;
	top: 0;
	left: 0;
	pointer-events: none;
	opacity: 0;
	transform: translate(-50%, -50%) scale(0.6);
	transition:
		opacity 400ms cubic-bezier(0.16, 1, 0.3, 1),
		transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
	z-index: 10;
	will-change: left, top;

	@media (max-width: 767px) {
		will-change: auto;
		transition:
			opacity 400ms cubic-bezier(0.16, 1, 0.3, 1),
			transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
			left 0ms,
			top 0ms;
	}
}

.projects-cursor-inner {
	width: 80px;
	height: 80px;

	@media (max-width: 767px) {
		width: 56px;
		height: 56px;
	}
	border-radius: 50%;
	background: var(--secondary);
	color: var(--primary);
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 3px;

	span {
		font-size: 0.5rem;
	}
}
</style>

<script>
	const wrapper = document.querySelector<HTMLElement>('[data-projects-track]');
	const track = wrapper?.querySelector<HTMLElement>('[data-track]');
	const cursor = wrapper?.querySelector<HTMLElement>('[data-cursor]');
	const infoRow = document.querySelector<HTMLElement>('.projects-info-row');
	const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-dot-index]'));

	if (wrapper && track && cursor && infoRow) {

		const originalSlots = Array.from(track.querySelectorAll<HTMLElement>('.project-image-slot'));
		const n = originalSlots.length;

		// ─── Position state (replaces scrollLeft) ───
		let currentX = 0;
		let targetSnapX = 0;
		let isSnapping = false;
		let snapRaf: number | null = null;

		function applyTranslate() {
			track!.style.transform = `translateX(${-currentX}px)`;
			infoRow!.style.transform = `translateX(${-currentX}px)`;
		}

		// ─── Slot geometry ───
		function getSlotPositions(): number[] {
			const allSlots = Array.from(track!.querySelectorAll<HTMLElement>('.project-image-slot'));
			if (!allSlots.length) return [];
			const padding = allSlots[0].offsetLeft;
			return allSlots.map(slot => slot.offsetLeft - padding);
		}

		function getBlockWidth(): number {
			const allSlots = Array.from(track!.querySelectorAll<HTMLElement>('.project-image-slot'));
			if (allSlots.length < n + 1) return 0;
			return allSlots[2 * n].offsetLeft - allSlots[n].offsetLeft;
		}

		// ─── Infinite loop: clone slots ───
		originalSlots.forEach(slot => {
			const clone = slot.cloneNode(true) as HTMLElement;
			clone.setAttribute('aria-hidden', 'true');
			track.appendChild(clone);
		});

		const clonesEnd = originalSlots.map(slot => {
			const clone = slot.cloneNode(true) as HTMLElement;
			clone.setAttribute('aria-hidden', 'true');
			return clone;
		});
		clonesEnd.forEach(clone => track.insertBefore(clone, originalSlots[0]));

		const infoOriginals = Array.from(infoRow.querySelectorAll<HTMLElement>('.project-info-item[data-info-index]'));
		infoOriginals.forEach(item => {
			const clone = item.cloneNode(true) as HTMLElement;
			clone.setAttribute('aria-hidden', 'true');
			infoRow.appendChild(clone);
		});
		infoOriginals.forEach(item => {
			const clone = item.cloneNode(true) as HTMLElement;
			clone.setAttribute('aria-hidden', 'true');
			infoRow.insertBefore(clone, infoOriginals[0]);
		});

		// Init position at originals block
		requestAnimationFrame(() => {
			currentX = getBlockWidth();
			applyTranslate();
		});

		// ─── Loop teleport ───
		function checkLoop() {
			const blockWidth = getBlockWidth();
			if (blockWidth === 0) return;
			if (currentX >= blockWidth * 2) {
				currentX -= blockWidth;
				applyTranslate();
			} else if (currentX < blockWidth) {
				currentX += blockWidth;
				applyTranslate();
			}
		}

		// ─── Active dot ───
		let activeDot = 0;

		function updateDots() {
			const blockWidth = getBlockWidth();
			if (blockWidth === 0) return;
			const allSlots = Array.from(track!.querySelectorAll<HTMLElement>('.project-image-slot'));
			let closest = 0;
			let minDist = Infinity;
			for (let i = n; i < 2 * n; i++) {
				const pos = allSlots[i].offsetLeft - allSlots[0].offsetLeft;
				const dist = Math.abs(currentX - pos);
				if (dist < minDist) {
					minDist = dist;
					closest = i - n;
				}
			}
			if (closest !== activeDot) {
				dots[activeDot]?.classList.remove('is-active');
				dots[closest]?.classList.add('is-active');
				activeDot = closest;
			}
		}

		// ─── Snap animation ───
		function animateSnap() {
			const diff = targetSnapX - currentX;
			if (Math.abs(diff) < 0.5) {
				currentX = targetSnapX;
				isSnapping = false;
				snapRaf = null;
				applyTranslate();
				checkLoop();
				updateDots();
				return;
			}
			currentX += diff * 0.12;
			applyTranslate();
			updateDots();
			snapRaf = requestAnimationFrame(animateSnap);
		}

		function snapTo(target: number) {
			targetSnapX = target;
			isSnapping = true;
			if (!snapRaf) snapRaf = requestAnimationFrame(animateSnap);
		}

		// ─── Dot click → snap to project ───
		dots.forEach((dot, i) => {
			dot.addEventListener('click', () => {
				const allSlots = Array.from(track!.querySelectorAll<HTMLElement>('.project-image-slot'));
				// Target is the i-th original slot (originals start at index n)
				const targetSlot = allSlots[n + i];
				if (!targetSlot) return;
				const pos = targetSlot.offsetLeft - allSlots[0].offsetLeft;
				snapTo(pos);
			});
		});

		// ─── Snap helper ───
		function getSnapTarget(direction: number): number {
			const positions = getSlotPositions();
			if (!positions.length) return currentX;

			const raw = positions.findIndex((pos, i) => {
				const next = positions[i + 1] ?? Infinity;
				return currentX >= pos - 2 && currentX < next - 2;
			});
			const currentIdx = raw === -1 ? positions.length - 1 : raw;

			const targetIdx = direction > 0
				? Math.min(currentIdx + 1, positions.length - 1)
				: direction < 0
					? Math.max(currentIdx - 1, 0)
					: currentIdx;

			return positions[targetIdx];
		}

		// ─── Custom cursor with lerp ───
		let cursorX = 0;
		let cursorY = 0;
		let targetCursorX = 0;
		let targetCursorY = 0;
		let rafCursor: number | null = null;

		function tickCursor() {
			cursorX += (targetCursorX - cursorX) * 0.14;
			cursorY += (targetCursorY - cursorY) * 0.14;
			cursor!.style.left = `${cursorX}px`;
			cursor!.style.top = `${cursorY}px`;

			if (Math.abs(cursorX - targetCursorX) > 0.3 || Math.abs(cursorY - targetCursorY) > 0.3) {
				rafCursor = requestAnimationFrame(tickCursor);
			} else {
				rafCursor = null;
			}
		}

		wrapper.addEventListener('mousemove', (e) => {
			const rect = wrapper.getBoundingClientRect();
			targetCursorX = e.clientX - rect.left;
			targetCursorY = e.clientY - rect.top;
			if (!rafCursor) rafCursor = requestAnimationFrame(tickCursor);
		});

		// ─── Drag (mouse) ───
		let isDragging = false;
		let startX = 0;
		let startPos = 0;
		let lastX = 0;
		let lastDx = 0;

		wrapper.addEventListener('mousedown', (e) => {
			if (isSnapping && snapRaf) { cancelAnimationFrame(snapRaf); snapRaf = null; isSnapping = false; }
			isDragging = true;
			startX = e.clientX;
			startPos = currentX;
			lastX = e.clientX;
			lastDx = 0;
		});

		window.addEventListener('mousemove', (e) => {
			if (!isDragging) return;
			lastDx = e.clientX - lastX;
			lastX = e.clientX;
			currentX = startPos - (e.clientX - startX);
			checkLoop();
			applyTranslate();
			updateDots();
		});

		window.addEventListener('mouseup', () => {
			if (!isDragging) return;
			isDragging = false;
			const dir = lastDx > 2 ? -1 : lastDx < -2 ? 1 : 0;
			snapTo(getSnapTarget(dir));
		});

		// ─── Drag (touch) ───
		let touchStartX = 0;
		let touchStartPos = 0;
		let touchLastX = 0;
		let touchLastDx = 0;
		const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
		let hideCursorTimeout: ReturnType<typeof setTimeout> | null = null;

		function showCursorAt(x: number, y: number) {
			const rect = wrapper!.getBoundingClientRect();
			cursor!.style.left = `${x - rect.left}px`;
			cursor!.style.top = `${y - rect.top}px`;
			cursor!.style.opacity = '1';
			cursor!.style.transform = 'translate(-50%, -50%) scale(1)';
		}

		function hideCursor() {
			cursor!.style.opacity = '0';
			cursor!.style.transform = 'translate(-50%, -50%) scale(0.6)';
		}

		wrapper.addEventListener('touchstart', (e) => {
			if (isSnapping && snapRaf) { cancelAnimationFrame(snapRaf); snapRaf = null; isSnapping = false; }
			const touch = e.touches[0];
			touchStartX = touch.clientX;
			touchStartPos = currentX;
			touchLastX = touch.clientX;
			touchLastDx = 0;
			if (isMobile()) {
				if (hideCursorTimeout) clearTimeout(hideCursorTimeout);
				showCursorAt(touch.clientX, touch.clientY);
			}
		}, { passive: true });

		wrapper.addEventListener('touchmove', (e) => {
			const touch = e.touches[0];
			touchLastDx = touch.clientX - touchLastX;
			touchLastX = touch.clientX;
			currentX = touchStartPos - (touch.clientX - touchStartX);
			checkLoop();
			applyTranslate();
			updateDots();
			if (isMobile()) showCursorAt(touch.clientX, touch.clientY);
		}, { passive: true });

		wrapper.addEventListener('touchend', () => {
			const dir = touchLastDx > 2 ? -1 : touchLastDx < -2 ? 1 : 0;
			snapTo(getSnapTarget(dir));
			if (isMobile()) hideCursorTimeout = setTimeout(hideCursor, 400);
		}, { passive: true });
	}
</script>
