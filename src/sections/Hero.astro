---
import { Image } from 'astro:assets';
import profileLight from '../assets/profile-image.png';
import profileDark from '../assets/profile-image-dark.png';
import AboutCard from '../components/AboutCard.astro';
---

<section id="hero" class="relative min-h-screen">

	<video
		id="hero-video"
		class="absolute inset-0 h-full w-full object-cover blur-[1px]"
		src="/assets/bg-background-loop-optimized.mp4"
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		poster="/assets/bg-background-loop-poster.webp"
	></video>

	<div class="absolute inset-0 bg-[#bdbdbd]/30 dark:bg-black/60"></div>

	<div class="relative flex min-h-screen items-center py-16">
		<div class="container mx-auto px-6">
			<div class="grid items-center gap-4 md:grid-cols-2">
				<div class="aspect-square overflow-hidden max-h-[500px] mx-auto animate-slide-in-top animate-duration-1000 border-2 border-light-secondary/30 dark:border-dark-primary">
					<Image src={profileLight} alt="Marc Gallego" widths={[400, 500]} sizes="(max-width: 768px) 400px, 500px" format="webp" quality={80} class="card-content h-full w-full object-cover dark:hidden" />
					<Image src={profileDark} alt="Marc Gallego" widths={[400, 500]} sizes="(max-width: 768px) 400px, 500px" format="webp" quality={80} class="card-content hidden h-full w-full object-cover dark:block" />
				</div>
				<AboutCard />
			</div>
		</div>
	</div>
</section>
