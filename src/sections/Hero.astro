---
import { getLang, useTranslations } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" aria-label={t.hero.sectionAriaLabel}>

	<!-- Gradient Unicorn -->
	<div id="hero-gradient" aria-hidden="true"></div>

	<!-- Banda nombre -->
	<div class="name-band">

		<!-- Banda superior: rol repetido -->
		<div class="name-bar"></div>
		<div class="info-band info-band--role text-mono-label" data-role-band>Full Stack Software Engineer</div>

		<!-- Nombre -->
		<div class="name-bar"></div>
		<div class="name-content">
			<h1 class="font-nord font-black text-secondary hero-name" data-typewriter>
				<div class="name-clip"><span class="name-word">Marc</span></div>
				<div class="name-clip"><span class="name-word">Gallego</span></div>
			</h1>
		</div>

		<!-- Banda inferior: stats -->
		<div class="name-bar"></div>
		<div class="info-band info-band--stats text-mono-label" data-stats-band>
			<span class="stat-item">{lang === 'en' ? '+5 years exp.' : '+5 años exp.'}</span>
			<span class="sep" data-sep></span>
			<span class="stat-item">{lang === 'en' ? '+60 projects' : '+60 proyectos'}</span>
			<span class="sep" data-sep></span>
			<span class="stat-item hidden md:inline">{lang === 'en' ? 'since 2018' : 'desde 2018'}</span>
			<span class="sep hidden md:inline" data-sep></span>
			<span class="stat-item">Barcelona</span>
		</div>
		<div class="name-bar"></div>

	</div>

</section>

<script>
	import { mountUnicornScene } from '../scripts/unicorn-scene';

	mountUnicornScene('hero-gradient');

	const CHAR_MS        = 75;
	const WORD_GAP       = 220;
	const CURSOR_LINGER  = 900;

	function startTypewriter() {
		const hero = document.querySelector<HTMLElement>('[data-typewriter]');
		if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const words = hero.querySelectorAll<HTMLElement>('.name-word');
		words.forEach(w => w.style.visibility = 'visible');
		let offset = 0;

		words.forEach((word, wi) => {
			const text = word.textContent ?? '';
			word.textContent = '';
			if (wi > 0) offset += WORD_GAP;

			[...text].forEach((ch) => {
				const span = document.createElement('span');
				span.className = 'char';
				span.style.setProperty('--d', `${offset}ms`);
				span.textContent = ch;
				word.appendChild(span);
				offset += CHAR_MS;
			});
		});

		const lastWord = words[words.length - 1];
		const cursor = document.createElement('span');
		cursor.className = 'cursor';
		lastWord?.appendChild(cursor);
		setTimeout(() => cursor.classList.add('is-done'), offset + CURSOR_LINGER);
	}

	window.addEventListener('splash:done', startTypewriter, { once: true });

	// ─── Helpers ───
	function measureText(parent: HTMLElement, text: string): number {
		const probe = document.createElement('span');
		probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;font-size:inherit;font-family:inherit;font-weight:inherit;';
		probe.textContent = text;
		parent.appendChild(probe);
		const w = probe.getBoundingClientRect().width;
		parent.removeChild(probe);
		return w;
	}

	// ─── Role band ───
	function fillRoleBand() {
		const band = document.querySelector<HTMLElement>('[data-role-band]');
		if (!band) return;

		if (!band.dataset.role) band.dataset.role = band.textContent?.trim() ?? '';
		const roleText = band.dataset.role;
		if (!roleText) return;

		const textW = measureText(band, roleText);
		const charW = measureText(band, '/');
		if (textW <= 0 || charW <= 0) return;

		const cs = getComputedStyle(band);
		const bandW = band.getBoundingClientRect().width
			- parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);

		let count = Math.min(4, Math.max(1, Math.floor(bandW / textW)));

		function build(n: number) {
			band!.innerHTML = '';
			for (let i = 0; i < n; i++) {
				const item = document.createElement('span');
				item.className = 'role-item';
				item.textContent = roleText!;
				band!.appendChild(item);
				if (i < n - 1) {
					const sep = document.createElement('span');
					sep.className = 'role-sep';
					band!.appendChild(sep);
				}
			}
		}

		build(count);

		const seps = [...band.querySelectorAll<HTMLElement>('.role-sep')];
		if (count > 1 && seps.some(s => s.getBoundingClientRect().width < charW)) {
			count--;
			build(count);
		}

		band.querySelectorAll<HTMLElement>('.role-sep').forEach(sep => {
			const w = sep.getBoundingClientRect().width;
			sep.textContent = '/'.repeat(Math.max(1, Math.floor(w / charW)));
		});
	}

	// ─── Stats band ───
	function fillStatSeps() {
		const band = document.querySelector<HTMLElement>('[data-stats-band]');
		if (!band) return;
		const seps = [...band.querySelectorAll<HTMLElement>('[data-sep]')];
		if (!seps.length) return;

		const charW = measureText(band, '/');
		if (charW <= 0) return;

		seps.forEach(sep => {
			const w = sep.getBoundingClientRect().width;
			sep.textContent = '/'.repeat(Math.max(1, Math.floor(w / charW)));
		});
	}

	requestAnimationFrame(() => {
		fillRoleBand();
		const roleBand = document.querySelector('[data-role-band]');
		if (roleBand) new ResizeObserver(fillRoleBand).observe(roleBand);

		fillStatSeps();
		const statBand = document.querySelector('[data-stats-band]');
		if (statBand) new ResizeObserver(fillStatSeps).observe(statBand);
	});

	// ─── Binary glitch animation on separators ───
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		function getAllSepChars(): { el: HTMLElement; index: number }[] {
			const result: { el: HTMLElement; index: number }[] = [];
			const allSeps = [
				...document.querySelectorAll<HTMLElement>('.role-sep'),
				...document.querySelectorAll<HTMLElement>('[data-sep]'),
			];
			allSeps.forEach(sep => {
				const len = sep.textContent?.length ?? 0;
				for (let i = 0; i < len; i++) result.push({ el: sep, index: i });
			});
			return result;
		}

		function setChar(el: HTMLElement, index: number, char: string) {
			const chars = (el.textContent ?? '').split('');
			chars[index] = char;
			el.textContent = chars.join('');
		}

		function shuffle<T>(arr: T[]): T[] {
			for (let i = arr.length - 1; i > 0; i--) {
				const j = Math.floor(Math.random() * (i + 1));
				[arr[i], arr[j]] = [arr[j], arr[i]];
			}
			return arr;
		}

		// El bucle se pausa con el Hero fuera de pantalla o la pestaña en segundo plano
		let heroInView = true;
		let resume: (() => void) | null = null;
		const canRun = () => heroInView && !document.hidden;
		const wakeUp = () => { if (canRun()) resume?.(); };

		const heroEl = document.getElementById('hero');
		if (heroEl) {
			new IntersectionObserver(([entry]) => {
				heroInView = entry.isIntersecting;
				wakeUp();
			}).observe(heroEl);
		}
		document.addEventListener('visibilitychange', wakeUp);

		function whenVisible(): Promise<void> {
			if (canRun()) return Promise.resolve();
			return new Promise((r) => { resume = () => { resume = null; r(); }; });
		}

		async function runGlitch() {
			const CHAR_DELAY = 30;   // ms entre cada carácter
			const HOLD       = 1200; // ms que se mantiene en binario

			while (true) {
				await whenVisible();
				// Fase 1: / → binario
				const chars = shuffle(getAllSepChars());
				for (const { el, index } of chars) {
					setChar(el, index, Math.random() < 0.5 ? '0' : '1');
					await new Promise(r => setTimeout(r, CHAR_DELAY));
				}

				await new Promise(r => setTimeout(r, HOLD));
				await whenVisible();

				// Fase 2: binario → /
				const chars2 = shuffle(getAllSepChars());
				for (const { el, index } of chars2) {
					setChar(el, index, '/');
					await new Promise(r => setTimeout(r, CHAR_DELAY));
				}
			}
		}

		window.addEventListener('splash:done', () => runGlitch(), { once: true });
	}
</script>

<style lang="scss">
	#hero {
		display: flex;
		flex-direction: column;
		height: 100vh;
		height: 100svh; // sin quedar bajo la barra del navegador en móvil
		overflow: hidden;
	}

	#hero-gradient {
		flex: 1;
		width: 100%;
		min-height: 0;
	}

	// ─── Banda nombre ───
	.name-band {
		background-color: var(--primary);
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
	}

	.name-bar {
		height: 1px;
		background-color: var(--secondary);
		flex-shrink: 0;
	}

	.name-content {
		padding: 1rem;
		@media (min-width: 768px) { padding: 0.5rem 2.5rem; }
	}

	// ─── Info bands ───
	.info-band {
		overflow: hidden;
		white-space: nowrap;
		padding: 0.5rem 1rem;
		@media (min-width: 768px) { padding: 0.4rem 2.5rem; }
	}

	.info-band--role {
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	:global(.role-item) {
		flex-shrink: 0;
		padding: 0 0.9em;
		&:first-child { padding-left: 0; }
		&:last-child  { padding-right: 0; }
	}

	:global(.role-sep) {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		opacity: 0.6;
	}

	.info-band--stats {
		display: flex;
		align-items: center;
		@media (min-width: 768px) { padding: 0.4rem 2.5rem; }

		.stat-item {
			flex-shrink: 0;
			padding: 0 0.9em;
			&:first-child { padding-left: 0; }
			&:last-child  { padding-right: 0; }
		}

		.sep {
			flex: 1;
			min-width: 0;
			overflow: hidden;
			white-space: nowrap;
			opacity: 0.6;
		}
	}

	.hero-name {
		font-size: 17vw;
		@media (min-width: 768px) { font-size: 11vw; }
		line-height: 0.8;
		letter-spacing: -0.05em;
		width: 100%;
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.22em;
	}

	.name-clip { overflow: hidden; }
	.name-word { display: block; }
	// Oculto solo si el typewriter va a correr (JS activo y sin reduced motion);
	// en cualquier otro caso el nombre se ve directamente.
	@media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
		.name-word { visibility: hidden; }
	}

	// ─── Typewriter ───
	:global(.char) {
		display: inline-block;
		opacity: 0;
		animation: char-in 1ms step-end forwards;
		animation-delay: var(--d, 0ms);
	}

	@keyframes char-in { to { opacity: 1; } }

	:global(.cursor) {
		display: inline-block;
		width: 0.08em;
		height: 0.82em;
		background: currentColor;
		vertical-align: middle;
		margin-left: 0.05em;
		animation: cursor-blink 500ms step-end infinite;

		&.is-done {
			animation: cursor-fade 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
		}
	}

	@keyframes cursor-blink { 50% { opacity: 0; } }
	@keyframes cursor-fade  { to  { opacity: 0; } }
</style>
