<style>
	.card-glass {
		--about-card-bg: color-mix(in srgb, var(--color-light-secondary) 30%, transparent);
		background-color: var(--about-card-bg);
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		transition: background-color 320ms ease;
	}

	:global(html.dark) .card-glass {
		--about-card-bg: color-mix(in srgb, var(--color-dark-primary) 30%, transparent);
	}

	.about-card {
		position: relative;
		will-change: transform;
	}

	.about-card.is-expanded {
		position: fixed;
		inset: var(--about-gap, 24px);
		margin: 0;
		z-index: 70;
		overflow: auto;
		border-radius: 1rem;
		--about-card-bg: var(--color-light-secondary);
	}

	:global(html.dark) .about-card.is-expanded {
		--about-card-bg: var(--color-dark-primary);
	}

	.about-backdrop {
		position: fixed;
		inset: 0;
		z-index: 60;
		background: rgba(0, 0, 0, 0.35);
		opacity: 0;
		pointer-events: none;
		transition: opacity 180ms ease;
	}

	.about-backdrop.is-visible {
		opacity: 1;
		pointer-events: auto;
	}

	.about-close {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		width: 2em;
		height: 2em;
		border: none;
		border-radius: 0.5rem;
		cursor: pointer;
		background-color: color-mix(in srgb, var(--color-light-primary) 12%, transparent);
		opacity: 0;
		pointer-events: none;
		transition: opacity 180ms ease, background-color 220ms ease;
	}

	.about-card.is-expanded .about-close {
		opacity: 1;
		pointer-events: auto;
	}

	:global(html.dark) .about-close {
		background-color: color-mix(in srgb, var(--color-dark-secondary) 12%, transparent);
	}

	.about-close:hover {
		background-color: #d31515;
	}

	.about-close:active {
		background-color: #820000;
	}

	:global(html.dark) .about-close:hover {
		background-color: #d31515;
	}

	:global(html.dark) .about-close:active {
		background-color: #820000;
	}

	.about-close-x,
	.about-close-y {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 1em;
		height: 1.5px;
		background-color: currentColor;
		transform-origin: center;
	}

	.about-close-x {
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.about-close-y {
		transform: translate(-50%, -50%) rotate(-45deg);
	}

	.about-compact {
		transition: opacity 120ms ease-out, transform 120ms ease-out, visibility 120ms ease-out;
	}

	.about-card.is-compact-hidden .about-compact {
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
		visibility: hidden;
	}
</style>

