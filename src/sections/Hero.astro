---
import AboutCard from '../components/AboutCard.astro';
import { MousePointerClick } from 'lucide-astro';
---

<section id="hero" class="relative min-h-screen">

	<video
		id="hero-video"
		class="absolute inset-0 h-full w-full object-cover blur-[1px]"
		src="/assets/bg-background-loop-optimized.mp4"
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		poster="/assets/bg-background-loop-poster.webp"
	></video>

	<div class="absolute inset-0 bg-primary/5 dark:bg-primary/70"></div>
	<div class="relative flex min-h-screen flex-col py-16">
		<!-- Centro: AboutCard + feature cards -->
		<div class="flex-1 flex flex-col justify-center container mx-auto px-10">
			<AboutCard />

			<!-- 4 feature cards -->
			<div class="hero-collapsible grid grid-cols-4 gap-6 mt-6" data-hero-collapsible>
				<div class="card-glass flex flex-col justify-center items-center py-10 px-4">
					<span class="font-nord font-black text-white text-3xl uppercase">+5</span>
					<span class="font-nord font-normal text-white/80 text-[10px] uppercase tracking-widest mt-1">años exp.</span>
				</div>
				<div class="card-glass flex flex-col justify-center items-center py-10 px-4">
					<span class="font-nord font-black text-white text-3xl uppercase">+100</span>
					<span class="font-nord font-normal text-white/80 text-[10px] uppercase tracking-widest mt-1">proyectos</span>
				</div>
				<div class="card-glass flex flex-col justify-center items-center py-10 px-4">
					<span class="font-nord font-black text-white text-3xl uppercase">+20</span>
					<span class="font-nord font-normal text-white/80 text-[10px] uppercase tracking-widest mt-1">clientes satisfechos</span>
				</div>
				<div class="card-glass hero-cta flex justify-center items-center gap-3 py-10 px-4 cursor-pointer" data-about-trigger>
					<span class="hero-cta__text font-nord font-black text-white text-xl uppercase">Conóceme</span>
					<MousePointerClick size={32} stroke-width={2.5} class="text-white pb-1" />
				</div>
			</div>
		</div>

		<!-- Bottom elements: pegados abajo -->
		<div class="hero-collapsible container mx-auto px-10 flex justify-between" data-hero-collapsible>
			<div class="card-glass px-6 py-3 flex items-center gap-3">
				<span class="status-dot relative flex h-2.5 w-2.5">
					<span class="absolute inline-flex h-full w-full animate-ping animate-duration-[2s] rounded-full bg-green-500 opacity-75"></span>
					<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-500"></span>
				</span>
				<span class="font-nord font-medium text-white text-sm uppercase tracking-widest">Disponible para proyectos</span>
			</div>
			<div class="card-glass px-6 py-3">
				<span class="font-nord font-medium text-white text-sm uppercase tracking-widest">Ingeniero del software</span>
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	.hero-cta__text {
		position: relative;
		padding-bottom: 0.25rem;

		&::after {
			content: '';
			position: absolute;
			inset-inline: 0;
			bottom: -0.25rem;
			height: 2px;
			background: white;
			transform: scaleX(0);
			transform-origin: left;
			transition: transform 300ms;
		}
	}

	.hero-cta:hover .hero-cta__text::after {
		transform: scaleX(1);
	}

	.hero-collapsible {
		transition: opacity 150ms ease, visibility 150ms ease;

		&.is-hidden {
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
		}
	}
</style>
