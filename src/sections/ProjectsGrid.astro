---
import { Image } from 'astro:assets';
import { getLang, useTranslations, getLocalePath } from '../i18n/index';
import ProjectLink from '../components/ProjectLink.astro';
import ProjectVideo from '../components/ProjectVideo.astro';
import { projectImages, projectUrls, projectVideos } from '../data/projects';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": t.breadcrumbs.home, "item": new URL(getLocalePath(lang, '/'), Astro.site).href },
		{ "@type": "ListItem", "position": 2, "name": t.breadcrumbs.projects, "item": new URL(getLocalePath(lang, '/projects'), Astro.site).href }
	]
};

// Los proyectos como datos estructurados: una lista de CreativeWork de Marc
// (mismo @id de Person que el Layout), con su web real si sigue online.
const projectList = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"name": t.projects.title,
	"itemListElement": t.projects.items.map((item, i) => ({
		"@type": "ListItem",
		"position": i + 1,
		"item": {
			"@type": "CreativeWork",
			"name": item.title,
			"description": item.description,
			"genre": item.type,
			"image": new URL(projectImages[i].src, Astro.site).href,
			...(projectUrls[i] ? { "url": projectUrls[i] } : {}),
			"creator": { "@id": new URL('/#person', Astro.site).href },
		},
	})),
};

const projects = t.projects.items.map((item, i) => ({
	...item,
	image: projectImages[i],
	video: projectVideos[i],
	url: projectUrls[i],
}));

// Catálogo 3×3: 9 celdas. Tras los proyectos, las celdas sobrantes muestran
// placeholders decorativos (work in progress / próximamente).
// Numeración secuencial desde 31 (número de la suerte de Marc).
const CELL_COUNT = 9;
const START_NO = 31;
const placeholders = t.projects.grid.placeholders;
const cells = Array.from({ length: CELL_COUNT }, (_, i) => {
	const project = projects[i] ?? null;
	const phIndex = i - projects.length;
	return {
		no: String(START_NO + i).padStart(3, '0'),
		project,
		placeholder: project ? null : (placeholders[phIndex] ?? null),
		// 1er placeholder (work in progress) → marco vacío; resto → cruz
		phKind: phIndex === 0 ? 'frame' : 'cross',
	};
});

// Pie del catálogo (estética editorial). Rango derivado de la numeración real.
const catalogRange = `${String(START_NO).padStart(3, '0')}–${String(START_NO + CELL_COUNT - 1).padStart(3, '0')}`;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(projectList)} />

<main class="min-h-screen bg-primary pt-18">
<section class="projects-grid-section pt-16" id="proyectos">
	<!-- Header -->
	<div class="projects-grid-header px-4 md:px-10">
		<h1 class="font-nord font-normal text-secondary projects-grid-title">
			{t.projects.title}
		</h1>
	</div>

	<!-- Catálogo (rejilla 3×3, bordes 1px, full-bleed) -->
	<div class="catalog">
		<div class="catalog-grid">
			{cells.map((cell) => (
				<article class="catalog-cell">
					<!-- Número de catálogo -->
					<div class="catalog-cell__no text-mono-label-soft">No.{cell.no}</div>

					{cell.project ? (
						<>
							<!-- Imagen del proyecto -->
							<div class="catalog-cell__media">
								<!-- Marco 4:3 = la imagen; el vídeo animado va encima, del mismo tamaño -->
								<div class="catalog-cell__frame">
								<Image
									src={cell.project.image}
									alt={`${cell.project.title} — ${cell.project.description}`}
									widths={[400, 600, 900]}
									sizes="(max-width: 768px) 50vw, 30vw"
									format="webp"
									quality={90}
									loading="lazy"
									draggable={false}
									class="catalog-cell__img"
								/>
								<ProjectVideo video={cell.project.video} />
								</div>
							</div>
							<!-- Ficha técnica (estética catálogo) -->
							<div class="catalog-cell__info">
								<h2 class="catalog-cell__name font-monoblock font-medium text-secondary">{cell.project.title}</h2>
								<div class="catalog-cell__data font-monoblock">
									<span class="catalog-cell__type">{cell.project.type}</span>
									<span class="catalog-cell__tagline">{cell.project.description}</span>
								</div>
								<!-- Estado: con web, enlace "Ver web ↗"; sin web, archivado -->
								{cell.project.url ? (
									<span class="catalog-cell__status font-monoblock">
										<ProjectLink
											href={cell.project.url}
											text={t.projects.grid.visit}
											label={t.projects.grid.visitLabel.replace('{title}', cell.project.title)}
										/>
									</span>
								) : (
									<span class="catalog-cell__status catalog-cell__status--off font-monoblock">{t.projects.grid.archived}</span>
								)}
							</div>
						</>
					) : (
						<>
							<!-- Placeholder decorativo: el primero (work in progress) = marco vacío; el segundo (próximamente) = cruz -->
							<div class="catalog-cell__media catalog-cell__media--ph" aria-hidden="true">
								{cell.phKind === 'frame'
									? <span class="catalog-cell__ph-frame"></span>
									: <span class="catalog-cell__ph-cross"></span>}
							</div>
							<div class="catalog-cell__info catalog-cell__info--ph">
								<p class="catalog-cell__name font-monoblock font-medium text-secondary">{cell.placeholder?.type}</p>
								<div class="catalog-cell__data font-monoblock">
									<span class="catalog-cell__tagline">{cell.placeholder?.tagline}</span>
								</div>
							</div>
						</>
					)}
				</article>
			))}
		</div>

		<!-- Pie del catálogo (decorativo, ocupa el espacio inferior de la sección) -->
		<div class="catalog-foot px-4 md:px-10">
			<span class="text-mono-label-soft">{t.projects.grid.foot.replace('{range}', catalogRange)}</span>
		</div>
	</div>
</section>
</main>

<style lang="scss">
.projects-grid-section {
	overflow: hidden;
	position: relative;
	display: flex;
	flex-direction: column;
}

.projects-grid-header {
	margin-bottom: 2rem;
}

// ─── Pie del catálogo (rellena el espacio inferior de la sección) ───
.catalog-foot {
	display: flex;
	justify-content: center;
	align-items: center;
	padding-top: 2rem;
	padding-bottom: 2rem;
}

.projects-grid-title {
	font-size: clamp(35px, 8vw, 80px);
	line-height: 1;
}

// ─── Catálogo: rejilla con bordes 1px, full-bleed ───
// Responsive: mobile 1 col · tablet (md) 2 cols · desktop (lg) 3 cols.
// Laterales a sangre; arriba y abajo cerrados.
// El grid aporta el borde superior; las celdas aportan right+bottom.
.catalog-grid {
	display: grid;
	grid-template-columns: 1fr;
	border-top: 1px solid var(--secondary);

	@media (min-width: 768px) {
		grid-template-columns: repeat(2, 1fr);
	}

	@media (min-width: 1024px) {
		grid-template-columns: repeat(3, 1fr);
	}
}

.catalog-cell {
	display: flex;
	flex-direction: column;
	border-bottom: 1px solid var(--secondary);
	// Padding lateral igual al header (px-4 / md:px-10) para alinear
	// la numeración y los datos con el título de la sección.
	padding: 1rem;

	@media (min-width: 768px) {
		padding: 1.5rem 2.5rem;
	}
}

// ─── Bordes verticales internos (laterales a sangre) ───
// Mobile (1 col): sin bordes verticales.
// Tablet (2 cols): border-right salvo última columna (celdas pares).
@media (min-width: 768px) {
	.catalog-cell { border-right: 1px solid var(--secondary); }
	.catalog-cell:nth-child(2n) { border-right: none; }
}

// Desktop (3 cols): última columna = múltiplos de 3.
@media (min-width: 1024px) {
	.catalog-cell:nth-child(2n) { border-right: 1px solid var(--secondary); }  // reset regla de 2 cols
	.catalog-cell:nth-child(3n) { border-right: none; }
}

// ─── Número de catálogo (protagonista) ───
.catalog-cell__no {
	font-family: var(--font-monoblock);
	font-size: clamp(1.1rem, 2.4vw, 1.75rem);
	font-weight: 500;
	letter-spacing: 0.02em;
	color: var(--secondary);
	line-height: 1;
	margin-bottom: 1rem;
}

// ─── Media (imagen centrada con aire) ───
// aspect-ratio fijo → el área de imagen es idéntica en todas las celdas
// (sin flex:1, así no se estira según la altura del info de cada celda).
.catalog-cell__media {
	display: flex;
	align-items: center;
	justify-content: center;
	aspect-ratio: 4 / 3;
	padding: 1rem 0.5rem;
	overflow: hidden;   // recorta la imagen cover en móvil

	@media (min-width: 768px) {
		padding: 1.5rem 1rem;
	}

	// Móvil: sin padding → la imagen (cover) llena toda la celda.
	@media (max-width: 767px) {
		padding: 0;
	}
}

// ─── Placeholder decorativo ───
// El texto va a color sólido (sin atenuar)
.catalog-cell__info--ph .catalog-cell__tagline {
	opacity: 1;
}

// Marco vacío (work in progress) — mismo encuadre 4:3 que las imágenes
.catalog-cell__ph-frame {
	width: 100%;
	aspect-ratio: 4 / 3;
	max-height: 100%;
	border: 1px solid var(--secondary);
	border-radius: 2px;
}

// Cruz '+' (próximamente) — ocupa el mismo box 4:3 que imágenes y marco,
// pero el '+' se dibuja centrado y simétrico (líneas de longitud fija),
// así NO se deforma y el title arranca a la misma altura en todas las celdas.
.catalog-cell__ph-cross {
	position: relative;
	width: 100%;
	aspect-ratio: 4 / 3;
	max-height: 100%;

	$arm: clamp(48px, 7vw, 72px); // longitud de cada brazo del '+'

	&::before,
	&::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		background-color: var(--secondary);
	}
	// brazo horizontal
	&::before {
		width: $arm;
		height: 1px;
		transform: translate(-50%, -50%);
	}
	// brazo vertical
	&::after {
		width: 1px;
		height: $arm;
		transform: translate(-50%, -50%);
	}
}


// Marco de la imagen (4:3, como las imágenes y los vídeos): lo que crece al
// pasar el ratón, con el vídeo dentro.
.catalog-cell__frame {
	position: relative;
	height: 100%;
	max-width: 100%;
	aspect-ratio: 4 / 3;
	overflow: hidden;
	transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);

	.catalog-cell:hover & {
		transform: scale(1.04);
	}

	// Móvil: llena la celda. Sin hover/scale (en táctil se queda "pegado" tras el tap).
	@media (max-width: 767px) {
		width: 100%;
		transition: none;
		.catalog-cell:hover & { transform: none; }
	}

	@media (prefers-reduced-motion: reduce) { transition: none; }
}

.catalog-cell__img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
	-webkit-user-drag: none;
}

// ─── Ficha: Título + bloque de Datos ───
.catalog-cell__info {
	flex: 1;   // llena la casilla: el estado se pega abajo
	display: flex;
	flex-direction: column;
	gap: 0.6rem;
}

.catalog-cell__name {
	font-size: clamp(0.95rem, 1.5vw, 1.15rem);
}

// Bloque de datos: misma fuente (Monoblock), compacto
.catalog-cell__data {
	display: flex;
	flex-direction: column;
	font-size: clamp(11px, 1vw, 13px);
	line-height: 1.35;
	// Alto reservado: tipo + aire + las líneas que ocupa el texto más largo en
	// cada ancho (--desc-lines), así el estado cae a la misma altura en todas
	// las casillas sin dejar hueco de más. En móvil (una columna) no hace falta.
	--desc-lines: 4;
	min-height: calc((var(--desc-lines) + 1) * 1.35em + 0.5em);

	@media (max-width: 767px) { min-height: 0; }
	@media (min-width: 1024px) and (max-width: 1199px) { --desc-lines: 5; }
	@media (min-width: 1600px) { --desc-lines: 3; }
	color: var(--secondary);
}

.catalog-cell__type + .catalog-cell__tagline {
	margin-top: 0.5em;   // aire entre el tipo y el texto
}

.catalog-cell__tagline {
	opacity: 0.7; // ≥ 4.5:1 de contraste en texto pequeño
}

// ─── Estado del proyecto (última línea de la ficha) ───
.catalog-cell__status {
	align-self: flex-start;
	margin-top: auto;   // abajo del todo: "Ver web" y "Archivado" en la misma línea por fila
	font-size: clamp(11px, 1vw, 13px);
	line-height: 1.35;
	text-transform: uppercase;
	letter-spacing: 0.05em;
	color: var(--secondary);
}

// Archivado: tachado, como un artículo retirado del catálogo (se distingue
// de la ficha de encima, que va en el mismo gris)
.catalog-cell__status--off {
	opacity: 0.7;
	text-decoration: line-through;
	text-decoration-thickness: 1px;
}

// ─── Móvil: textos algo mayores y más aire entre imagen y ficha ───
@media (max-width: 767px) {
	// Separación imagen → título.
	.catalog-cell__info { margin-top: 1.25rem; }
	.catalog-cell__name { font-size: 1.25rem; }
	.catalog-cell__data,
	.catalog-cell__status { font-size: 14px; }
}
</style>
