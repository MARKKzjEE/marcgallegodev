---
import { getLang, useTranslations } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const words = t.whatIDo.text.split(' ');
const paragraphsWithIndex = [words.map((word: string, i: number) => ({ word, index: i }))];
---

<section id="what-i-do" class="what-i-do py-16 md:py-30" aria-labelledby="what-i-do-heading">
	<div class="px-4 md:px-10">
		<div class="grid md:grid-cols-[320px_1fr] gap-8 md:gap-16 items-start">

			<!-- Label izquierda -->
			<h2 id="what-i-do-heading" class="what-i-do__label text-mono-label">{t.whatIDo.label}</h2>

			<!-- Texto con reveal por palabra -->
			<div class="what-i-do__content" data-scroll-reveal>
				{paragraphsWithIndex.map((words) => (
					<p class="what-i-do__text font-cottor font-light mb-8">
						{words.map(({ word, index }) => (
							<span class="reveal-word" style={`--word-index: ${index}`}>{word} </span>
						))}
					</p>
				))}
			</div>

		</div>
	</div>
</section>

<style lang="scss">
	.what-i-do__text {
		font-size: clamp(30px, 5vw, 60px);
		line-height: 1.4;
	}

	.what-i-do__label {
		padding-top: 0.6em;

		@media (min-width: 768px) {
			padding-top: 1.2em;
		}
	}

	.reveal-word {
		color: color-mix(in srgb, var(--secondary) 20%, transparent);
	}
</style>

<script>
	function initScrollReveal() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const container = document.querySelector<HTMLElement>('[data-scroll-reveal]');
		if (!container) return;

		const words = container.querySelectorAll<HTMLElement>('.reveal-word');

		const containerWidth = container.offsetWidth;

		function update() {
			const viewH = window.innerHeight;
			const center = viewH * 0.5;
			const lineOffset = 40;
			// Zona de transición: las palabras pasan de 20% a 100% opacidad en este rango de px
			const fadeRange = 120;

			words.forEach((word) => {
				const wordRect = word.getBoundingClientRect();
				const xRatio = wordRect.left / containerWidth;
				const threshold = center - (xRatio * lineOffset);
				const wordCenter = wordRect.top + wordRect.height / 2;
				const distance = threshold - wordCenter;
				// 0 = justo en threshold, 1 = completamente revelada
				const progress = Math.min(Math.max(distance / fadeRange, 0), 1);
				const opacity = 20 + progress * 80;
				word.style.color = `color-mix(in srgb, var(--secondary) ${Math.round(opacity)}%, transparent)`;
			});
		}

		let ticking = false;
		window.addEventListener('scroll', () => {
			if (!ticking) {
				requestAnimationFrame(() => {
					update();
					ticking = false;
				});
				ticking = true;
			}
		}, { passive: true });

		update();
	}

	initScrollReveal();
</script>
