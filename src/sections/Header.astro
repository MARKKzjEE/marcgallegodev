---
const navItems = [
	{ label: "Experiencia", href: "/experiencia" },
	{ label: "Proyectos", href: "/proyectos" },
	{ label: "Contacto", href: "/contacto" }
];

---

<header class="site-header fixed inset-x-0 top-0 z-40 mt-4" data-site-header>
	<div class="container mx-auto px-10" data-header-wrap>
	<div class="card-glass font-nord font-medium hidden md:flex items-center justify-end h-14 gap-6 px-8">
		<nav class="flex items-center gap-6 text-sm" aria-label="Navegación principal">
			{navItems.map((item) => (
				<a href={item.href} class="nav-link">
					{item.label}
				</a>
			))}
		</nav>
    <div class="header-divider h-[32px] w-[1px] bg-[var(--header-text)] transition-all duration-300"></div>
    <div class="flex items-center gap-1 text-sm" aria-label="Selector de idioma">
      <button type="button" class="lang-btn lang-active" data-lang="es" aria-pressed="true">ES</button>
      <span class="text-[var(--header-text)] opacity-75">/</span>
      <button type="button" class="lang-btn" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <div class="toggle-switch">
        <label class="switch-label" id="theme-toggle">
          <input type="checkbox" class="checkbox" aria-label="Cambiar entre modo claro y oscuro">
          <span class="slider"></span>
        </>
    </div>
	</div>
	</div>
</header>

<style lang="scss">
  .site-header {
    --header-text: #ffffff;
    --toggle-track: #ffffff;
    --toggle-thumb: #1D1D1F;

    [data-header-wrap] {
      transition: max-width 300ms ease, padding 300ms ease;
    }

    .card-glass {
      transition: background-color 300ms ease, backdrop-filter 300ms ease, border-color 300ms ease, border-radius 300ms ease, box-shadow 300ms ease;
    }
  }

  .nav-link {
    position: relative;
    padding-bottom: 0.25rem;
    color: var(--header-text);

    &::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      bottom: -0.25rem;
      height: 2px;
      background: var(--header-text);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 300ms;
    }

    &:hover::after {
      transform: scaleX(1);
    }
  }

  .lang-btn {
    color: var(--header-text);
    opacity: 0.75;
    transition: opacity 300ms;
    cursor: pointer;

    &:hover {
      opacity: 1;
    }

    &.lang-active {
      opacity: 1;

      &::before { content: '['; margin-right: 2px; }
      &::after { content: ']'; margin-left: 2px; }
    }
  }

  .site-header {
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease, padding 300ms ease, margin 300ms ease;
    &.is-past-hero {
      --header-text: var(--secondary);
      --toggle-track: var(--secondary);
      --toggle-thumb: var(--primary);
      margin-top: 0;

      [data-header-wrap] {
        max-width: 100%;
        padding-inline: 0;
      }

      .card-glass {
        background-color: var(--primary);
        border-color: transparent;
        border-bottom-color: var(--secondary);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        box-shadow: none;
        border-radius: 0;
      }

      .header-divider {
        height: 100%;
      }
    }
    &.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-8px);
    }
    .toggle-switch {
      position: relative;
      width: 50px;
      height: 28px;
    }
    .switch-label {
      position: absolute;
      width: 100%;
      height: 100%;
      background-color: var(--toggle-track);
      border: 2px solid var(--toggle-track);
      border-radius: 16px;
      cursor: pointer;
      .checkbox {
        position: absolute;
        display: none;
      }
      .slider {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 16px;
        transition: 0.3s;
        &::before {
          content: "";
          position: absolute;
          top: 4px;
          left: 4px;
          width: 16px;
          height: 16px;
          border-radius: 50%;
          box-shadow: inset 8px -4px 0px 0px var(--toggle-thumb);
          background-color: var(--toggle-track);
          transition: 0.3s;
        }
      }
      .checkbox:checked ~ .slider::before {
        transform: translateX(22px);
        box-shadow: none;
        background-color: var(--toggle-thumb);
      }
    }
  }
</style>

<script>
	import { initHeaderScroll } from "../scripts/header-scroll";
	initHeaderScroll();
</script>
