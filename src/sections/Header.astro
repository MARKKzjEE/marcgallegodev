---
const navItems = [
	{ label: "Experiencia", href: "/experiencia" },
	{ label: "Proyectos", href: "/proyectos" },
	{ label: "Contacto", href: "/contacto" }
];

---

<header class="site-header fixed inset-x-0 top-0 z-40" data-site-header>
	<div class="px-10 font-nord font-medium hidden md:flex items-center justify-end h-14 gap-6">
		<nav class="flex items-center gap-6 text-sm" aria-label="Navegación principal">
			{navItems.map((item) => (
				<a href={item.href} class="nav-link">
					{item.label}
				</a>
			))}
		</nav>
    <div class="header-divider h-[32px] w-[1px] transition-all duration-300"></div>
    <div class="flex items-center gap-1 text-sm" aria-label="Selector de idioma">
      <button type="button" class="lang-btn lang-active" data-lang="es" aria-pressed="true">ES</button>
      <span class="divider-slash opacity-75">/</span>
      <button type="button" class="lang-btn" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <div class="toggle-switch">
        <label class="switch-label" id="theme-toggle">
          <input type="checkbox" class="checkbox" aria-label="Cambiar entre modo claro y oscuro">
          <span class="slider"></span>
        </>
    </div>
	</div>
</header>

<style lang="scss">
  .site-header {
    transition: background-color 300ms ease, border-color 300ms ease;
    border-bottom: 1px solid transparent;

    // ─── Sobre el hero: transparente, texto blanco ───
    .nav-link { color: #fff; }
    .lang-btn { color: #fff; }
    .divider-slash { color: #fff; }
    .header-divider { background-color: #fff; }
    .switch-label {
      background-color: #fff;
      border-color: #fff;
      .slider::before {
        box-shadow: inset 8px -4px 0px 0px #1D1D1F;
        background-color: #fff;
      }
      .checkbox:checked ~ .slider::before {
        box-shadow: none;
        background-color: #1D1D1F;
      }
    }

    // ─── Pasado el hero: fondo sólido, tokens semánticos ───
    &.is-past-hero {
      background-color: var(--primary);
      border-bottom-color: var(--secondary);

      .nav-link { color: var(--secondary); }
      .lang-btn { color: var(--secondary); }
      .divider-slash { color: var(--secondary); }
      .header-divider { background-color: var(--secondary); height: 100%; }
      .switch-label {
        background-color: var(--secondary);
        border-color: var(--secondary);
        .slider::before {
          box-shadow: inset 8px -4px 0px 0px var(--primary);
          background-color: var(--secondary);
        }
        .checkbox:checked ~ .slider::before {
          box-shadow: none;
          background-color: var(--primary);
        }
      }
    }

    &.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    }
  }

  .nav-link {
    position: relative;
    padding-bottom: 0.25rem;
    transition: color 300ms ease;

    &::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      bottom: -0.25rem;
      height: 2px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 300ms;
    }

    &:hover::after { transform: scaleX(1); }
  }

  .lang-btn {
    opacity: 0.75;
    transition: opacity 300ms, color 300ms ease;
    cursor: pointer;

    &:hover { opacity: 1; }

    &.lang-active {
      opacity: 1;
      &::before { content: '['; margin-right: 2px; }
      &::after { content: ']'; margin-left: 2px; }
    }
  }

  .toggle-switch {
    position: relative;
    width: 50px;
    height: 28px;
  }

  .switch-label {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 2px solid;
    border-radius: 16px;
    cursor: pointer;
    transition: background-color 300ms ease, border-color 300ms ease;

    .checkbox { position: absolute; display: none; }

    .slider {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 16px;
      transition: 0.3s;

      &::before {
        content: "";
        position: absolute;
        top: 4px;
        left: 4px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        transition: 0.3s;
      }
    }

    .checkbox:checked ~ .slider::before {
      transform: translateX(22px);
    }
  }
</style>

<script>
	import { initHeaderScroll } from "../scripts/header-scroll";
	initHeaderScroll();
</script>
