---
import { getLang, useTranslations } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const isEn = lang === 'en';
const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": isEn ? "Home" : "Inicio", "item": isEn ? "https://marcgallego.com/en/" : "https://marcgallego.com/" },
		{ "@type": "ListItem", "position": 2, "name": isEn ? "Contact" : "Contacto", "item": isEn ? "https://marcgallego.com/en/contact/" : "https://marcgallego.com/contacto/" }
	]
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

<main class="min-h-screen bg-primary pt-18">
<section id="contact" class="contact-section border-t border-secondary">

	<!-- Izquierda: form -->
	<div class="contact-left">
		<div class="contact-header">
			<h1 class="contact-title font-nord font-normal text-secondary">{t.contact.title}</h1>
			<p class="text-mono-label-soft mt-2">
				{t.contact.subtitle}
			</p>
		</div>

		<div class="contact-form-wrap">
			<form class="contact-form" data-contact-form action="https://formspree.io/f/xjgaoedy" method="POST">
			<div class="contact-field">
				<label for="contact-name" class="sr-only">{t.contact.namePlaceholder}</label>
				<input id="contact-name" name="name" type="text" placeholder={t.contact.namePlaceholder} class="contact-input font-cottor" required autocomplete="name" />
			</div>
			<div class="contact-field">
				<label for="contact-email" class="sr-only">{t.contact.emailPlaceholder}</label>
				<input id="contact-email" name="email" type="email" placeholder={t.contact.emailPlaceholder} class="contact-input font-cottor" required autocomplete="email" />
			</div>
			<div class="contact-field">
				<label for="contact-message" class="sr-only">{t.contact.messagePlaceholder}</label>
				<textarea id="contact-message" name="message" placeholder={t.contact.messagePlaceholder} class="contact-input contact-textarea font-cottor" rows="5" required></textarea>
			</div>
			<button type="submit" class="contact-submit font-nord font-medium text-[12px]" data-submit-btn>
				{t.contact.submitLabel}
			</button>
			<p class="contact-feedback text-cottor-body" data-contact-feedback aria-live="polite"></p>
		</form>
		</div>

	</div>

	<!-- Derecha: gradient -->
	<div class="contact-photo" id="contact-gradient" aria-hidden="true"></div>

</section>
</main>

<style lang="scss">
	.contact-section {
		min-height: calc(100vh - 72px);
		display: grid;
		grid-template-columns: 1fr 1fr;
		overflow: hidden;
	}

	// ── Izquierda ──
	.contact-left {
		display: flex;
		flex-direction: column;
		padding: 4rem 1rem;
		border-right: 1px solid var(--secondary);

		@media (min-width: 768px) {
			padding: 4rem 64px;
		}
	}

	.contact-header {
		flex-shrink: 0;
	}

	.contact-form-wrap {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;

		@media (max-width: 767px) {
			flex: 0;
			margin-top: 1.5rem;
		}
	}

	.contact-title {
		font-size: clamp(35px, 8vw, 80px);
		line-height: 1;
	}

	// ── Form ──
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.contact-input {
		width: 100%;
		background-color: var(--terciary);
		border: 1px solid var(--quaternary);
		border-radius: 10px;
		padding: 14px 16px;
		font-size: 15px;
		font-weight: 300;
		color: var(--secondary);
		outline: none;
		transition: border-color 0.2s;

		&:focus {
			border-color: var(--secondary-soft);
		}

		&::placeholder {
			color: var(--secondary-soft);
		}
	}

	.contact-textarea {
		resize: none;
	}

	.contact-submit {
		width: 100%;
		background-color: var(--secondary);
		color: var(--primary);
		padding: 20px;
		border: none;
		border-radius: 10px;
		cursor: pointer;
		margin-top: 4px;
		transition: background-color 400ms cubic-bezier(0.22, 1, 0.36, 1);

		&:hover {
			background-color: color-mix(in srgb, var(--secondary) 80%, transparent);
		}
	}

	// ── Gradient ──
	.contact-photo {
		overflow: hidden;
		height: 100%;
	}

	// ── Mobile ──
	@media (max-width: 767px) {
		.contact-section {
			grid-template-columns: 1fr;
		}

		.contact-left {
			border-right: none;
		}

		.contact-form-wrap {
			justify-content: flex-start;
		}

		.contact-photo {
			display: none;
		}
	}

	.contact-feedback {
		min-height: 1.25rem;
		color: var(--secondary);
		opacity: 0.7;
		&.is-error { color: #e05555; opacity: 1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-input,
		.contact-submit {
			transition: none;
		}
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const feedback = document.querySelector<HTMLElement>('[data-contact-feedback]');
	const btn = document.querySelector<HTMLButtonElement>('[data-submit-btn]');

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!form || !feedback || !btn) return;

		btn.disabled = true;
		const originalText = btn.textContent;
		btn.textContent = '...';

		try {
			const res = await fetch(form.action, {
				method: 'POST',
				body: new FormData(form),
				headers: { Accept: 'application/json' },
			});

			if (res.ok) {
				form.reset();
				feedback.classList.remove('is-error');
				feedback.textContent = '✓ Mensaje enviado. Te respondo pronto.';
				btn.textContent = originalText;
				btn.disabled = false;
			} else {
				throw new Error();
			}
		} catch {
			feedback.classList.add('is-error');
			feedback.textContent = 'Algo ha ido mal. Prueba de nuevo o escríbeme directamente.';
			btn.textContent = originalText;
			btn.disabled = false;
		}
	});
</script>

<script src="/unicorn/unicornStudio.umd.js" is:inline></script>
<script is:inline>
	(function() {
		var contactScene = null;

		function getGradientFile() {
			return document.documentElement.classList.contains('dark')
				? '/unicorn/mouse-tracking-gradient.json'
				: '/unicorn/mouse-tracking-gradient-light.json';
		}

		function loadContactScene() {
			if (contactScene) {
				contactScene.destroy();
				contactScene = null;
			}
			if (typeof UnicornStudio === 'undefined') return;
			UnicornStudio.addScene({
				elementId: 'contact-gradient',
				fps: 60,
				scale: 1,
				dpi: window.devicePixelRatio || 1,
				filePath: getGradientFile(),
				interactivity: { mouse: { disableMobile: false } }
			}).then(function(scene) {
				contactScene = scene;
			});
		}

		document.addEventListener('DOMContentLoaded', function() {
			loadContactScene();

			var observer = new MutationObserver(function(mutations) {
				mutations.forEach(function(mutation) {
					if (mutation.attributeName === 'class') {
						loadContactScene();
					}
				});
			});
			observer.observe(document.documentElement, { attributes: true });

		});
	})();
</script>
