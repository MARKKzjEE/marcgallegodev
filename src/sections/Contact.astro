---
import { Image } from 'astro:assets';
import gradientBg from '../assets/fqm-gradient.png';
import gradientBgDark from '../assets/fqm-gradient-dark2.png';
---

<section id="contact" class="contact-section bg-primary border-b border-secondary">

	<!-- Gradient hero: 1/3 viewport -->
	<div class="contact-hero relative overflow-hidden border-b border-secondary" data-contact-hero>
		<Image src={gradientBg} alt="" class="contact-bg dark:opacity-0 transition-opacity duration-500" quality={90} aria-hidden="true" />
		<Image src={gradientBgDark} alt="" class="contact-bg opacity-0 dark:opacity-100 transition-opacity duration-500" quality={90} aria-hidden="true" />
		<div class="contact-hero__content container mx-auto px-6">
			<h1 class="contact-hero__title font-vogun font-light leading-[1.2] text-white/75">Construyamos algo prometedor juntos</h1>
		</div>
	</div>

	<!-- Form: 2/3 area, no overlap -->
	<div class="contact-form-wrapper container mx-auto px-6 py-24">
		<div class="contact-card">
			<div class="contact-card__content">
				<h2 class="font-vogun text-secondary font-bold text-3xl uppercase tracking-[0.15em]">Contacto</h2>
				<form class="contact-form" data-contact-form>
					<div class="contact-field">
						<label for="contact-name" class="contact-label">Nombre</label>
						<input id="contact-name" name="name" type="text" class="contact-input" required />
					</div>
					<div class="contact-field">
						<label for="contact-email" class="contact-label">Email</label>
						<input id="contact-email" name="email" type="email" class="contact-input" required />
					</div>
					<div class="contact-field">
						<label for="contact-message" class="contact-label">Mensaje</label>
						<textarea id="contact-message" name="message" class="contact-input contact-textarea" rows="4" required></textarea>
					</div>
					<div class="contact-submit-wrapper" data-reveal data-reveal-radius="32px">
						<button type="submit" class="contact-submit font-nord font-medium text-[11px] uppercase tracking-widest">Enviar</button>
						<span class="contact-submit-reveal reveal-layer font-nord font-medium text-[11px] uppercase tracking-widest" aria-hidden="true">Enviar</span>
					</div>
				</form>
			</div>
		</div>
	</div>

</section>

<style lang="scss">
	.contact-section {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	// ── Gradient hero: 1/3 viewport ──
	.contact-hero {
		height: 33.33vh;
		flex-shrink: 0;
	}

	.contact-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.contact-hero__content {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		height: 100%;
		padding-top: 64px; // account for header height
	}

	.contact-hero__title {
		font-size: clamp(28px, 5vw, 52px);
	}

	// ── Form wrapper: 2/3 area ──
	.contact-form-wrapper {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.contact-card {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 700px;
		max-width: 100%;
		line-height: 1.6;
		transition: all 0.48s cubic-bezier(0.23, 1, 0.32, 1);
	}

	.contact-card__content {
		display: flex;
		flex-direction: column;
		gap: 32px;
		padding: 40px;
		border-radius: 4px;
		overflow: hidden;
		width: 100%;
		transition: all 0.48s cubic-bezier(0.23, 1, 0.32, 1);

		// Light
		background-color: #fff;
		border: 1px solid var(--secondary);
		box-shadow: 4px 4px 0 var(--secondary);

		&::before,
		&::after {
			position: absolute;
			content: "";
			top: -4%;
			left: 50%;
			width: 90%;
			height: 90%;
			transform: translate(-50%);
			transform-origin: bottom;
			border-radius: inherit;
			transition: all 0.48s cubic-bezier(0.23, 1, 0.32, 1);
		}

		&::before {
			background: var(--terciary);
			border: 1px solid color-mix(in srgb, var(--secondary) 20%, transparent);
			z-index: -1;
		}

		&::after {
			top: -8%;
			width: 80%;
			height: 80%;
			background: var(--secondary);
			border: 1px solid color-mix(in srgb, var(--secondary) 30%, transparent);
			z-index: -2;
		}
	}

	.contact-card:hover {
		transform: translateY(-16px);

		.contact-card__content::before {
			rotate: -8deg;
			top: 0;
			width: 100%;
			height: 100%;
		}

		.contact-card__content::after {
			rotate: 8deg;
			top: 0;
			width: 100%;
			height: 100%;
		}
	}

	// ── Dark ──
	:global(.dark) {
		.contact-card__content {
			background-color: black;
			border-color: var(--terciary);
			box-shadow: 4px 4px 0 var(--terciary);

			&::before {
				background: var(--terciary);
				border-color: color-mix(in srgb, var(--terciary) 30%, transparent);
			}

			&::after {
				background: var(--secondary);
				border-color: color-mix(in srgb, var(--terciary) 15%, transparent);
			}
		}

		.contact-input {
			border-color: var(--terciary);
			color: var(--secondary);

			&:focus {
				border-color: var(--secondary);
			}
		}

		.contact-submit {
			background-color: var(--secondary);
			color: var(--primary);
		}

		.contact-submit-reveal {
			background-color: var(--primary);
			color: var(--secondary);
		}
	}

	// ── Form ──
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.contact-field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.contact-label {
		font-family: var(--font-nord);
		font-size: 10px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--secondary);
	}

	.contact-input {
		background: transparent;
		border: none;
		border-bottom: 1px solid var(--secondary);
		padding: 8px 0;
		font-family: var(--font-cottor);
		font-size: 14px;
		font-weight: 400;
		color: var(--secondary);
		outline: none;
		transition: border-color 0.3s;

		&:focus {
			border-color: var(--secondary);
			border-bottom-width: 2px;
		}

		&::placeholder {
			color: color-mix(in srgb, var(--secondary) 30%, transparent);
		}
	}

	.contact-textarea {
		resize: none;
		min-height: 100px;
	}

	.contact-submit-wrapper {
		--reveal-extend: 30px;
		position: relative;
		align-self: flex-start;
		margin-top: 8px;
		cursor: pointer;
	}

	.contact-submit {
		background-color: var(--secondary);
		color: var(--primary);
		padding: 10px 28px;
		border: none;
		cursor: pointer;
	}

	.contact-submit-reveal {
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: var(--primary);
		color: var(--secondary);
		padding: calc(10px + var(--reveal-extend)) calc(28px + var(--reveal-extend));
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-card,
		.contact-card__content,
		.contact-card__content::before,
		.contact-card__content::after,
		.contact-input {
			transition: none;
		}
	}
</style>

<script>
	import '../scripts/circle-reveal.ts';
</script>
