---
import { Image } from 'astro:assets';
import contactGradient from '../assets/contact-gradient.jpg';
---

<section id="contact" class="contact-section border-t border-secondary">

	<!-- Izquierda: form -->
	<div class="contact-left">
		<h2 class="contact-title font-vogun font-light text-secondary">Hablemos.</h2>
		<p class="font-cottor font-light text-secondary/60 mt-4 leading-7 max-w-sm">
			¿Tienes un proyecto en mente o simplemente quieres saludar? Escríbeme.
		</p>

		<p class="font-nord font-medium text-secondary text-[10px] uppercase tracking-widest mt-12 mb-6">Escríbeme un mensaje</p>

		<form class="contact-form" data-contact-form>
			<div class="contact-field">
				<input id="contact-name" name="name" type="text" placeholder="Nombre" class="contact-input font-cottor" required />
			</div>
			<div class="contact-field">
				<input id="contact-email" name="email" type="email" placeholder="Email" class="contact-input font-cottor" required />
			</div>
			<div class="contact-field">
				<textarea id="contact-message" name="message" placeholder="Mensaje" class="contact-input contact-textarea font-cottor" rows="5" required></textarea>
			</div>
			<button type="submit" class="contact-submit font-nord font-medium text-[12px] uppercase tracking-widest">
				Enviar
			</button>
		</form>
	</div>

	<!-- Derecha: imagen full height -->
	<div class="contact-photo">
		<Image
			src={contactGradient}
			alt=""
			widths={[400, 800]}
			sizes="(max-width: 768px) 100vw, 50vw"
			format="webp"
			quality={85}
			loading="lazy"
			aria-hidden="true"
			class="contact-photo__img"
		/>
	</div>

</section>

<style lang="scss">
	.contact-section {
		height: calc(100vh - 56px);
		margin-top: 56px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		overflow: hidden;
	}

	// ── Izquierda ──
	.contact-left {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 64px;
		border-right: 1px solid var(--secondary);
	}

	.contact-title {
		font-size: clamp(48px, 5vw, 80px);
		line-height: 1.1;
	}

	// ── Form ──
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.contact-input {
		width: 100%;
		background: color-mix(in srgb, var(--secondary) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--secondary) 15%, transparent);
		border-radius: 10px;
		padding: 14px 16px;
		font-size: 15px;
		font-weight: 300;
		color: var(--secondary);
		outline: none;
		transition: border-color 0.2s;

		&:focus {
			border-color: color-mix(in srgb, var(--secondary) 40%, transparent);
		}

		&::placeholder {
			color: color-mix(in srgb, var(--secondary) 30%, transparent);
		}
	}

	.contact-textarea {
		resize: none;
	}

	.contact-submit {
		width: 100%;
		background-color: var(--secondary);
		color: var(--primary);
		padding: 16px;
		border: none;
		border-radius: 10px;
		cursor: pointer;
		margin-top: 4px;
		transition: opacity 0.2s;

		&:hover {
			opacity: 0.85;
		}
	}

	:global(.dark) .contact-submit {
		color: color-mix(in srgb, var(--secondary) 100%, transparent);
		background-color: color-mix(in srgb, var(--secondary) 50%, transparent);
	}

	// ── Foto full height ──
	.contact-photo {
		overflow: hidden;
		height: 100%;
	}

	.contact-photo__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
		display: block;
	}

	// ── Mobile ──
	@media (max-width: 768px) {
		.contact-section {
			grid-template-columns: 1fr;
			height: auto;
		}

		.contact-left {
			padding: 48px 32px;
		}

		.contact-photo {
			height: 300px;
			order: -1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-input,
		.contact-submit {
			transition: none;
		}
	}
</style>
