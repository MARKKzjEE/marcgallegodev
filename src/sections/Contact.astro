---
import { Image } from 'astro:assets';
import aboutSetup from '../assets/about-setup.jpeg';
---

<section id="contact" class="contact-section bg-th-bg">
	<div class="grid md:grid-cols-2 h-[calc(100vh-64px)]">

		<!-- Imagen -->
		<div class="contact-image hidden md:block relative overflow-hidden">
			<Image
				src={aboutSetup}
				alt="Setup de trabajo"
				widths={[600, 900, 1200]}
				sizes="50vw"
				format="webp"
				quality={90}
				class="h-full w-full object-cover grayscale"
			/>
			<div class="absolute inset-0 bg-th-text/50 mix-blend-color dark:hidden"></div>
		</div>

		<!-- Formulario -->
		<div class="flex items-center justify-center p-10">
			<div class="contact-card">
				<div class="contact-card__content">
					<h2 class="font-vogun text-th-heading font-bold text-3xl uppercase tracking-[0.15em]">Contacto</h2>
					<form class="contact-form" data-contact-form>
						<div class="contact-field">
							<label for="contact-name" class="contact-label">Nombre</label>
							<input id="contact-name" name="name" type="text" class="contact-input" required />
						</div>
						<div class="contact-field">
							<label for="contact-email" class="contact-label">Email</label>
							<input id="contact-email" name="email" type="email" class="contact-input" required />
						</div>
						<div class="contact-field">
							<label for="contact-message" class="contact-label">Mensaje</label>
							<textarea id="contact-message" name="message" class="contact-input contact-textarea" rows="4" required></textarea>
						</div>
						<div class="contact-submit-wrapper" data-reveal data-reveal-radius="32px">
							<button type="submit" class="contact-submit font-nord font-medium text-[11px] uppercase tracking-widest">Enviar</button>
							<span class="contact-submit-reveal reveal-layer font-nord font-medium text-[11px] uppercase tracking-widest" aria-hidden="true">Enviar</span>
						</div>
					</form>
				</div>
			</div>
		</div>

	</div>
</section>

<style lang="scss">
	.contact-section {
		border-top: 1px solid var(--th-l-dark-blue);
		border-bottom: 1px solid var(--th-l-dark-blue);
	}

	.contact-image {
		border-right: 1px solid var(--th-l-dark-blue);
	}

	.contact-card {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 600px;
		max-width: 100%;
		line-height: 1.6;
		transition: all 0.48s cubic-bezier(0.23, 1, 0.32, 1);
	}

	.contact-card__content {
		display: flex;
		flex-direction: column;
		gap: 32px;
		padding: 40px;
		border-radius: 4px;
		overflow: hidden;
		width: 100%;
		transition: all 0.48s cubic-bezier(0.23, 1, 0.32, 1);

		// Light
		background-color: #fff;
		border: 1px solid var(--th-l-dark-blue);
		box-shadow: 4px 4px 0 var(--th-l-dark-blue);

		&::before,
		&::after {
			position: absolute;
			content: "";
			top: -4%;
			left: 50%;
			width: 90%;
			height: 90%;
			transform: translate(-50%);
			transform-origin: bottom;
			border-radius: inherit;
			transition: all 0.48s cubic-bezier(0.23, 1, 0.32, 1);
		}

		&::before {
			background: color-mix(in srgb, var(--th-l-dark-blue) 8%, var(--th-l-cream));
			border: 1px solid color-mix(in srgb, var(--th-l-dark-blue) 20%, transparent);
			z-index: -1;
		}

		&::after {
			top: -8%;
			width: 80%;
			height: 80%;
			background: color-mix(in srgb, var(--th-l-dark-blue) 4%, var(--th-l-cream));
			border: 1px solid color-mix(in srgb, var(--th-l-dark-blue) 10%, transparent);
			z-index: -2;
		}
	}

	.contact-card:hover {
		transform: translateY(-16px);

		.contact-card__content::before {
			rotate: -8deg;
			top: 0;
			width: 100%;
			height: 100%;
		}

		.contact-card__content::after {
			rotate: 8deg;
			top: 0;
			width: 100%;
			height: 100%;
		}
	}

	// ── Dark ──
	:global(.dark) {
		.contact-section {
			border-color: var(--th-d-grey-light);
		}

		.contact-image {
			border-color: var(--th-d-grey-light);
		}

		.contact-card__content {
			background-color: var(--th-d-grey-dark);
			border-color: var(--th-d-grey-light);
			box-shadow: 4px 4px 0 var(--th-d-grey-light);

			&::before {
				background: color-mix(in srgb, var(--th-d-grey-dark) 80%, var(--th-d-carbon));
				border-color: color-mix(in srgb, var(--th-d-grey-light) 30%, transparent);
			}

			&::after {
				background: color-mix(in srgb, var(--th-d-grey-dark) 60%, var(--th-d-carbon));
				border-color: color-mix(in srgb, var(--th-d-grey-light) 15%, transparent);
			}
		}

		.contact-input {
			border-color: var(--th-d-grey-light);
			color: var(--th-d-white);

			&:focus {
				border-color: var(--th-d-white);
			}
		}

		.contact-submit {
			background-color: var(--th-d-white);
			color: var(--th-d-carbon);
		}

		.contact-submit-reveal {
			background-color: var(--th-d-carbon);
			color: var(--th-d-white);
		}
	}

	// ── Form ──
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.contact-field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.contact-label {
		font-family: var(--font-nord);
		font-size: 10px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--th-heading);
	}

	.contact-input {
		background: transparent;
		border: none;
		border-bottom: 1px solid var(--th-l-dark-blue);
		padding: 8px 0;
		font-family: var(--font-cottor);
		font-size: 14px;
		font-weight: 400;
		color: var(--th-text);
		outline: none;
		transition: border-color 0.3s;

		&:focus {
			border-color: var(--th-l-dark-blue);
			border-bottom-width: 2px;
		}

		&::placeholder {
			color: color-mix(in srgb, var(--th-text) 30%, transparent);
		}
	}

	.contact-textarea {
		resize: none;
		min-height: 100px;
	}

	.contact-submit-wrapper {
		--reveal-extend: 30px;
		position: relative;
		align-self: flex-start;
		margin-top: 8px;
		cursor: pointer;
	}

	.contact-submit {
		background-color: var(--th-l-dark-blue);
		color: var(--th-l-cream);
		padding: 10px 28px;
		border: none;
		cursor: pointer;
	}

	.contact-submit-reveal {
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: var(--th-l-cream);
		color: var(--th-l-dark-blue);
		padding: calc(10px + var(--reveal-extend)) calc(28px + var(--reveal-extend));
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-card,
		.contact-card__content,
		.contact-card__content::before,
		.contact-card__content::after,
		.contact-input {
			transition: none;
		}
	}
</style>

<script>
	import '../scripts/circle-reveal.ts';
</script>
