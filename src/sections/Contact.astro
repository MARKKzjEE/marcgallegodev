---
import { getLang, useTranslations, getLocalePath } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": t.breadcrumbs.home, "item": new URL(getLocalePath(lang, '/'), Astro.site).href },
		{ "@type": "ListItem", "position": 2, "name": t.breadcrumbs.contact, "item": new URL(getLocalePath(lang, '/contact'), Astro.site).href }
	]
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

<main class="bg-primary pt-18">
<section id="contact" class="contact-section">

	<!-- Título -->
	<div class="contact-header px-4 md:px-10">
		<h1 class="contact-title font-nord font-normal text-secondary">{t.contact.title}</h1>
	</div>

	<!-- Gradient central enmarcado -->
	<div class="contact-gradient-wrap px-4 md:px-10">
		<div class="contact-gradient" id="contact-gradient" aria-hidden="true"></div>
	</div>

	<!-- Form horizontal (3 columnas) -->
	<div class="contact-form-wrap px-4 md:px-10">
		<form class="contact-form" data-contact-form action="https://formspree.io/f/xjgaoedy" method="POST" data-success={t.contact.successMessage} data-error={t.contact.errorMessage}>
			<!-- Honeypot anti-spam de Formspree: invisible para personas, los bots lo rellenan -->
			<input type="text" name="_gotcha" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
			<!-- Col 1: Nombre + Mail apilados -->
			<div class="contact-col contact-col--identity">
				<div class="contact-field">
					<label for="contact-name" class="sr-only">{t.contact.namePlaceholder}</label>
					<input id="contact-name" name="name" type="text" placeholder={t.contact.namePlaceholder} class="contact-input font-cottor" required autocomplete="name" />
				</div>
				<div class="contact-field">
					<label for="contact-email" class="sr-only">{t.contact.emailPlaceholder}</label>
					<input id="contact-email" name="email" type="email" placeholder={t.contact.emailPlaceholder} class="contact-input font-cottor" required autocomplete="email" />
				</div>
			</div>

			<!-- Col 2: Mensaje -->
			<div class="contact-col contact-col--message">
				<div class="contact-field">
					<label for="contact-message" class="sr-only">{t.contact.messagePlaceholder}</label>
					<textarea id="contact-message" name="message" placeholder={t.contact.messagePlaceholder} class="contact-input contact-textarea font-cottor" required></textarea>
				</div>
			</div>

			<!-- Col 3: CTA -->
			<div class="contact-col contact-col--cta">
				<button type="submit" class="contact-submit font-nord font-medium text-[12px]" data-submit-btn>
					{t.contact.submitLabel}
				</button>
			</div>

			<p class="contact-feedback text-cottor-body" data-contact-feedback aria-live="polite"></p>
		</form>
	</div>

</section>
</main>

<style lang="scss">
	// ── Composición vertical: título → gradient → form ──
	// Altura exacta = viewport − header (72px). Todo cabe sin scroll;
	// el footer aparece al scrollear. El gradient absorbe el espacio sobrante.
	.contact-section {
		height: calc(100svh - 72px);
		display: flex;
		flex-direction: column;
		// Mismo espacio header→título que Trayectoria y Proyectos (pt-16 = 4rem).
		padding-top: 4rem;
		padding-bottom: 1.5rem;
		gap: 1rem;

		@media (min-width: 768px) {
			padding-bottom: 2.5rem;
			gap: 2rem;
		}

		// Pantallas muy bajas (móvil en horizontal): no cabe en un viewport,
		// la sección crece y el gradient pasa a altura fija (ver abajo)
		@media (max-height: 500px) {
			height: auto;
		}
	}

	.contact-header {
		flex-shrink: 0;
	}

	.contact-title {
		font-size: clamp(35px, 8vw, 80px);
		line-height: 1;
	}

	// ── Gradient central enmarcado ──
	.contact-gradient-wrap {
		flex: 1;
		min-height: 0;
		display: flex;

		@media (max-height: 500px) {
			flex: none;
			height: 160px;
		}
	}

	.contact-gradient {
		width: 100%;
		height: 100%;
		border: 1px solid var(--secondary);
		overflow: hidden;
	}

	// ── Form horizontal (3 columnas) ──
	.contact-form-wrap {
		flex-shrink: 0;
	}

	.contact-form {
		display: grid;
		grid-template-columns: minmax(200px, 1fr) 2fr auto;
		gap: 16px;
		align-items: stretch;

		@media (max-width: 767px) {
			grid-template-columns: 1fr;
			gap: 10px;
		}
	}

	.contact-col {
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-width: 0;

		@media (max-width: 767px) {
			gap: 10px;
		}
	}

	.contact-col--cta {
		justify-content: stretch;
	}

	.contact-field {
		display: flex;
		flex: 1;
	}

	.contact-input {
		width: 100%;
		background-color: var(--terciary);
		border: 1px solid var(--quaternary);
		border-radius: 4px;
		padding: 14px 16px;
		font-size: 15px;
		font-weight: 300;
		color: var(--secondary);
		outline: none;
		transition: border-color 0.2s;

		&:focus {
			border-color: var(--secondary-soft);
		}

		&::placeholder {
			color: var(--secondary-soft);
		}

		@media (max-width: 767px) {
			padding: 11px 14px;
		}
	}

	.contact-textarea {
		resize: none;
		height: 100%;
		min-height: 96px;

		@media (max-width: 767px) {
			min-height: 64px;
		}
	}

	.contact-submit {
		width: 100%;
		height: 100%;
		background-color: var(--secondary);
		color: var(--primary);
		padding: 20px 40px;
		border: none;
		border-radius: 4px;
		cursor: pointer;
		white-space: nowrap;
		transition: background-color 400ms cubic-bezier(0.22, 1, 0.36, 1);

		&:hover {
			background-color: color-mix(in srgb, var(--secondary) 80%, transparent);
		}

		@media (max-width: 767px) {
			padding: 14px;
		}
	}

	.contact-honeypot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}

	.contact-feedback {
		grid-column: 1 / -1;
		min-height: 1.25rem;
		color: var(--secondary);
		opacity: 0.7;
		&.is-error { color: #e05555; opacity: 1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-input,
		.contact-submit {
			transition: none;
		}
	}
</style>

<script>
	import { mountUnicornScene } from '../scripts/unicorn-scene';

	mountUnicornScene('contact-gradient');

	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const feedback = document.querySelector<HTMLElement>('[data-contact-feedback]');
	const btn = document.querySelector<HTMLButtonElement>('[data-submit-btn]');

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!form || !feedback || !btn) return;

		btn.disabled = true;
		const originalText = btn.textContent;
		btn.textContent = '...';

		try {
			const res = await fetch(form.action, {
				method: 'POST',
				body: new FormData(form),
				headers: { Accept: 'application/json' },
			});

			if (res.ok) {
				form.reset();
				feedback.classList.remove('is-error');
				feedback.textContent = form.dataset.success ?? '';
				btn.textContent = originalText;
				btn.disabled = false;
			} else {
				throw new Error();
			}
		} catch {
			feedback.classList.add('is-error');
			feedback.textContent = form.dataset.error ?? '';
			btn.textContent = originalText;
			btn.disabled = false;
		}
	});
</script>
