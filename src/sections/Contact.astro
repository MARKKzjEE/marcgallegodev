---
import { Image } from 'astro:assets';
import contactGradient from '../assets/gradients/contact-gradient.jpg';
import { getLang, useTranslations } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="contact-section border-t border-secondary">

	<!-- Izquierda: form -->
	<div class="contact-left">
		<h2 class="contact-title font-vogun font-light text-secondary">{t.contact.title}</h2>
		<p class="font-cottor font-light text-secondary/60 mt-4 leading-7">
			{t.contact.subtitle}
		</p>

		<p class="font-nord font-medium text-secondary text-[10px] uppercase tracking-widest mt-12 mb-6">{t.contact.writeLabel}</p>

		<form class="contact-form" data-contact-form>
			<div class="contact-field">
				<input id="contact-name" name="name" type="text" placeholder={t.contact.namePlaceholder} class="contact-input font-cottor" required />
			</div>
			<div class="contact-field">
				<input id="contact-email" name="email" type="email" placeholder={t.contact.emailPlaceholder} class="contact-input font-cottor" required />
			</div>
			<div class="contact-field">
				<textarea id="contact-message" name="message" placeholder={t.contact.messagePlaceholder} class="contact-input contact-textarea font-cottor" rows="5" required></textarea>
			</div>
			<button type="submit" class="contact-submit font-nord font-medium text-[12px] uppercase tracking-widest">
				{t.contact.submitLabel}
			</button>
		</form>
	</div>

	<!-- Derecha: imagen full height -->
	<div class="contact-photo">
		<Image
			src={contactGradient}
			alt=""
			widths={[400, 800]}
			sizes="(max-width: 768px) 100vw, 50vw"
			format="webp"
			quality={85}
			loading="lazy"
			aria-hidden="true"
			class="contact-photo__img"
		/>
	</div>

</section>

<style lang="scss">
	.contact-section {
		height: calc(100vh - 56px);
		margin-top: 56px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		overflow: hidden;
	}

	// ── Izquierda ──
	.contact-left {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 64px;
		border-right: 1px solid var(--secondary);
	}

	.contact-title {
		font-size: clamp(48px, 5vw, 80px);
		line-height: 1.1;
	}

	// ── Form ──
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.contact-input {
		width: 100%;
		background: color-mix(in srgb, var(--secondary) 15%, transparent);
		border: 1px solid color-mix(in srgb, var(--secondary) 20%, transparent);
		border-radius: 10px;
		padding: 14px 16px;
		font-size: 15px;
		font-weight: 300;
		color: var(--secondary);
		outline: none;
		transition: border-color 0.2s;

		&:focus {
			border-color: color-mix(in srgb, var(--secondary) 50%, transparent);
		}

		&::placeholder {
			color: color-mix(in srgb, var(--secondary) 40%, transparent);
		}
	}

	.contact-textarea {
		resize: none;
	}

	.contact-submit {
		width: 100%;
		background-color: var(--secondary);
		color: var(--primary);
		padding: 16px;
		border: none;
		border-radius: 10px;
		cursor: pointer;
		margin-top: 4px;
		transition: opacity 0.2s;

		&:hover {
			opacity: 0.85;
		}
	}

	:global(.dark) .contact-submit {
		color: color-mix(in srgb, var(--secondary) 100%, transparent);
		background-color: color-mix(in srgb, var(--secondary) 50%, transparent);
	}

	// ── Foto full height ──
	.contact-photo {
		overflow: hidden;
		height: 100%;
	}

	.contact-photo__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
		display: block;
	}

	// ── Mobile ──
	@media (max-width: 767px) {
		.contact-section {
			grid-template-columns: 1fr;
			height: calc(100vh - 56px);
		}

		.contact-left {
			padding: 48px 1rem;
			border-right: none;
			overflow-y: auto;
		}

		.contact-photo {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-input,
		.contact-submit {
			transition: none;
		}
	}
</style>
