---
import { Image } from 'astro:assets';
import dokostudio from '../assets/clients/dokostudio.png';
import { getLang, useTranslations } from '../i18n';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section id="partners" class="py-16 md:py-30" aria-labelledby="partners-heading">
	<div class="px-4 md:px-10">

		<h2 id="partners-heading" class="font-nord font-normal text-secondary partners-title mb-2">{t.partners.heading}</h2>
		<p class="text-mono-label-soft mb-8">{t.partners.subtitle}</p>

		<div class="partners-grid">
			<div class="partners-card">
				<div class="card-image">
					<Image src={dokostudio} alt={t.partners.dokoImgAlt} loading="lazy" quality={85} widths={[400, 800]} sizes="(min-width: 768px) 66vw, 100vw" format="webp" />
				</div>
				<div class="card-info">
					<div class="left min-w-0">
						<h4 class="project-card-title font-monoblock font-medium text-secondary">Doko Studio</h4>
						<p class="project-card-desc font-cottor font-light text-secondary/80">{t.partners.dokoDesc}</p>
					</div>
					<div class="right hidden md:block">
						<span class="text-mono-label-soft bg-quaternary p-4 rounded-full border text-center whitespace-nowrap">{t.partners.badge}</span>
					</div>
				</div>
			</div>

			<div class="studio-card" data-reveal data-reveal-radius="32px">
				<span class="studio-label font-monoblock font-normal text-secondary uppercase">{t.partners.studioLabel}</span>
				<p class="font-cottor font-light text-secondary/80 text-sm mt-4">{t.partners.studioText1}</p>
				<p class="font-cottor font-light text-secondary/80 text-sm mt-3">{t.partners.studioText2}</p>
				<a href="https://doko.studio/" target="_blank" rel="noopener noreferrer" class="studio-link mt-8 font-cottor font-normal inline-flex items-center gap-1" data-reveal-trigger>{t.partners.studioLink}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right-icon lucide-arrow-up-right"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
				<!-- Reveal layer -->
				<div class="studio-card__reveal reveal-layer" aria-hidden="true">
					<span class="studio-label font-monoblock font-normal text-secondary uppercase">{t.partners.studioLabel}</span>
					<p class="font-cottor font-light text-sm mt-4">{t.partners.studioText1}</p>
					<p class="font-cottor font-light text-sm mt-3">{t.partners.studioText2}</p>
					<span class="studio-link mt-8 font-cottor font-normal inline-flex items-center gap-1">{t.partners.studioLink}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right-icon lucide-arrow-up-right"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></span>
				</div>
			</div>
		</div>

	</div>
</section>

<style lang="scss">
    .partners-title {
        font-size: clamp(35px, 8vw, 80px);
        line-height: 1;
    }

    .partners-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 2rem;
        align-items: stretch;

        @media (max-width: 767px) {
            grid-template-columns: 1fr;
        }
    }

    .partners-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 10px;
        background-color: var(--terciary);
        border: 1px solid color-mix(in srgb, var(--secondary) 8%, transparent);

        .right span {
            border-color: color-mix(in srgb, var(--secondary) 10%, transparent);
        }
    }

    .card-image {
        width: 100%;
        height: 400px;
        overflow: hidden;
        background-color: #6130EB;
        display: flex;
        align-items: center;
        justify-content: center;
        filter: brightness(0.9);

        @media (max-width: 767px) {
            height: 300px;
        }

        img {
            max-width: 60%;
            height: auto;
            object-fit: contain;
            transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
        }
    }

    .partners-card:hover .card-image img {
        transform: scale(1.08);
    }

    .card-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        padding: 1.5rem;

        @media (max-width: 767px) {
            padding: 1rem;
        }

        .left {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }
    }

    .project-card-title {
        font-size: clamp(1.1rem, 2vw, 1.4rem);
    }

    .project-card-desc {
        font-size: 0.875rem;
    }

    .studio-card {
        --reveal-extend: 20px;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 1.5rem;
        border-radius: 10px;
        background-color: var(--terciary);
        border: 1px solid color-mix(in srgb, var(--secondary) 8%, transparent);

        @media (max-width: 767px) {
            padding: 1rem;
        }
    }

    .studio-card__reveal {
        background: var(--secondary);
        padding: calc(1.5rem + var(--reveal-extend, 0px));
        display: flex;
        flex-direction: column;
        justify-content: center;

        &, * {
            color: var(--primary) !important;
        }

        @media (max-width: 767px) {
            padding: calc(1rem + var(--reveal-extend, 0px));
        }
    }
</style>

<script>
	import '../scripts/circle-reveal.ts';
</script>

