---
import { Image } from 'astro:assets';
import dokostudio from '../assets/dokostudio.webp';
---

<section id="partners" class="py-40">
	<div class="container mx-auto px-10">
		<div class="flex flex-col gap-8">

			<div class="title-clip">
			<h3 class="font-nord font-bold text-secondary uppercase partners-title">Partners</h3>
		</div>

			<div class="partners-card">
                <div class="card-image">
                    <Image src={dokostudio} alt="Doko Studio" />
                </div>
                <div class="card-info">
                    <div class="left">
                        <h4 class="font-nord font-bold text-secondary text-2xl">Doko Studio</h4>
                        <p class="font-monoblock font-normal text-secondary/90 text-sm mt-1 tracking-widest">Estudio de diseño y desarrollo web</p>
                    </div>
                    <div class="right">
                        <span class="font-nord text-secondary text-sm uppercase tracking-widest bg-quaternary p-4 rounded-full border">desde 2024</span>
                    </div>
                </div>
            </div>

		</div>
	</div>
</section>

<style lang="scss">
    #partners {
        h3 {
            font-size: clamp(52px, 7vw, 96px);
            line-height: 1;
        }
    }

    .title-clip {
        overflow: hidden;
        padding-bottom: 0.15em;
    }

    .partners-title {
        display: block;
        transform: translateY(110%);
        transition: transform 0.5s cubic-bezier(0.34, 2.1, 0.64, 1);
        margin-bottom: 0;

        &.is-visible {
            transform: translateY(0);
        }
    }

    .partners-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 12px;
        background-color: var(--terciary);
        border: 1px solid color-mix(in srgb, var(--secondary) 8%, transparent);

        .right span {
            border-color: color-mix(in srgb, var(--secondary) 10%, transparent);
        }
    }

    .card-image {
        width: 100%;
        height: 400px;
        overflow: hidden;
        background-color: #6130EB;
        display: flex;
        align-items: center;
        justify-content: center;

        img {
            max-width: 60%;
            height: auto;
            object-fit: contain;
            transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
        }
    }

    .partners-card:hover .card-image img {
        transform: scale(1.08);
    }

    .card-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
    }
</style>

<script>
	const clip = document.querySelector<HTMLElement>('.title-clip');
	const title = document.querySelector<HTMLElement>('.partners-title');
	if (clip && title) {
		new IntersectionObserver(([entry]) => {
			title.classList.toggle('is-visible', entry.isIntersecting);
		}, { threshold: 0, rootMargin: '0px 0px -10% 0px' }).observe(clip);
	}
</script>
