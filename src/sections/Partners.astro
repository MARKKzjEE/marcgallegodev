---
import { Image } from 'astro:assets';
import ProjectLink from '../components/ProjectLink.astro';
import dokostudio from '../assets/projects/dokostudio.png';
import { getLang, useTranslations } from '../i18n';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

// Statement grande: cada fragmento separado por " / " va en su línea.
const statementLines = t.partners.statement.split(' / ');
// Indentación (%) por línea → escalada irregular tipo editorial (como la ref).
// "Branding" (4ª línea) sobresale más que "Diseño &" (3ª).
const indents = [0, 22, 40, 60, 12];
// Móvil: offset (vw) desde el centro, ALTERNANDO lado → zigzag marcado.
// Negativo = izquierda · positivo = derecha. Amplitud generosa pero contenida
// por max-width: 70vw (deja ~15vw de holgura a cada lado).
const mobileShifts = [-13, 11, -9, 13, -10];
---

<section id="partners" class="partners pt-20 md:pt-30" aria-labelledby="partners-heading">
	<div class="partners-inner px-4 md:px-10">

		<!-- Metadatos en [ corchetes ] (esquinas superiores) -->
		<div class="partners-meta">
			<span class="text-mono-label">[ {t.partners.metaName} ]</span>
			<span class="text-mono-label partners-meta__center">[ {t.partners.metaCenter} ]</span>
			<span class="text-mono-label">[ {t.partners.metaSince} ]</span>
		</div>

		<!-- Statement grande (font-nord), escalonado por línea.
		     El '&' se renderiza en script (Corinthia); la 1ª línea lleva un '/' script al final. -->
		<h2 id="partners-heading" class="partners-statement font-nord font-normal text-secondary">
			{statementLines.map((line: string, i: number) => {
				const parts = line.split('&');
				return (
					<span class="partners-statement__line" style={`--indent:${indents[i] ?? 0};--shift:${mobileShifts[i] ?? 0}`}>
						{parts.map((part: string, p: number) => (
							<>
								{part}{p < parts.length - 1 && <span class="partners-amp">&amp;</span>}
							</>
						))}
						{i === 0 && <span class="partners-amp partners-amp--slash">/</span>}
					</span>
				);
			})}
		</h2>

		<!-- Pie: bio mono (centro, con corchetes de recorte) + imagen Doko (der) -->
		<div class="partners-bottom">
			<div class="partners-bio">
				<p class="text-mono-label">{t.partners.studioText1}</p>
				<p class="text-mono-label">{t.partners.studioText2}</p>
				<!-- A la web de Doko: ↗ + círculo al pasar el ratón, como los de proyectos -->
				<p class="partners-bio__visit text-mono-label">
					<ProjectLink href="https://doko.studio/" text={t.partners.dokoVisit} label={t.partners.dokoLinkLabel} radius="28px" circle />
				</p>
				<!-- Marcas de recorte en las esquinas -->
				<span class="partners-bio__crop partners-bio__crop--tl" aria-hidden="true"></span>
				<span class="partners-bio__crop partners-bio__crop--tr" aria-hidden="true"></span>
				<span class="partners-bio__crop partners-bio__crop--bl" aria-hidden="true"></span>
				<span class="partners-bio__crop partners-bio__crop--br" aria-hidden="true"></span>
			</div>

			<div class="partners-image">
				<Image src={dokostudio} alt={t.partners.dokoImgAlt} loading="lazy" quality={85} widths={[400, 800]} sizes="(min-width: 768px) 40vw, 80vw" format="webp" />
			</div>
		</div>

	</div>
</section>

<style lang="scss">
	.partners-inner {
		display: flex;
		flex-direction: column;
		gap: 2rem;   // meta pegado al título (forma parte de la cabecera)
	}

	// ─── Metadatos [ ] (esquinas + centro absoluto) ───
	.partners-meta {
		position: relative;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.partners-meta__center {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);

		// En móvil no cabe centrado: se oculta para no solaparse
		@media (max-width: 767px) {
			display: none;
		}
	}

	// ─── Statement grande (font-nord) ───
	.partners-statement {
		display: flex;
		flex-direction: column;
		// Mismo tamaño que los títulos de sección estándar.
		font-size: clamp(35px, 8vw, 80px);
		line-height: 1.02;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		// Sin margen extra: el meta queda pegado al título (solo el gap del inner).

		// Compacto/centrado desde 1152px (antes solo en móvil): el título grande
		// pasa antes a su disposición centrada para no quedar disperso.
		@media (max-width: 1152px) {
			align-items: center;
			text-align: center;
			// Red de seguridad: el zigzag nunca provoca scroll lateral.
			overflow-x: clip;
		}
	}

	.partners-statement__line {
		display: block;
		// Tablet/desktop: escalonado desde la izquierda (offset empuja a la derecha)
		margin-left: calc(var(--indent, 0) * 1%);

		// Desde 1152px: offset desde el centro alternando lado (izq/der) → zigzag.
		// En vw (relativo al viewport), no al ancho de la línea → predecible.
		@media (max-width: 1152px) {
			margin-left: 0;
			transform: translateX(calc(var(--shift, 0) * 1vw));
			// Deja holgura a los lados para que el desplazamiento no se salga.
			max-width: 70vw;
			margin-inline: auto;
		}
	}

	// Acento caligráfico (& y /) en Corinthia (script)
	.partners-amp {
		font-family: var(--font-corinthia);
		font-weight: 400;
		text-transform: none;
		// Corinthia es muy fina: se agranda para equilibrar con el NORD
		font-size: 1.5em;
		line-height: 0;
		padding: 0 0.05em;
	}

	.partners-amp--slash {
		margin-left: 0.05em;
	}

	// ─── Pie: bio + imagen, dos cajas del MISMO tamaño (ratio 4:3) ───
	// Caja común: --box-w de ancho, alto derivado a 4:3 con aspect-ratio.
	.partners-bottom {
		--box-w: clamp(280px, 34vw, 440px);
		position: relative;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;   // ambas cajas centradas (apilado)
		align-items: stretch;
		gap: 2.5rem;
		margin-top: 3rem;

		// Desde 1480px: imagen a la derecha y la bio centrada en el viewport
		// (absolute). Antes no caben las dos con aire (cajas de 440px) y se
		// solapaban; por debajo van una al lado de la otra, centradas.
		@media (min-width: 1480px) {
			justify-content: flex-end;
			min-height: calc(var(--box-w) * 3 / 4); // reserva el alto de una caja
		}
	}

	// Bio: caja con texto centrado + corchetes pegados a sus bordes
	.partners-bio {
		position: relative;
		flex: 0 0 auto;
		width: var(--box-w);
		// Al menos la altura 4:3 (matchea la imagen), pero crece si el texto no cabe.
		min-height: calc(var(--box-w) * 3 / 4);
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1rem;
		padding: 2rem;

		// Desde 1480px: centrada en el ancho del viewport
		@media (min-width: 1480px) {
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
		}

		@media (max-width: 767px) {
			width: 100%;
			min-height: 0;        // en móvil manda el texto (sin forzar alto)
			padding: 1.5rem;      // espacio entre corchetes y texto
		}
	}

	// "Visita su web ↗": a la derecha y separado del texto
	.partners-bio__visit {
		margin-top: 1rem;
		text-align: right;
	}

	// Marcas de recorte ⌐ ¬ en las esquinas de la bio (color soft, como antes
	// tenían los textos → ahora el contraste lo dan los textos sólidos).
	.partners-bio__crop {
		position: absolute;
		width: 12px;
		height: 12px;
		border: 1px solid var(--secondary-soft);
	}
	.partners-bio__crop--tl { top: 0; left: 0;  border-right: none; border-bottom: none; }
	.partners-bio__crop--tr { top: 0; right: 0; border-left: none;  border-bottom: none; }
	.partners-bio__crop--bl { bottom: 0; left: 0;  border-right: none; border-top: none; }
	.partners-bio__crop--br { bottom: 0; right: 0; border-left: none;  border-top: none; }

	// ─── Imagen Doko: misma caja (--box-w × 4:3) ───
	.partners-image {
		flex: 0 0 auto;
		width: var(--box-w);
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background-color: #6130EB;
		display: flex;
		align-items: center;
		justify-content: center;

		// Móvil: tope de ancho para que no ocupe toda la pantalla
		@media (max-width: 767px) {
			width: 100%;
			max-width: 320px;
			align-self: center;
		}

		img {
			max-width: 60%;
			height: auto;
			object-fit: contain;
			transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
		}

		&:hover img { transform: scale(1.08); }
	}
</style>

