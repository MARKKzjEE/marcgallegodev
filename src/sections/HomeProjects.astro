---
import { Image } from 'astro:assets';
import { getLang, useTranslations, getLocalePath } from '../i18n/index';
import { projectImages } from '../data/projects';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

// CTA hacia el catálogo completo (celda inferior izquierda, solo tablet/desktop).
const projectsPath = getLocalePath(lang, '/projects');

// Numeración coherente con el catálogo de /proyectos (empieza en 31).
const START_NO = 31;

// Grids por breakpoint:
// · Desktop: 6 cols × 3 filas, escalonado con huecos laterales.
// · Tablet:  4 cols × 3 filas (mismo escalonado, sin las columnas vacías de los extremos → desktop −1).
// · Móvil:   2 cols × 3 filas, secuencial (sin huecos).
const GRID = {
	desktop: { cols: 6, rows: 3 },
	tablet:  { cols: 4, rows: 3 },
	mobile:  { cols: 2, rows: 3 },
};

// Coordenadas [col, fila] por breakpoint. Móvil se calcula secuencial (i).
const layout: { d: [number, number]; t: [number, number] }[] = [
	{ d: [2, 1], t: [1, 1] },
	{ d: [3, 1], t: [2, 1] },
	{ d: [4, 1], t: [3, 1] },
	{ d: [4, 2], t: [3, 2] },
	{ d: [5, 2], t: [4, 2] },
	{ d: [5, 3], t: [4, 3] },
];

const items = layout.map((pos, i) => ({
	title: t.projects.items[i].title,
	description: t.projects.items[i].description,
	image: projectImages[i],
	no: String(START_NO + i).padStart(3, '0'),
	// columnas/filas por breakpoint
	cd: pos.d[0], rd: pos.d[1],
	ct: pos.t[0], rt: pos.t[1],
	cm: (i % 2) + 1, rm: Math.floor(i / 2) + 1, // móvil: 2 cols secuencial
}));

// Puntos por breakpoint (intersecciones de cada grilla).
function makeDots(cols: number, rows: number) {
	const d: { x: number; y: number }[] = [];
	for (let r = 0; r <= rows; r++)
		for (let c = 0; c <= cols; c++)
			d.push({ x: (c / cols) * 100, y: (r / rows) * 100 });
	return d;
}
const dotsDesktop = makeDots(GRID.desktop.cols, GRID.desktop.rows);
const dotsTablet  = makeDots(GRID.tablet.cols, GRID.tablet.rows);
const dotsMobile  = makeDots(GRID.mobile.cols, GRID.mobile.rows);
---

<section id="home-projects" class="hp py-16 md:py-30" aria-labelledby="hp-heading">
	<div class="hp-inner px-4 md:px-10">

		<!-- Título -->
		<h2 id="hp-heading" class="hp-title font-nord font-normal text-secondary">{t.projects.title}</h2>

		<!-- Índice (desktop: arriba-derecha · móvil: al final tras el collage) -->
		<div class="hp-index" aria-hidden="true">
			<ul class="hp-index__list">
				{items.map((item) => (
					<li class="hp-index__item text-mono-lg">{item.no} : {item.title}</li>
				))}
			</ul>
		</div>

		<!-- Collage: grid escalonado, columnas según breakpoint -->
		<div class="hp-collage">

			<!-- Capas de puntos (una por breakpoint; el CSS muestra la que toca) -->
			<div class="hp-dots hp-dots--desktop" aria-hidden="true">
				{dotsDesktop.map((d) => <span class="hp-dot" style={`left:${d.x}%;top:${d.y}%;`}></span>)}
			</div>
			<div class="hp-dots hp-dots--tablet" aria-hidden="true">
				{dotsTablet.map((d) => <span class="hp-dot" style={`left:${d.x}%;top:${d.y}%;`}></span>)}
			</div>
			<div class="hp-dots hp-dots--mobile" aria-hidden="true">
				{dotsMobile.map((d) => <span class="hp-dot" style={`left:${d.x}%;top:${d.y}%;`}></span>)}
			</div>

			<!-- Imágenes: 3 sets de coordenadas en custom properties -->
			{items.map((item) => (
				<figure class="hp-card" style={`--cd:${item.cd};--rd:${item.rd};--ct:${item.ct};--rt:${item.rt};--cm:${item.cm};--rm:${item.rm};`}>
					<figcaption class="hp-card__head font-monoblock">IMG-{item.no}</figcaption>
					<div class="hp-card__media">
						<Image
							src={item.image}
							alt={`${item.title} — ${item.description}`}
							widths={[400, 600, 900]}
							sizes="(max-width: 768px) 45vw, 20vw"
							format="webp"
							quality={90}
							loading="lazy"
							draggable={false}
							class="hp-card__img"
						/>
					</div>
				</figure>
			))}

			<!-- CTA al catálogo completo (celda inferior izquierda, solo tablet/desktop) -->
			<a href={projectsPath} class="hp-more text-mono-lg uppercase" data-reveal data-reveal-radius="28px">
				<span class="hp-more__base">--{t.projects.moreResults}:</span>
				<span class="hp-more__reveal reveal-layer" aria-hidden="true">--{t.projects.moreResults}:</span>
			</a>
		</div>

	</div>
</section>

<style lang="scss">
	// Desktop/tablet: grid 2 columnas → título (izq) + índice (der) en fila 1,
	// collage abarcando ambas columnas en fila 2.
	.hp-inner {
		display: grid;
		grid-template-columns: 1fr auto;
		column-gap: 2rem;
		row-gap: 3rem;
		align-items: start;
	}

	.hp-title {
		grid-column: 1;
		grid-row: 1;
		font-size: clamp(35px, 8vw, 80px);
		line-height: 1;
	}

	// ─── Índice de numeración (fila 1, columna derecha) ───
	.hp-index {
		grid-column: 2;
		grid-row: 1;
		text-align: left;
	}

	.hp-index__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	// Tipografía heredada de .text-mono-label (estilo del Hero).
	.hp-index__item {
		white-space: nowrap;
	}

	// El collage ocupa ambas columnas, debajo de título e índice.
	.hp-collage {
		grid-column: 1 / -1;
	}

	// Móvil: una sola columna apilada → título (1) · collage (2) · índice (3).
	// El índice baja al final, pegado a la derecha, texto alineado por la izquierda.
	@media (max-width: 767px) {
		.hp-inner {
			grid-template-columns: 1fr;
		}
		.hp-title   { grid-column: 1; grid-row: 1; }
		.hp-collage { grid-column: 1; grid-row: 2; }
		.hp-index {
			grid-column: 1;
			grid-row: 3;
			display: flex;
			justify-content: flex-end;
		}
	}

	// ─── Collage: grid escalonado, celdas verticales (~3:4) ───
	// --cols cambia por breakpoint; el alto de fila se calcula a 3:4 con cqw.
	// Desktop 6 cols · Tablet 4 cols · Móvil 2 cols.
	.hp-collage {
		--cols: 6;
		container-type: inline-size;
		position: relative;
		display: grid;
		grid-template-columns: repeat(var(--cols), 1fr);
		grid-auto-rows: calc((100cqw / var(--cols)) * 4 / 3);
		gap: 0;

		@media (max-width: 1023px) { --cols: 4; }
		@media (max-width: 767px)  { --cols: 2; }
	}

	// Capa de puntos: cubre exactamente el grid; cada punto en su intersección %.
	.hp-dots {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 3;
	}

	// Mostrar solo la capa de puntos del breakpoint actual
	.hp-dots--tablet,
	.hp-dots--mobile { display: none; }

	@media (max-width: 1023px) {
		.hp-dots--desktop { display: none; }
		.hp-dots--tablet  { display: block; }
	}
	@media (max-width: 767px) {
		.hp-dots--tablet  { display: none; }
		.hp-dots--mobile  { display: block; }
	}

	.hp-dot {
		position: absolute;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background-color: var(--secondary);
		// centra el punto sobre la intersección
		transform: translate(-50%, -50%);
	}

	// ─── Tarjeta tipo foto pegada (llena su celda del grid) ───
	// Posición según breakpoint + padding que separa el contenido del borde
	// de la celda (donde caen los puntos de la rejilla).
	.hp-card {
		position: relative;
		margin: 0;
		background-color: var(--primary);
		z-index: 1;
		height: 100%;
		display: flex;
		flex-direction: column;
		padding: 0.75rem;

		grid-column: var(--cd);
		grid-row: var(--rd);

		@media (max-width: 1023px) {
			grid-column: var(--ct);
			grid-row: var(--rt);
		}
		@media (max-width: 767px) {
			grid-column: var(--cm);
			grid-row: var(--rm);
		}
	}

	// ─── CTA "más resultados" (celda inferior izquierda) ───
	// Usa el circle-reveal compartido: capa base + .reveal-layer (colores invertidos).
	// --reveal-extend hace que el círculo no se corte con el borde del contenedor.
	// Tipografía heredada de .text-mono-label (estilo del Hero).
	.hp-more {
		--reveal-extend: 30px;
		position: relative;
		grid-column: 1;
		grid-row: 3;
		align-self: end;
		justify-self: start;
		padding: 0.75rem;
		text-decoration: none;
		white-space: nowrap;

		// Solo tablet/desktop
		@media (max-width: 767px) { display: none; }
	}

	// Capa reveal: clon con colores invertidos. El padding compensa el extend
	// para que el texto siga alineado con la capa base.
	.hp-more__reveal {
		display: block;
		padding: calc(0.75rem + var(--reveal-extend, 0px));
		background: var(--secondary);
		color: var(--primary);
		white-space: nowrap;
	}

	.hp-card__head {
		flex-shrink: 0;
		background-color: var(--terciary);
		padding: 0.4rem 0.6rem;
		font-size: clamp(10px, 0.8vw, 13px);
		letter-spacing: 0.08em;
		color: var(--secondary);
		text-align: center;
	}

	.hp-card__media {
		flex: 1;
		min-height: 0;
		overflow: hidden;
	}

	.hp-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		-webkit-user-drag: none;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.hp-card:hover .hp-card__img {
		transform: scale(1.04);
	}

	@media (prefers-reduced-motion: reduce) {
		.hp-card__img { transition: none; }
	}
</style>

<script>
	import '../scripts/circle-reveal.ts';
</script>
