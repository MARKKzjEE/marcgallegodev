---
import { Image } from 'astro:assets';
import imgDoko from '../assets/clients/dokostudio.png';
import imgLateua from '../assets/clients/lateua.png';
import imgLoyic from '../assets/clients/loyic.png';
import imgSociallabs from '../assets/clients/sociallabs.png';
import imgUab from '../assets/clients/uab.png';
import imgPlanit from '../assets/clients/planit.png';
import { getLang, useTranslations } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const exp = t.experience;
const jobImgs = [imgDoko, imgLateua, imgLoyic, imgSociallabs];

const isEn = lang === 'en';
const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": isEn ? "Home" : "Inicio", "item": isEn ? "https://marcgallego.com/en/" : "https://marcgallego.com/" },
		{ "@type": "ListItem", "position": 2, "name": isEn ? "Experience" : "Experiencia", "item": isEn ? "https://marcgallego.com/en/experience/" : "https://marcgallego.com/experiencia/" }
	]
};
const person = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Marc Gallego",
	"url": "https://marcgallego.com",
	"jobTitle": "Full Stack Software Engineer",
	"worksFor": { "@type": "Organization", "name": "Doko Studio" },
	"alumniOf": { "@type": "EducationalOrganization", "name": "Universitat Autònoma de Barcelona" },
	"knowsAbout": ["Laravel", "Django", "React", "Angular", "Node.js", "Docker", "CI/CD", "Astro", "TypeScript"],
	"hasCredential": {
		"@type": "EducationalOccupationalCredential",
		"name": isEn ? "BSc in Computer Science" : "Grado en Ingeniería Informática",
		"credentialCategory": "degree",
		"recognizedBy": { "@type": "EducationalOrganization", "name": "Universitat Autònoma de Barcelona" }
	}
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />

<main class="min-h-screen bg-primary pt-18">
	<div class="cv px-4 md:px-10 py-16">

		<!-- Título -->
		<div class="cv__name-row">
			<h1 class="cv__name font-nord font-normal text-secondary">{exp.pageTitle}</h1>
			<a href={exp.cvFile} download class="cv__download cv__download--mobile" aria-label={exp.downloadAriaLabel}>
				<svg class="cv__download-icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
				<span class="cv__download-label font-monoblock">PDF</span>
			</a>
		</div>

		<!-- Separador -->
		<hr class="cv__rule" />

		<!-- Resumen -->
		<section class="cv__section cv__section--summary">
			<div class="cv__summary-content">
				<h2 class="cv__heading">{exp.sections.summary}</h2>
				<p class="cv__body">{exp.summary}</p>
			</div>
			<div class="cv__summary-download">
				<a href={exp.cvFile} download class="cv__download cv__download--inline" aria-label={exp.downloadAriaLabel}>
					<svg class="cv__download-icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
					<span class="cv__download-label font-monoblock">{exp.downloadLabel}</span>
				</a>
			</div>
		</section>

		<hr class="cv__rule" />

		<!-- Experiencia -->
		<section class="cv__section">
			<h2 class="cv__heading">{exp.sections.experience}</h2>
			{exp.jobs.map((job, i) => (
				<div class="cv__entry">
					<div class="cv__entry-icon">
						<Image class="cv__entry-img" src={jobImgs[i]} alt={job.logoAlt} />
						<div class="cv__entry-line"></div>
					</div>
					<div class="cv__entry-body">
						<div class="cv__entry-header">
							<h3 class="cv__entry-title">{job.company}</h3>
							<p class="cv__entry-subtitle">{job.role}</p>
						</div>
						<div class="cv__entry-meta">
							<span class="cv__entry-date">{job.period}</span>
							<span class="cv__entry-location">{job.location}</span>
						</div>
						<div class="cv__tags">
							{job.tags.map(tag => <span class="cv__tag">{tag}</span>)}
						</div>
						<ul class="cv__list">
							{job.bullets.map(b => <li>{b}</li>)}
						</ul>
					</div>
				</div>
			))}
		</section>

		<hr class="cv__rule" />

		<!-- Educación -->
		<section class="cv__section">
			<h2 class="cv__heading">{exp.sections.education}</h2>
			{exp.education.map(edu => (
				<div class="cv__entry">
					<div class="cv__entry-icon">
						<Image class="cv__entry-img" src={imgUab} alt={edu.logoAlt} />
					</div>
					<div class="cv__entry-body">
						<div class="cv__entry-header">
							<h3 class="cv__entry-title">{edu.title}</h3>
							<p class="cv__entry-subtitle">{edu.subtitle}</p>
						</div>
						<div class="cv__entry-meta">
							<span class="cv__entry-date">{edu.period}</span>
							<span class="cv__entry-location">{edu.location}</span>
						</div>
					</div>
				</div>
			))}
		</section>

		<hr class="cv__rule" />

		<!-- Idiomas -->
		<section class="cv__section">
			<h2 class="cv__heading">{exp.sections.languages}</h2>
			<div class="cv__tags">
				{exp.languages.map(l => <span class="cv__tag">{l}</span>)}
			</div>
		</section>

		<hr class="cv__rule" />

		<!-- Extracurricular -->
		<section class="cv__section">
			<h2 class="cv__heading">{exp.sections.extracurricular}</h2>
			{exp.extracurricular.map(item => (
				<div class="cv__entry">
					<div class="cv__entry-icon">
						<Image class="cv__entry-img" src={imgPlanit} alt={item.logoAlt} />
						<div class="cv__entry-line"></div>
					</div>
					<div class="cv__entry-body">
						<div class="cv__entry-header">
							<h3 class="cv__entry-title">{item.company}</h3>
							<p class="cv__entry-subtitle">{item.role}</p>
						</div>
						<div class="cv__entry-meta">
							<span class="cv__entry-date">{item.period}</span>
							<span class="cv__entry-location">{item.location}</span>
						</div>
						<ul class="cv__list">
							{item.bullets.map(b => <li>{b}</li>)}
						</ul>
					</div>
				</div>
			))}
		</section>

	</div>
</main>

<style lang="scss">
	.cv {
		color: var(--secondary);
	}

	// ── Name row ──
	.cv__name-row {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.cv__name {
		font-size: clamp(35px, 8vw, 80px);
		line-height: 1;
	}

	.cv__download {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		color: var(--secondary);
		text-decoration: none;
		transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
		&:hover {
			transform: scale(1.1);
		}
	}

	.cv__download-icon {
		width: 32px;
		height: 32px;
	}

	.cv__download-label {
		font-size: clamp(11px, 1.1vw, 14px);
	}

	// ── Horizontal rule ──
	.cv__rule {
		border: none;
		border-top: 1px solid var(--secondary);
		margin: 0;
	}

	// ── Section ──
	.cv__section {
		padding: 24px 0;
	}

	.cv__section--summary {
		@media (min-width: 768px) {
			display: flex;
			flex-direction: row;
			gap: 64px;
			align-items: center;
		}
	}

	.cv__summary-content {
		@media (min-width: 768px) {
			flex: 3;
		}
	}

	.cv__summary-download {
		display: none;

		@media (min-width: 768px) {
			flex: 1;
			display: flex;
			justify-content: flex-end;
			align-items: center;
		}
	}

	.cv__download--mobile {
		position: absolute;
		right: 0;
		top: 0;
		height: 100%;
		justify-content: flex-end;

		@media (min-width: 768px) {
			display: none;
		}

		@media (max-width: 767px) {
			position: fixed;
			right: 1.5rem;
			bottom: 1.5rem;
			top: auto;
			height: 72px;
			width: 72px;
			background-color: color-mix(in srgb, var(--secondary) 10%, transparent);
			backdrop-filter: blur(20px) saturate(180%);
			-webkit-backdrop-filter: blur(20px) saturate(180%);
			border: 1px solid color-mix(in srgb, var(--secondary) 20%, transparent);
			border-radius: 50%;
			justify-content: center;
			z-index: 30;
			box-shadow: 0 4px 24px color-mix(in srgb, var(--secondary) 10%, transparent);

			.cv__download-icon {
				width: 26px;
				height: 26px;
			}

			.cv__download-label {
				display: none;
			}
		}

		.cv__download-label {
			display: block;
			font-size: 9px;
		}
	}

	.cv__download--inline {
		position: static;
		gap: 10px;
	}

	.cv__heading {
		font-family: var(--font-monoblock);
		font-weight: 500;
		font-size: clamp(14px, 1.4vw, 18px);
		letter-spacing: 0.05em;
		color: var(--secondary);
		margin-bottom: 20px;
	}

	// ── Body text ──
	.cv__body {
		font-family: var(--font-cottor);
		font-size: clamp(13px, 1vw, 15px);
		font-weight: 300;
		line-height: 1.5;
		letter-spacing: 1px;
		color: var(--secondary);
		opacity: 0.8;
	}

	// ── Entry (job / education) ──
	.cv__entry {
		display: flex;
		gap: 20px;

		& + .cv__entry {
			margin-top: 28px;
		}

		@media (max-width: 767px) {
			gap: 12px;
		}
	}

	// ── Icon column (image + line) ──
	.cv__entry-icon {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex-shrink: 0;
	}

	.cv__entry-img {
		width: 64px;
		height: 64px;
		border-radius: 4px;
		border: 1px solid var(--quaternary);
		flex-shrink: 0;
		object-fit: contain;

		@media (max-width: 767px) {
			width: 48px;
			height: 48px;
		}
	}

	.cv__entry-line {
		width: 1px;
		flex: 1;
		background-color: color-mix(in srgb, var(--secondary) 25%, transparent);
		margin-top: 8px;
	}

	// ── Entry body ──
	.cv__entry-body {
		flex: 1;
		min-width: 0;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0 16px;

		@media (max-width: 600px) {
			grid-template-columns: 1fr;
		}
	}

	.cv__entry-header {
		margin-bottom: 8px;
	}

	.cv__entry-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		grid-row: 1;
		grid-column: 2;

		@media (max-width: 600px) {
			grid-column: 1;
			grid-row: auto;
			order: 10;
			align-items: flex-end;
			margin-top: 12px;
		}
	}

	.cv__tags {
		grid-column: 1 / -1;
	}

	.cv__list {
		grid-column: 1 / -1;
	}

	.cv__entry-title {
		font-family: var(--font-cottor);
		font-weight: 500;
		font-size: clamp(13px, 1.3vw, 16px);
		letter-spacing: 0.05em;
		margin-bottom: 4px;
		color: var(--secondary);
	}

	.cv__entry-subtitle {
		font-family: var(--font-monoblock);
		font-weight: 400;
		font-size: clamp(11px, 1.1vw, 14px);
		letter-spacing: 0.05em;
		color: var(--secondary);
		opacity: 0.8;
	}

	// ── Tech tags ──
	.cv__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 8px;
		margin-bottom: 16px;
	}

	.cv__tag {
		font-family: var(--font-monoblock);
		font-weight: 400;
		font-size: 10px;
		letter-spacing: 0.05em;
		padding: 3px 10px;
		border-radius: 4px;
		background-color: var(--terciary);
		color: var(--secondary);
		border: 1px solid var(--quaternary);
	}

	.cv__entry-date {
		font-family: var(--font-monoblock);
		font-weight: 400;
		font-size: clamp(11px, 1.1vw, 14px);
		letter-spacing: 0.05em;
		color: var(--secondary);
	}

	.cv__entry-location {
		font-family: var(--font-monoblock);
		font-weight: 400;
		font-size: clamp(11px, 1.1vw, 14px);
		letter-spacing: 0.05em;
		color: var(--secondary);
		opacity: 0.7;
	}

	// ── Bullet list ──
	.cv__list {
		list-style: disc;
		padding-left: 20px;
		margin: 0;

		li {
			font-family: var(--font-cottor);
			font-size: 0.875rem;
			font-weight: 300;
			line-height: 1.5;
			letter-spacing: 1px;
			color: var(--secondary);
			opacity: 0.8;
			padding: 1px 0;
		}
	}
</style>
