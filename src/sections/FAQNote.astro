---
import { getImage } from 'astro:assets';
import { getLang, useTranslations } from '../i18n/index';
import paperBgSrc from '../assets/white-crumpled-paper-texture-background.jpg';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const faqs = t.faq.items;

// La textura de papel va como background-image (CSS), así que getImage() la
// optimiza a WebP comprimido en el build (la hoja máx es 640px → 1000px sobra).
const paperBg = await getImage({
	src: paperBgSrc,
	format: 'webp',
	width: 1000,
	quality: 72,
});

// Rotaciones sutiles e irregulares por pregunta (look "escrito a mano").
const tilts = [-0.6, 0.4, -0.3, 0.7, -0.5];
---

<!--
  FAQ "hoja de apuntes": una hoja de papel vertical escrita a bolígrafo
  (Reenie Beanie). Cada pregunta es un <details>: la primera viene abierta y
  solo hay una abierta a la vez. Al abrir, el círculo del número se dibuja y
  la respuesta se escribe línea a línea, como tinta saliendo del boli; al
  cerrar se borra rápido. Sin JS o con reduced motion, abre y cierra sin más.
-->
<section id="faq" class="faq-note" aria-labelledby="faq-note-heading">
	<div class="faq-note__sheet" style={`--paper-url: url(${paperBg.src});`}>

		<!-- Título con subrayado ondulado a mano -->
		<header class="faq-note__head">
			<h2 id="faq-note-heading" class="faq-note__heading">{t.faq.heading}</h2>
			<svg class="faq-note__underline" viewBox="0 0 300 12" fill="none" aria-hidden="true" preserveAspectRatio="none">
				<path d="M2 7 C 40 2, 70 11, 110 6 S 180 2, 220 7 S 280 10, 298 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
			</svg>
			<!-- Garabato esquina (asterisco/estrella a boli) -->
			<svg class="faq-note__doodle-star" viewBox="0 0 40 40" fill="none" aria-hidden="true">
				<path d="M20 4 L20 36 M6 12 L34 28 M34 12 L6 28" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
			</svg>
		</header>

		<ol class="faq-note__list">
			{faqs.map((faq, i) => (
				<li class="faq-note__item" style={`--tilt:${tilts[i] ?? 0}deg;`}>
					<details class="faq-note__details" open={i === 0} data-faq-item>
						<summary class="faq-note__summary">
							<span class="faq-note__row">
								<!-- Número: el círculo a mano se dibuja cuando la pregunta está abierta -->
								<span class="faq-note__num" aria-hidden="true">
									<span class="faq-note__num-text">{i + 1}</span>
									<svg class="faq-note__num-ring" viewBox="0 0 48 48" fill="none">
										<path pathLength="1" d="M24 4 C 38 5, 45 16, 44 26 C 43 38, 30 45, 19 43 C 7 41, 3 28, 6 18 C 8 9, 16 4, 26 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
									</svg>
								</span>
								<span class="faq-note__question">
									{faq.question}
									<!-- Subrayado a mano al pasar el ratón (pregunta cerrada) -->
									<svg class="faq-note__question-line" viewBox="0 0 300 12" fill="none" aria-hidden="true" preserveAspectRatio="none">
										<path pathLength="1" d="M2 7 C 40 2, 70 11, 110 6 S 180 2, 220 7 S 280 10, 298 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
									</svg>
								</span>
							</span>
						</summary>
						<div class="faq-note__body" data-faq-body>
							<!-- Cada palabra en su span: el script las "escribe" una tras otra -->
							<p class="faq-note__answer" data-faq-answer>
								<span class="faq-note__word faq-note__arrow" aria-hidden="true">→</span>{' '}
								{faq.answer.split(' ').map((word) => (
									<><span class="faq-note__word">{word}</span>{' '}</>
								))}
							</p>
						</div>
					</details>
				</li>
			))}
		</ol>

		<!-- Firma/nota al pie, estilo "courtesy" de la referencia -->
		<p class="faq-note__sign" aria-hidden="true">{t.faq.signature}</p>
	</div>
</section>

<style lang="scss">
	// ─── Sección: la hoja va centrada sobre el fondo del tema ───
	.faq-note {
		// Tinta única (azul BIC vivo) al 100% en todo. La jerarquía de "peso" se
		// logra con un text-stroke sutil en títulos y numeración, no con color.
		--ink: #2b3fd4;
		--ink-soft: color-mix(in srgb, var(--ink) 75%, transparent);
		--paper: #f4f1e9;
		// Overlay sobre el papel: transparente en claro, oscuro en dark.
		--paper-overlay: transparent;

		display: flex;
		justify-content: center;
		// Separación superior como el resto (pt-20 móvil / pt-30 desktop); el
		// lateral mantiene el margen y un pb para que la hoja no toque el footer.
		padding: 5rem 1rem 5rem;

		@media (min-width: 768px) {
			padding: 7.5rem 2.5rem 7.5rem;
		}
	}

	// Dark: papel oscurecido (overlay) + tinta azul clara para contrastar.
	:global(.dark) .faq-note {
		--ink: #aeb6e8;
		--ink-soft: color-mix(in srgb, var(--ink) 75%, transparent);
		--paper-overlay: rgba(20, 22, 34, 0.82);
	}

	// ─── La hoja de papel (vertical, tipo folio) ───
	.faq-note__sheet {
		position: relative;
		width: 100%;
		max-width: 640px;
		// Proporción folio (no forzamos alto fijo: el contenido manda, pero
		// reservamos un mínimo para que parezca una hoja aunque haya poco texto).
		min-height: calc(640px * 1.414);   // A-series ~1:1.414
		background-color: var(--paper);
		background-image: var(--paper-url);
		// Tamaño fijo (el de la imagen, 1000×1371) anclado arriba: con `cover` la
		// textura se reescalaba al abrir o cerrar cada pregunta y hacía zoom. Así
		// solo crece la hoja (máx. ~1030px de alto) y el papel se queda quieto.
		background-size: 1000px auto;
		background-position: top center;
		background-repeat: no-repeat;
		color: var(--ink);
		padding: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
		// Sombra suave + rotación mínima → hoja apoyada sobre la mesa.
		box-shadow: 0 18px 50px -20px rgba(0, 0, 0, 0.45);
		transform: rotate(-0.8deg);

		// Overlay sobre el papel (oscurece en dark, transparente en claro).
		// Va por encima de la textura pero por debajo del contenido.
		&::before {
			content: "";
			position: absolute;
			inset: 0;
			z-index: 0;
			pointer-events: none;
			background-color: var(--paper-overlay);
		}
	}

	// El contenido de la hoja por encima del overlay.
	.faq-note__head,
	.faq-note__list,
	.faq-note__sign {
		position: relative;
		z-index: 1;
	}

	// ─── Título manuscrito + subrayado ondulado ───
	.faq-note__head {
		position: relative;
		margin-bottom: 2.5rem;
	}

	.faq-note__heading {
		font-family: var(--font-reenie);
		font-weight: 400;
		color: var(--ink);
		// Stroke sutil → da "peso" al título sin cambiar de color.
		-webkit-text-stroke: 0.6px var(--ink);
		font-size: clamp(44px, 9vw, 76px);
		line-height: 0.95;
		margin: 0;
	}

	.faq-note__underline {
		display: block;
		width: min(70%, 320px);
		height: 12px;
		margin-top: 0.2rem;
		color: var(--ink);
	}

	.faq-note__doodle-star {
		position: absolute;
		top: -0.5rem;
		right: 0;
		width: 34px;
		height: 34px;
		color: var(--ink-soft);
		transform: rotate(12deg);
	}

	// ─── Lista de preguntas numeradas ───
	.faq-note__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		// Tamaño del número con su círculo; la respuesta se sangra con este ancho
		--num-box: 56px;
		--num-font: 44px;
	}

	.faq-note__item {
		// Cada apunte ligeramente torcido (look manuscrito irregular).
		transform: rotate(var(--tilt, 0deg));
	}

	// ─── Pregunta (summary): número + texto ───
	.faq-note__summary {
		list-style: none;
		cursor: pointer;
		&::-webkit-details-marker { display: none; }

		// Foco de teclado: recuadro a boli discontinuo
		&:focus-visible {
			outline: 2px dashed var(--ink);
			outline-offset: 4px;
		}
	}

	.faq-note__row {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	// Número con círculo dibujado a mano alrededor
	.faq-note__num {
		position: relative;
		flex-shrink: 0;
		width: var(--num-box);
		height: var(--num-box);
		display: grid;
		place-items: center;
	}

	.faq-note__num-text {
		font-family: var(--font-reenie);
		font-size: var(--num-font);
		line-height: 1;
		color: var(--ink);
		// Stroke sutil → mismo peso que el título.
		-webkit-text-stroke: 0.6px var(--ink);
	}

	.faq-note__num-ring {
		position: absolute;
		inset: -2px;
		width: calc(100% + 4px);
		height: calc(100% + 4px);
		color: var(--ink);
	}

	// Trazos que se dibujan (círculo y subrayado): pathLength="1" → dasharray 1.
	// Oculto: se desvanece y, ya invisible, se rebobina para el siguiente trazo.
	.faq-note__num-ring path,
	.faq-note__question-line path {
		stroke-dasharray: 1 1;
		stroke-dashoffset: 1;
		opacity: 0;
		transition: opacity 200ms ease, stroke-dashoffset 0s 200ms;
	}

	// Abierta (y no cerrándose): el círculo se traza alrededor del número
	.faq-note__details[open]:not(.is-closing) .faq-note__num-ring path {
		stroke-dashoffset: 0;
		opacity: 1;
		transition: stroke-dashoffset 450ms cubic-bezier(0.22, 1, 0.36, 1), opacity 0s;
	}

	// Pregunta: mayúsculas, más cuerpo
	.faq-note__question {
		position: relative;
		font-family: var(--font-reenie);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(24px, 3.2vw, 34px);
		line-height: 1.05;
		color: var(--ink);
		// Stroke sutil → mismo peso que título y numeración (jerarquía sobre respuesta).
		-webkit-text-stroke: 0.6px var(--ink);
		padding-top: 0.3rem;
	}

	.faq-note__question-line {
		position: absolute;
		left: 0;
		bottom: -0.35rem;
		width: 100%;
		height: 8px;
		color: var(--ink-soft);
		pointer-events: none;
	}

	// Pregunta cerrada + ratón encima: se subraya a mano (invita a abrirla)
	@media (hover: hover) {
		.faq-note__details:not([open]) .faq-note__summary:hover .faq-note__question-line path {
			stroke-dashoffset: 0;
			opacity: 1;
			transition: stroke-dashoffset 400ms cubic-bezier(0.22, 1, 0.36, 1), opacity 0s;
		}
	}

	// ─── Respuesta ───
	// Va sangrada bajo la pregunta (ancho del número + gap). Color vivo (--ink):
	// es el contenido que destaca sobre la estructura.
	.faq-note__answer {
		position: relative;   // referencia de offsetLeft/offsetTop de cada palabra (script)
		font-family: var(--font-reenie);
		font-weight: 400;
		font-size: clamp(22px, 2.6vw, 29px);
		line-height: 1.2;
		color: var(--ink);
		margin: 0;
		padding: 0.4rem 0 0 calc(var(--num-box) + 1rem);
		max-width: calc(52ch + var(--num-box) + 1rem);
	}

	// inline-block → cada palabra se puede recortar (clip-path) al escribirse
	.faq-note__word {
		display: inline-block;
	}

	.faq-note__arrow {
		margin-right: 0.3rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-note__num-ring path,
		.faq-note__question-line path,
		.faq-note__details[open]:not(.is-closing) .faq-note__num-ring path {
			transition: none;
		}
	}

	// ─── Firma al pie ───
	.faq-note__sign {
		font-family: var(--font-reenie);
		font-size: clamp(18px, 2.2vw, 23px);
		color: var(--ink);
		text-align: right;
		margin: 2.5rem 0 0;
		transform: rotate(-1.2deg);
	}

	// ─── Móvil: la hoja respira ───
	// El alto fijo deja un vacío enorme y el contenido se aprieta; aquí el
	// contenido manda, se da más aire y se anula la rotación (que cortaba la hoja).
	@media (max-width: 767px) {
		// pt-20 móvil (5rem) + margen lateral y pb para que la hoja respire.
		.faq-note {
			padding: 5rem 1rem;
		}

		.faq-note__sheet {
			min-height: 0;                // crece con el contenido, sin vacío
			padding: 2.75rem 1.75rem;     // más margen interno proporcional
			transform: none;              // sin rotación → no se corta por los lados
		}

		.faq-note__head {
			margin-bottom: 2rem;
		}

		.faq-note__heading {
			font-size: clamp(52px, 16vw, 72px);   // título con más presencia
		}

		.faq-note__list {
			gap: 1.75rem;                 // algo más de aire entre apuntes
			--num-box: 48px;
			--num-font: 38px;
		}

		// Número al lado de la pregunta (plegadas ocupan poco) y respuesta a todo el ancho.
		.faq-note__item {
			transform: none;              // sin tilt → más legible y sin desborde
		}

		.faq-note__row {
			gap: 0.75rem;
		}

		.faq-note__question {
			font-size: clamp(26px, 7vw, 32px);
		}

		.faq-note__answer {
			font-size: clamp(23px, 5.6vw, 29px);
			line-height: 1.25;
			padding-left: 0;
			max-width: none;              // el texto se estira a todo el ancho
		}
	}
</style>

<script>
	// ─── Acordeón "a boli" ───
	// Solo una pregunta abierta a la vez. Abrir: el alto se despliega, el círculo
	// se dibuja (CSS) y la respuesta se escribe palabra a palabra, línea a línea.
	// Cerrar: la respuesta se borra rápido y el alto se recoge; `open` se quita
	// al final (.is-closing hace que el círculo se vaya ya al empezar).
	const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
	const OPEN_MS = 500;
	const CLOSE_MS = 320;
	const FADE_MS = 180;     // la tinta se borra antes de que acabe de recogerse
	const LINE_MS = 240;     // lo que tarda el boli en escribir una línea entera
	const WRITE_DELAY = 100; // empieza a escribir con el círculo a medio trazar

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]')];

	const parts = (d: HTMLDetailsElement) => ({
		body: d.querySelector<HTMLElement>('[data-faq-body]')!,
		answer: d.querySelector<HTMLElement>('[data-faq-answer]')!,
	});

	// Cada palabra se destapa de izquierda a derecha (clip-path). Su retardo sale
	// de su línea y de su posición en ella → un trazo continuo, como un boli.
	function write(answer: HTMLElement) {
		const words = [...answer.querySelectorAll<HTMLElement>('.faq-note__word')];
		const width = answer.clientWidth || 1;
		let line = -1;
		let lineTop = -Infinity;
		words.forEach((word) => {
			if (word.offsetTop > lineTop + word.offsetHeight / 2) {
				line++;
				lineTop = word.offsetTop;
			}
			const start = word.offsetLeft / width;
			const span = word.offsetWidth / width;
			// Margen negativo arriba, abajo y a la derecha: los rabitos de la letra
			// manuscrita no se cortan. A la izquierda 0, o asomaría tinta antes de tiempo.
			word.animate(
				[{ clipPath: 'inset(-0.3em 100% -0.3em 0)' }, { clipPath: 'inset(-0.3em -0.3em -0.3em 0)' }],
				{ delay: WRITE_DELAY + (line + start) * LINE_MS, duration: Math.max(1, span * LINE_MS), easing: 'linear', fill: 'backwards' },
			);
		});
	}

	function open(d: HTMLDetailsElement) {
		d.open = true;
		if (reduceMotion) return;
		const { body, answer } = parts(d);
		d.dataset.busy = 'true';
		body.style.overflow = 'hidden';
		const anim = body.animate([{ height: '0px' }, { height: `${body.scrollHeight}px` }], { duration: OPEN_MS, easing: EASE });
		write(answer);
		anim.onfinish = () => {
			body.style.overflow = '';
			delete d.dataset.busy;
		};
	}

	function close(d: HTMLDetailsElement) {
		if (reduceMotion) {
			d.open = false;
			return;
		}
		const { body, answer } = parts(d);
		// Si aún se estaba abriendo/escribiendo, se corta ahí
		d.getAnimations({ subtree: true }).forEach((a) => a.cancel());
		d.dataset.busy = 'true';
		d.classList.add('is-closing');
		body.style.overflow = 'hidden';
		const fade = answer.animate([{ opacity: 1 }, { opacity: 0 }], { duration: FADE_MS, easing: 'ease-out', fill: 'forwards' });
		const anim = body.animate([{ height: `${body.offsetHeight}px` }, { height: '0px' }], { duration: CLOSE_MS, easing: EASE });
		anim.onfinish = () => {
			d.open = false;
			d.classList.remove('is-closing');
			body.style.overflow = '';
			fade.cancel();
			delete d.dataset.busy;
		};
	}

	items.forEach((d) => {
		d.querySelector('summary')?.addEventListener('click', (e) => {
			e.preventDefault();
			if (d.dataset.busy) return;
			if (d.open) {
				close(d);
				return;
			}
			items.filter((other) => other !== d && other.open && !other.classList.contains('is-closing')).forEach(close);
			open(d);
		});
	});
</script>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqs.map(faq => ({
		"@type": "Question",
		"name": faq.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": faq.answer
		}
	}))
})} />
