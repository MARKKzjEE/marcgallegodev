---
import { getLang, useTranslations, getLocalePath, getAlternatePath } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const navItems = [
	{ label: t.header.experience, href: getLocalePath(lang, '/experience') },
	{ label: t.header.projects, href: getLocalePath(lang, '/projects') },
	{ label: t.header.contact, href: getLocalePath(lang, '/contact') },
];

const homePath = lang === 'en' ? '/en' : '/';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const { esHref, enHref } = getAlternatePath(pathname);
---

<header class="site-header-v2 font-nord font-medium text-sm" data-site-header-v2>

	<!-- ─── Desktop toolbar (2 filas × 6 cols) ─── -->
	<div class="toolbar hidden md:block" aria-label="Cabecera">
		<div class="toolbar-grid">

			<!-- Logo M — col 1, filas 1-2 -->
			<a href={homePath} class="cell" style="grid-column:1; grid-row:1/3;" aria-label="Inicio">
				<svg width="22" height="24" viewBox="0 0 521 557" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path d="M132.499 548.5V41.3049H196.552V548.5H324.554V41.3049H388.501V548.5H516.5V0.500017H4.5V548.5H132.499Z" fill="currentColor"/>
				</svg>
			</a>

			<!-- Espacio vacío — col 2, filas 1-2 -->
			<div class="cell" style="grid-column:2; grid-row:1/3;"></div>

			<!-- Nav — col 3, filas 1-2 -->
			<nav class="cell nav-group" style="grid-column:3; grid-row:1/3;" aria-label="Navegación principal">
				{navItems.map((item) => {
					const isActive = Astro.url.pathname.startsWith(item.href);
					return (
						<a href={item.href} class={`nav-link${isActive ? ' is-active' : ''}`} aria-current={isActive ? 'page' : undefined}>
							{item.label}
						</a>
					);
				})}
			</nav>

			<!-- ES — col 4, fila 1 -->
			<a href={esHref} class={`cell lang-cell${lang === 'es' ? ' lang-active' : ''}`} style="grid-column:4; grid-row:1;" aria-label="Español"><span>ES</span></a>
			<!-- EN — col 4, fila 2 -->
			<a href={enHref} class={`cell lang-cell${lang === 'en' ? ' lang-active' : ''}`} style="grid-column:4; grid-row:2;" aria-label="English"><span>EN</span></a>

			<!-- Toggle tema — col 5, filas 1-2 -->
			<div class="cell theme-cell" style="grid-column:5; grid-row:1/3;">
				<label id="theme-toggle-v2" aria-label="Cambiar tema" class="cursor-pointer flex items-center justify-center w-full h-full">
					<input type="checkbox" class="sr-only" data-theme-checkbox>
					<!-- Sol: visible en modo claro -->
					<svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M6 11H1V13H6V11Z" fill="currentColor"/>
						<path d="M4 5H3V4H4V3H5V4H6V5H7V6H8V7H7V8H6V7H5V6H4V5Z" fill="currentColor"/>
						<path d="M7 17H8V18H7V19H6V20H5V21H4V20H3V19H4V18H5V17H6V16H7V17Z" fill="currentColor"/>
						<path d="M13 18H11V23H13V18Z" fill="currentColor"/>
						<path d="M13 1H11V6H13V1Z" fill="currentColor"/>
						<path d="M20 19H21V20H20V21H19V20H18V19H17V18H16V17H17V16H18V17H19V18H20V19Z" fill="currentColor"/>
						<path d="M23 11H18V13H23V11Z" fill="currentColor"/>
						<path d="M17 7H16V6H17V5H18V4H19V3H20V4H21V5H20V6H19V7H18V8H17V7Z" fill="currentColor"/>
						<path d="M16 16H14V17H10V16H8V14H7V10H8V8H10V7H14V8H16V10H17V14H16V16Z" fill="currentColor"/>
					</svg>
					<!-- Luna: visible en modo oscuro -->
					<svg class="theme-icon theme-icon--moon" width="13" height="18" viewBox="0 0 16 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M13 20H16V21H14V22H8V21H6V20H4V19H3V18H2V16H1V14H0V8H1V6H2V4H3V3H4V2H6V1H8V0H14V1H16V2H13V3H11V4H9V5H8V7H7V9H6V13H7V15H8V17H9V18H11V19H13V20Z" fill="currentColor"/>
					</svg>
				</label>
			</div>

			<!-- Info fila 1 — col 6, fila 1 -->
			<div class="cell info-cell" style="grid-column:6; grid-row:1; gap:0.4rem;">
				<svg width="8" height="8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0;">
					<path d="M23 8V14H22V16H21V17H20V18H18V19H15V20H9V19H7V20H6V21H1V19H2V18H3V16H2V14H1V8H2V6H3V5H4V4H6V3H9V2H15V3H18V4H20V5H21V6H22V8H23Z" fill="currentColor"/>
				</svg>
				<span class="text-[10px]">{lang === 'en' ? "Let's talk on LinkedIn" : 'Hablemos por LinkedIn'}</span>
			</div>
			<!-- Info fila 2 — col 6, fila 2 -->
			<div class="cell info-cell" style="grid-column:6; grid-row:2; gap:0.4rem;">
				<svg width="8" height="8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="status-dot-svg" style="flex-shrink:0; color:#22c55e; fill:#22c55e;">
					<path d="M21.6 21.6H16.8V24H7.2V21.6H2.4V16.8H0V7.2H2.4V2.4H7.2V0H16.8V2.4H21.6V7.2H24V16.8H21.6V21.6Z" fill="currentColor"/>
				</svg>
				<span class="text-[10px]">{lang === 'en' ? 'Available for projects' : 'Disponible para proyectos'}</span>
			</div>

		</div>
	</div>

	<!-- ─── Mobile bar ─── -->
	<div class="mobile-bar flex md:hidden items-center justify-between h-14 px-4">
		<a href={homePath} class="flex items-center" aria-label="Inicio">
			<svg width="18" height="20" viewBox="0 0 521 557" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<path d="M132.499 548.5V41.3049H196.552V548.5H324.554V41.3049H388.501V548.5H516.5V0.500017H4.5V548.5H132.499Z" fill="currentColor"/>
			</svg>
		</a>
		<button type="button" class="hamburger-btn" aria-label={t.header.mobileMenuOpen} aria-expanded="false" aria-controls="mobile-menu-v2" data-hamburger-v2>
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/>
			</svg>
		</button>
	</div>

	<!-- ─── Mobile overlay ─── -->
	<div id="mobile-menu-v2" class="mobile-overlay font-nord" aria-hidden="true" data-mobile-menu-v2>
		<button type="button" class="mobile-close-btn" aria-label={t.header.mobileMenuClose} data-menu-close-v2>
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M18 6 6 18"/><path d="m6 6 12 12"/>
			</svg>
		</button>
		<nav class="mobile-nav" aria-label="Navegación móvil">
			{navItems.map((item) => {
				const isActive = Astro.url.pathname.startsWith(item.href);
				return (
					<a href={item.href} class={`mobile-nav-link${isActive ? ' is-active' : ''}`} aria-current={isActive ? 'page' : undefined}>
						{item.label}
					</a>
				);
			})}
		</nav>
		<div class="mobile-controls">
			<div class="flex items-center gap-2">
				<a href={esHref} class={`lang-btn${lang === 'es' ? ' lang-active' : ''}`}>ES</a>
				<span class="opacity-50">/</span>
				<a href={enHref} class={`lang-btn${lang === 'en' ? ' lang-active' : ''}`}>EN</a>
			</div>
			<button type="button" class="theme-text-btn" data-theme-mobile-v2>
				<span data-theme-label-v2>Modo noche</span>
			</button>
		</div>
	</div>

</header>

<style lang="scss">
  .site-header-v2 {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 40;
    background-color: var(--primary);
    color: var(--secondary);
    border-bottom: 1px solid var(--secondary);
  }

  // ─── Toolbar grid ───
  .toolbar {
    width: 100%;
  }

  .toolbar-grid {
    display: grid;
    grid-template-columns: auto 1fr auto auto auto auto;
    grid-template-rows: 28px 28px;
    width: 100%;
  }

  .cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.25rem;
    color: var(--secondary);
    border-left: 1px solid var(--secondary);
    border-bottom: 1px solid var(--secondary);
    white-space: nowrap;

    // col 1 (logo) sin border-left
    &[style*="grid-column:1"] { border-left: none; }
    // celdas en fila 2 sin border-bottom
    &[style*="grid-row:2"] { border-bottom: none; }
    // celdas que abarcan 2 filas sin border-bottom
    &[style*="grid-row:1/3"] { border-bottom: none; }
  }

  // ─── Nav (2 filas, links internos) ───
  .nav-group {
    display: flex;
    align-items: stretch;
    padding: 0;

    .nav-link {
      display: flex;
      align-items: center;
      padding: 0 1.75rem;
      position: relative;

      &::before {
        content: '';
        position: absolute;
        left: calc(1.75rem - 19px);
        top: 50%;
        transform: translateY(-50%) translateX(-6px);
        opacity: 0;
        width: 11px;
        height: 11px;
        background-color: currentColor;
        mask-image: url("data:image/svg+xml,%3Csvg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M7 19V17H8V16H9V15H10V14H11V13H12V11H11V10H10V9H9V8H8V7H7V5H8V4H10V5H11V6H12V7H13V8H14V9H15V10H16V11H17V13H16V14H15V15H14V16H13V17H12V18H11V19H10V20H8V19H7Z' fill='black'/%3E%3C/svg%3E");
        mask-size: contain;
        mask-repeat: no-repeat;
        mask-position: center;
        transition: opacity 300ms cubic-bezier(0.22, 1, 0.36, 1),
                    transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      &:hover::before, &.is-active::before {
        opacity: 1;
        transform: translateY(-50%) translateX(0);
      }
    }
  }

  // ─── Lang cells ───
  .lang-cell {
    padding: 0;
    width: 3rem;
    font-size: 0.75rem;
    cursor: pointer;
  }

  // ─── Theme ───
  .theme-cell { padding: 0 1rem; cursor: pointer; }

  .theme-icon--moon { display: none; }
  :global(.dark) .theme-icon--moon { display: block; }
  :global(.dark) .theme-icon--sun  { display: none; }

  // ─── Efecto cortina (lang + theme) ───
  .lang-cell, .theme-cell {
    position: relative;
    overflow: hidden;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background-color: var(--secondary);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;
    }

    > span, > label {
      position: relative;
      z-index: 1;
    }

    &:hover::before { transform: scaleX(1); }
    &:hover > span,
    &:hover > label { color: var(--primary); }
  }

  // ─── Status dot ───
  .status-dot-svg {
    animation: status-pulse 2s ease-in-out infinite;
    @media (prefers-reduced-motion: reduce) { animation: none; }
  }

  @keyframes status-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  // ─── Info cells ───
  .info-cell {
    padding: 0 1.25rem;
    min-width: 160px;
    justify-content: flex-start;
  }

  // ─── Mobile ───
  .mobile-bar {
    color: var(--secondary);
  }

  .hamburger-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    display: flex;
    padding: 4px;
    transition: opacity 200ms;
    &:hover { opacity: 0.6; }
  }

  .mobile-overlay {
    position: fixed;
    inset: 0;
    background-color: var(--primary);
    display: flex;
    flex-direction: column;
    padding: 2rem;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 800ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 50;
    &.is-open { clip-path: inset(0 0 0% 0); pointer-events: all; }
  }

  .mobile-close-btn {
    position: absolute;
    top: 1rem; right: 1rem;
    background: none; border: none;
    cursor: pointer;
    color: var(--secondary);
    padding: 4px;
    display: flex;
    transition: opacity 200ms;
    &:hover { opacity: 0.6; }
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex: 1;
  }

  .mobile-nav-link {
    font-size: clamp(28px, 7vw, 44px);
    font-weight: 300;
    color: var(--secondary);
    position: relative;
    transition: opacity 200ms;
    &::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      bottom: -4px;
      height: 2px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    &:hover { opacity: 0.7; }
    &:hover::after, &.is-active::after { transform: scaleX(1); }
  }

  .mobile-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.5rem;
  }

  .lang-btn {
    opacity: 0.5;
    color: var(--secondary);
    cursor: pointer;
    transition: opacity 200ms;
    &:hover { opacity: 0.75; }
    &.lang-active { opacity: 1; }
  }

  .theme-text-btn {
    background-color: var(--secondary);
    color: var(--primary);
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 8px 16px;
    border-radius: 8px;
    transition: opacity 200ms;
    span { display: inline-block; width: 100px; }
  }
</style>

<script>
	function updateThemeLabel() {
		const label = document.querySelector<HTMLElement>('[data-theme-label-v2]');
		if (label) label.textContent = document.documentElement.classList.contains('dark') ? 'Modo día' : 'Modo noche';
	}

	// ─── Theme toggle ───
	const checkbox = document.querySelector<HTMLInputElement>('[data-theme-checkbox]');
	if (checkbox) {
		checkbox.checked = document.documentElement.classList.contains('dark');
		checkbox.addEventListener('change', () => {
			const dark = checkbox.checked;
			document.documentElement.classList.toggle('dark', dark);
			localStorage.setItem('theme', dark ? 'dark' : 'light');
			updateThemeLabel();
		});
	}

	// ─── Mobile menu ───
	const hamburger = document.querySelector<HTMLButtonElement>('[data-hamburger-v2]');
	const menu = document.querySelector<HTMLElement>('[data-mobile-menu-v2]');
	const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close-v2]');

	function openMenu() {
		menu!.classList.add('is-open');
		menu!.removeAttribute('aria-hidden');
		hamburger!.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		menu!.classList.remove('is-open');
		menu!.setAttribute('aria-hidden', 'true');
		hamburger!.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}

	if (hamburger && menu && closeBtn) {
		hamburger.addEventListener('click', openMenu);
		closeBtn.addEventListener('click', closeMenu);

		menu.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link').forEach(link => {
			link.addEventListener('click', (e) => {
				const href = link.getAttribute('href');
				if (!href) return;
				e.preventDefault();
				closeMenu();
				setTimeout(() => { window.location.href = href; }, 600);
			});
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && menu!.classList.contains('is-open')) closeMenu();
		});

		// Mobile theme — reutiliza updateThemeLabel ya que apunta al mismo selector
		updateThemeLabel();
		menu.querySelector<HTMLButtonElement>('[data-theme-mobile-v2]')?.addEventListener('click', () => {
			if (checkbox) {
				checkbox.checked = !checkbox.checked;
				checkbox.dispatchEvent(new Event('change', { bubbles: true }));
			}
		});
	}
</script>
