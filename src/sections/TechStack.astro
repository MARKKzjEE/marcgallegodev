---
const techs = [
	{ name: "Laravel", slug: "laravel" },
	{ name: "Django", slug: "django" },
	{ name: "NodeJS", slug: "nodejs" },
	{ name: "Tailwind", slug: "tailwindcss" },
	{ name: "Docker", slug: "docker" },
	{ name: "CI/CD", slug: "github" },
	{ name: "SEO", slug: "google" },
	{ name: "Astro", slug: "astro" },
];

const total = techs.length;
---

<section id="tech" class="bg-th-bg py-40">
	<div class="container mx-auto grid md:grid-cols-2 px-6">

		<!-- Columna izquierda: título + texto + botón -->
		<div class="flex flex-col">
			<div class="flex flex-col flex-1">
				<div class="tech-title relative" aria-label="Mis Tecnologías">
					<span class="tech-title__horizontal font-vogun text-th-heading font-bold uppercase">Tecnologías</span>
					<span class="tech-title__vertical font-vogun text-th-heading font-bold uppercase">Mis</span>
				</div>
				<div class="tech-description relative">
					<button type="button" class="tech-toggle-names" data-toggle-names data-reveal data-reveal-radius="32px" aria-pressed="false" aria-label="Mostrar nombres de tecnologías">
						<svg class="tech-toggle-eye" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z"></path></svg>
						<svg class="tech-toggle-eye-closed" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M228,175a8,8,0,0,1-10.92-3l-19-33.2A123.23,123.23,0,0,1,162,155.46l5.87,35.22a8,8,0,0,1-6.58,9.21A8.4,8.4,0,0,1,160,200a8,8,0,0,1-7.88-6.69l-5.77-34.58a133.06,133.06,0,0,1-36.68,0l-5.77,34.58A8,8,0,0,1,96,200a8.4,8.4,0,0,1-1.32-.11,8,8,0,0,1-6.58-9.21L94,155.46a123.23,123.23,0,0,1-36.06-16.69L39,172A8,8,0,1,1,25.06,164l20-35a153.47,153.47,0,0,1-19.3-20A8,8,0,1,1,38.22,99c16.6,20.54,45.64,45,89.78,45s73.18-24.49,89.78-45A8,8,0,1,1,230.22,109a153.47,153.47,0,0,1-19.3,20l20,35A8,8,0,0,1,228,175Z"></path></svg>
					<span class="tech-toggle-reveal reveal-layer" aria-hidden="true">
						<svg class="tech-toggle-eye" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z"></path></svg>
						<svg class="tech-toggle-eye-closed" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M228,175a8,8,0,0,1-10.92-3l-19-33.2A123.23,123.23,0,0,1,162,155.46l5.87,35.22a8,8,0,0,1-6.58,9.21A8.4,8.4,0,0,1,160,200a8,8,0,0,1-7.88-6.69l-5.77-34.58a133.06,133.06,0,0,1-36.68,0l-5.77,34.58A8,8,0,0,1,96,200a8.4,8.4,0,0,1-1.32-.11,8,8,0,0,1-6.58-9.21L94,155.46a123.23,123.23,0,0,1-36.06-16.69L39,172A8,8,0,1,1,25.06,164l20-35a153.47,153.47,0,0,1-19.3-20A8,8,0,1,1,38.22,99c16.6,20.54,45.64,45,89.78,45s73.18-24.49,89.78-45A8,8,0,1,1,230.22,109a153.47,153.47,0,0,1-19.3,20l20,35A8,8,0,0,1,228,175Z"></path></svg>
					</span>
				</button>
					<p class="font-cottor font-light text-th-text max-w-150 leading-[1.15] opacity-100 text-justify">
						Este es mi stack más destacado con el que trabajo día a día. <br>
						Me involucro en todas las fases del proyecto tanto front, back como del propio entorno y servidor.
					</p>
				</div>
			</div>

		</div>

		<!-- Columna derecha: wheel -->
		<div class="hidden md:flex items-center justify-end">
			<div class="tech-wheel relative" data-tech-wheel>
				{techs.map((tech, i) => (
					<button
						type="button"
						class="tech-icon absolute top-1/2 left-1/2"
						style={`--i: ${i}; --total: ${total};`}
						data-tech={tech.name}
						aria-label={tech.name}
					>
						<div class="tech-icon__logo">
							<img class="tech-icon__svg tech-icon__svg--light" src={`/tech-icons/${tech.slug}-l.svg`} alt={tech.name} />
							<img class="tech-icon__svg tech-icon__svg--dark" src={`/tech-icons/${tech.slug}-d.svg`} alt={tech.name} />
						</div>
						<div class="tech-icon__text">
							<span class="font-nord">{tech.name}</span>
						</div>
					</button>
				))}
			</div>
		</div>

	</div>

	<!-- Mobile: grid (fuera del grid de 2 columnas) -->
	<div class="grid grid-cols-4 gap-6 place-content-center px-10 py-10 md:hidden">
		{techs.map((tech) => (
			<div class="flex flex-col items-center gap-2">
				<img class="tech-icon__svg tech-icon__svg--light w-10 h-10" src={`/tech-icons/${tech.slug}-l.svg`} alt={tech.name} />
				<img class="tech-icon__svg tech-icon__svg--dark w-10 h-10" src={`/tech-icons/${tech.slug}-d.svg`} alt={tech.name} />
				<span class="font-nord text-th-text text-[10px] uppercase tracking-wider text-center">{tech.name}</span>
			</div>
		))}
	</div>
</section>

<style lang="scss">
	#tech {
		--title-size: clamp(52px, 7vw, 96px);
	}

	.tech-title__horizontal {
		font-size: var(--title-size);
		line-height: 1;
		letter-spacing: 0.15em;
	}

	.tech-title__vertical {
		position: absolute;
		top: 100%;
		left: 0;
		font-size: var(--title-size);
		line-height: 1;
		letter-spacing: 0.15em;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		white-space: nowrap;
	}

	.tech-description {
		--gap: 20px;
		flex: 1;
		margin-top: var(--gap);
		margin-left: calc(var(--title-size) + var(--gap));
		padding: 16px 0 64px 20px;
		border-top: 1px solid var(--th-l-dark-blue);
		border-left: 1px solid var(--th-l-dark-blue);

		p {
			font-size: clamp(28px, 4vw, 52px);
		}
	}

	.tech-toggle-names {
		--reveal-extend: 30px;
		position: absolute;
		left: -1px;
		bottom: 0;
		transform: translateX(-100%);
		padding-right: 12px;
		cursor: pointer;
		color: var(--th-heading);
		background: none;
		border: none;

		// Estado inicial: eye visible, eye-closed oculto
		.tech-toggle-eye-closed {
			display: none;
		}

		// Cuando está activo: eye oculto, eye-closed visible
		&[aria-pressed="true"] {
			.tech-toggle-eye {
				display: none;
			}
			.tech-toggle-eye-closed {
				display: block;
			}
		}
	}

	.tech-toggle-reveal {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--th-heading);
		color: var(--th-bg);
		padding: var(--reveal-extend);
		padding-right: calc(12px + var(--reveal-extend));
	}

	.tech-wheel {
		--radius: 240px;
		--icon-size: 90px;
		width: calc(var(--radius) * 2 + var(--icon-size));
		height: calc(var(--radius) * 2 + var(--icon-size));
	}

	.tech-icon {
		--angle: calc(360deg / var(--total) * var(--i));
		width: var(--icon-size);
		height: var(--icon-size);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 4px;
		border: 1px solid transparent;
		cursor: pointer;
		overflow: hidden;
		outline: none;
		transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);

		// Estado inicial (scroll animation)
		opacity: 0;
		transform: translate(-50%, -50%);

		// Shine effect (dos barridos cruzados)
		&::before,
		&::after {
			content: "";
			position: absolute;
			top: 0;
			width: 100%;
			height: 100%;
		}

		&::before {
			left: -100%;
		}

		&::after {
			left: 100%;
		}

		// Estado colocado (después de scroll animation)
		&.is-placed {
			opacity: 1;
			transform:
				translate(-50%, -50%)
				rotate(var(--angle))
				translateY(calc(-1 * var(--radius)))
				rotate(calc(-1 * var(--angle)));
			transition: all 0.6s cubic-bezier(0.22, 1, 0.36, 1);
			z-index: 1;

			&.is-active,
			&:focus-visible {
				z-index: 10;
				transform:
					translate(-50%, -50%)
					scale(2);

				&::before {
					animation: swipeRight 1s ease 0.6s forwards;
				}

				&::after {
					animation: swipeLeft 1s ease 0.6s forwards;
				}

				.tech-icon__svg {
					width: 48px;
					height: 48px;
				}

				.tech-icon__text {
					opacity: 1;
					max-height: 40px;
					margin-top: 4px;
					font-size: 10px;
				}
			}
		}

	}

	// Estado "mostrar nombres" global
	.tech-wheel.show-names .tech-icon.is-placed {
		.tech-icon__text {
			opacity: 1;
			max-height: 40px;
			margin-top: 4px;
			font-size: 10px;
		}
	}

	.tech-icon__logo {
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
		z-index: 1;
	}

	.tech-icon__svg {
		width: 44px;
		height: 44px;
		object-fit: contain;
		transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);

		@media (min-width: 1024px) {
			width: 50px;
			height: 50px;
		}

		&--dark {
			display: none;
		}
	}

	.tech-icon__text {
		display: flex;
		align-items: center;
		text-align: center;
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--th-heading);
		opacity: 0;
		max-height: 0;
		overflow: hidden;
		transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
		z-index: 1;
	}

	// ── Colores / Temas ──────────────────────────────
	// Edita solo estos bloques para cambiar colores de las cards

	// ── LIGHT ────────────────────────────────────────
	.tech-icon {
		background-color: #fff;
		border-color: var(--th-l-dark-blue);
		box-shadow: 3px 3px 0 var(--th-l-dark-blue);

		&::before,
		&::after {
			background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--th-l-dark-blue) 10%, transparent), transparent);
		}

		&.is-active,
		&.is-placed:focus-visible {
			border-color: var(--th-l-dark-blue);
			box-shadow: 8px 8px 0 var(--th-l-dark-blue);
		}

		&:focus-visible {
			box-shadow: 0 0 0 2px var(--th-l-dark-blue);
		}
	}

	// ── DARK ─────────────────────────────────────────
	:global(.dark) {
		.tech-description {
			border-color: var(--th-d-grey-light);
		}

		.tech-toggle-reveal {
			background: var(--th-d-white);
			color: var(--th-d-carbon);
		}

		.tech-icon__svg--light {
			display: none;
		}
		.tech-icon__svg--dark {
			display: block;
		}

		.tech-icon {
			background-color: var(--th-d-grey-dark);
			border-color: var(--th-d-grey-light);
			box-shadow: 3px 3px 0 var(--th-d-grey-light);

			&::before,
			&::after {
				background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
			}

			&.is-active,
			&.is-placed:focus-visible {
				border-color: var(--th-text);
				box-shadow: 8px 8px 0 var(--th-text);
			}

			&:focus-visible {
				box-shadow: 0 0 0 2px var(--th-heading);
			}
		}
	}

	@keyframes swipeRight {
		80% {
			transform: translateX(200%) skew(-45deg);
			opacity: 1;
		}
		100% {
			transform: translateX(200%) skew(-45deg);
			opacity: 0;
		}
	}

	@keyframes swipeLeft {
		80% {
			transform: translateX(-200%) skew(-45deg);
			opacity: 1;
		}
		100% {
			transform: translateX(-200%) skew(-45deg);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tech-icon,
		.tech-icon__logo,
		.tech-icon__svg,
		.tech-icon__text {
			transition: none;
		}
	}
</style>

<script>
	import { initTechWheel } from "../scripts/tech-wheel";
	import '../scripts/circle-reveal.ts';
	initTechWheel();
</script>
