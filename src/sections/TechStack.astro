---
const techs = [
	{ name: "Laravel", slug: "laravel" },
	{ name: "Django", slug: "django" },
	{ name: "NodeJS", slug: "nodejs" },
	{ name: "Tailwind", slug: "tailwindcss" },
	{ name: "Docker", slug: "docker" },
	{ name: "CI/CD", slug: "github" },
	{ name: "SEO", slug: "google" },
	{ name: "Astro", slug: "astro" },
];

const total = techs.length;
---

<section id="tech" class="py-16 md:py-24 px-4 md:px-10 overflow-visible">

	<!-- Título + texto + ojo -->
	<div class="tech-header">
		<h3 class="tech-title relative" aria-label="Mis Tecnologías">
			<span class="tech-title__horizontal font-nord text-secondary font-bold uppercase">Tecnologías</span>
			<span class="tech-title__vertical font-nord text-secondary font-bold uppercase">Mis</span>
		</h3>
		<button type="button" class="tech-toggle-names hidden md:flex" data-toggle-names data-reveal data-reveal-radius="32px" aria-pressed="false" aria-label="Mostrar nombres de tecnologías">
			<svg class="tech-toggle-eye" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z"></path></svg>
			<svg class="tech-toggle-eye-closed" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M228,175a8,8,0,0,1-10.92-3l-19-33.2A123.23,123.23,0,0,1,162,155.46l5.87,35.22a8,8,0,0,1-6.58,9.21A8.4,8.4,0,0,1,160,200a8,8,0,0,1-7.88-6.69l-5.77-34.58a133.06,133.06,0,0,1-36.68,0l-5.77,34.58A8,8,0,0,1,96,200a8.4,8.4,0,0,1-1.32-.11,8,8,0,0,1-6.58-9.21L94,155.46a123.23,123.23,0,0,1-36.06-16.69L39,172A8,8,0,1,1,25.06,164l20-35a153.47,153.47,0,0,1-19.3-20A8,8,0,1,1,38.22,99c16.6,20.54,45.64,45,89.78,45s73.18-24.49,89.78-45A8,8,0,1,1,230.22,109a153.47,153.47,0,0,1-19.3,20l20,35A8,8,0,0,1,228,175Z"></path></svg>
			<span class="tech-toggle-reveal reveal-layer" aria-hidden="true">
				<svg class="tech-toggle-eye" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z"></path></svg>
				<svg class="tech-toggle-eye-closed" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M228,175a8,8,0,0,1-10.92-3l-19-33.2A123.23,123.23,0,0,1,162,155.46l5.87,35.22a8,8,0,0,1-6.58,9.21A8.4,8.4,0,0,1,160,200a8,8,0,0,1-7.88-6.69l-5.77-34.58a133.06,133.06,0,0,1-36.68,0l-5.77,34.58A8,8,0,0,1,96,200a8.4,8.4,0,0,1-1.32-.11,8,8,0,0,1-6.58-9.21L94,155.46a123.23,123.23,0,0,1-36.06-16.69L39,172A8,8,0,1,1,25.06,164l20-35a153.47,153.47,0,0,1-19.3-20A8,8,0,1,1,38.22,99c16.6,20.54,45.64,45,89.78,45s73.18-24.49,89.78-45A8,8,0,1,1,230.22,109a153.47,153.47,0,0,1-19.3,20l20,35A8,8,0,0,1,228,175Z"></path></svg>
			</span>
		</button>
	</div>

	<!-- Texto mobile: en flujo normal, desplazado a la derecha del "Mis" -->
	<p class="tech-desc tech-desc--corner font-nord text-secondary font-normal tracking-widest md:hidden">Estas son algunas de las tecnologías con las que trabajo a diario. Me gusta implicarme en todas las fases del proyecto, desde la idea hasta que está en producción.</p>

	<!-- Wheel: centrado -->
	<div class="hidden md:flex items-center justify-center py-10">
		<div class="tech-wheel relative" data-tech-wheel>
			{techs.map((tech, i) => (
				<button
					type="button"
					class="tech-icon absolute top-1/2 left-1/2"
					style={`--i: ${i}; --total: ${total};`}
					data-tech={tech.name}
					aria-label={tech.name}
				>
					<div class="tech-icon__logo">
						<img class="tech-icon__svg tech-icon__svg--light" src={`/tech-icons/${tech.slug}-d.svg`} alt={tech.name} />
						<img class="tech-icon__svg tech-icon__svg--dark" src={`/tech-icons/${tech.slug}-l.svg`} alt={tech.name} />
					</div>
					<div class="tech-icon__text">
						<span class="font-monoblock">{tech.name}</span>
					</div>
				</button>
			))}
		</div>
	</div>

	<!-- Texto desktop: debajo de la rueda, izquierda -->
	<div class="hidden md:flex items-end justify-between">
		<p class="tech-desc font-nord text-secondary font-normal tracking-widest">Estas son algunas de las tecnologías con las que trabajo a diario. Me gusta implicarme en todas las fases del proyecto, desde la idea hasta que está en producción.</p>
	</div>

	<!-- Mobile: marquee (2 filas, direcciones opuestas) -->
	<div class="tech-marquee-wrap md:hidden" style="margin-top: 2rem">
		<!-- Fila 1: primeros 4, izquierda → derecha -->
		<div class="tech-marquee-row">
			<div class="tech-marquee-track tech-marquee-track--fwd">
				{[...techs.slice(0,4), ...techs.slice(0,4)].map((tech) => (
					<div class="tech-marquee-card">
						<img class="tech-icon__svg tech-icon__svg--light" src={`/tech-icons/${tech.slug}-d.svg`} alt={tech.name} />
						<img class="tech-icon__svg tech-icon__svg--dark" src={`/tech-icons/${tech.slug}-l.svg`} alt={tech.name} />
						<span class="font-nord text-secondary text-[10px] uppercase tracking-wider text-center">{tech.name}</span>
					</div>
				))}
			</div>
		</div>
		<!-- Fila 2: últimos 4, derecha → izquierda -->
		<div class="tech-marquee-row">
			<div class="tech-marquee-track tech-marquee-track--bwd">
				{[...techs.slice(4), ...techs.slice(4)].map((tech) => (
					<div class="tech-marquee-card">
						<img class="tech-icon__svg tech-icon__svg--light" src={`/tech-icons/${tech.slug}-d.svg`} alt={tech.name} />
						<img class="tech-icon__svg tech-icon__svg--dark" src={`/tech-icons/${tech.slug}-l.svg`} alt={tech.name} />
						<span class="font-nord text-secondary text-[10px] uppercase tracking-wider text-center">{tech.name}</span>
					</div>
				))}
			</div>
		</div>
	</div>

	<!-- Ojo mobile: debajo del marquee, justificado derecha -->
	<div class="flex justify-end mt-4 md:hidden">
		<button type="button" class="tech-toggle-names" data-toggle-names-mobile aria-pressed="false" aria-label="Mostrar nombres de tecnologías">
			<svg class="tech-toggle-eye" xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 256 256"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z"></path></svg>
			<svg class="tech-toggle-eye-closed" xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 256 256"><path d="M228,175a8,8,0,0,1-10.92-3l-19-33.2A123.23,123.23,0,0,1,162,155.46l5.87,35.22a8,8,0,0,1-6.58,9.21A8.4,8.4,0,0,1,160,200a8,8,0,0,1-7.88-6.69l-5.77-34.58a133.06,133.06,0,0,1-36.68,0l-5.77,34.58A8,8,0,0,1,96,200a8.4,8.4,0,0,1-1.32-.11,8,8,0,0,1-6.58-9.21L94,155.46a123.23,123.23,0,0,1-36.06-16.69L39,172A8,8,0,1,1,25.06,164l20-35a153.47,153.47,0,0,1-19.3-20A8,8,0,1,1,38.22,99c16.6,20.54,45.64,45,89.78,45s73.18-24.49,89.78-45A8,8,0,1,1,230.22,109a153.47,153.47,0,0,1-19.3,20l20,35A8,8,0,0,1,228,175Z"></path></svg>
		</button>
	</div>
</section>

<style lang="scss">
	// ─── Variables ───────────────────────────────────
	#tech {
		--title-size: clamp(44px, 8vw, 96px);
		--desc-size: clamp(12px, 1.2vw, 18px);
	}

	// ─── Header: título + texto + ojo ───────────────
	.tech-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
	}

	// ─── Descripción desktop ────────────────────────
	.tech-desc {
		font-size: var(--desc-size);
		max-width: 380px;
		line-height: 1.7;
		font-weight: 400;
	}

	// ─── Descripción mobile: a la derecha del "Mis", en flujo normal ───
	.tech-desc--corner {
		padding-left: calc(var(--title-size) + 8px);
		margin-top: 8px;
		font-size: clamp(11px, 2.5vw, 13px);
		line-height: 1.6;
	}

	// ─── Título (L invertida) ───────────────────────
	.tech-title__horizontal {
		font-size: var(--title-size);
		line-height: 1;
	}

	.tech-title__vertical {
		position: absolute;
		top: 100%;
		left: 0;
		font-size: var(--title-size);
		line-height: 1;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		white-space: nowrap;
	}

	// ─── Toggle ojo (mostrar/ocultar nombres) ───────
	.tech-toggle-names {
		--reveal-extend: 30px;
		position: relative;
		cursor: pointer;
		color: var(--secondary);
		background: none;
		border: none;

		.tech-toggle-eye-closed { display: none; }

		&[aria-pressed="true"] {
			.tech-toggle-eye { display: none; }
			.tech-toggle-eye-closed { display: block; }
		}
	}

	.tech-toggle-reveal {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--secondary);
		color: var(--primary);
		padding: var(--reveal-extend);
	}

	// ─── Wheel (contenedor circular) ────────────────
	.tech-wheel {
		--radius: 300px;
		--icon-size: 120px;
		width: calc(var(--radius) * 2 + var(--icon-size));
		height: calc(var(--radius) * 2 + var(--icon-size));
	}

	// ─── Icon card ──────────────────────────────────
	.tech-icon {
		--angle: calc(360deg / var(--total) * var(--i));
		--_svg: 64px;
		width: var(--icon-size);
		height: var(--icon-size);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		border: 1px solid rgba(0, 0, 0, 0.05);
		background-color: var(--terciary);
		cursor: pointer;
		overflow: hidden;
		outline: none;
		// Transform gestionado 100% por JS
		opacity: 0;
		transform: translate(-50%, -50%);

		// Shine: barrido de luz al activar
		&::before {
			content: "";
			position: absolute;
			top: 0;
			left: -100%;
			width: 100%;
			height: 100%;
			background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.08), transparent);
			pointer-events: none;
		}

		:global(.dark) &::before {
			background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
		}

		&.is-placed {
			opacity: 1;
			z-index: 1;

			// Hover: solo estilos visuales, transform lo pone el JS
			&.is-active {
				z-index: 10;
				&::before { animation: shine 0.8s ease 0.4s forwards; }
				.tech-icon__text { opacity: 1; }
				.tech-icon__logo { transform: translateY(-8px); }
				.tech-icon__svg { --_svg: 50px; }
			}
		}
	}

	// Mostrar nombres (toggle global)
	.tech-wheel.show-names .tech-icon.is-placed {
		.tech-icon__text { opacity: 1; }
		.tech-icon__logo { transform: translateY(-8px); }
		.tech-icon__svg { --_svg: 56px; }
	}

	// ─── Icon: partes internas ──────────────────────
	.tech-icon__logo {
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
		z-index: 1;
	}

	.tech-icon__svg {
		width: var(--_svg);
		height: var(--_svg);
		object-fit: contain;
		transition: width 0.3s cubic-bezier(0.25, 0.8, 0.25, 1),
					height 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);

		&--dark { display: none; }
	}

	.tech-icon__text {
		position: absolute;
		bottom: 10px;
		left: 0;
		right: 0;
		display: flex;
		justify-content: center;
		text-align: center;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--secondary);
		opacity: 0;
		transition: opacity 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
		z-index: 1;
	}

	// ─── Dark mode overrides ────────────────────────
	:global(.dark) {
		.tech-toggle-reveal {
			background: var(--secondary);
			color: var(--primary);
		}

		.tech-icon__svg--light { display: none; }
		.tech-icon__svg--dark { display: block; }

		.tech-icon {
			background-color: var(--terciary);
			border-color: var(--quaternary);
		}
	}

	// ─── Keyframes ──────────────────────────────────
	@keyframes shine {
		to { left: 100%; }
	}

	// ─── Marquee mobile ─────────────────────────────
	.tech-marquee-wrap {
		flex-direction: column;
		gap: 16px;
		overflow: hidden;

		@media (max-width: 767px) {
			display: flex;
		}
	}

	.tech-marquee-row {
		overflow: hidden;
	}

	.tech-marquee-track {
		display: flex;
		gap: 16px;
		width: max-content;

		&--fwd {
			animation: marquee-fwd 20s linear infinite;
		}

		&--bwd {
			animation: marquee-bwd 20s linear infinite;
		}
	}

	.tech-marquee-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		width: 34vw;
		aspect-ratio: 1;
		border-radius: 12px;
		background-color: var(--terciary);
		border: 1px solid color-mix(in srgb, var(--secondary) 8%, transparent);
		flex-shrink: 0;
		padding: 32px;

		img {
			flex: 1;
			min-height: 0;
			width: 100%;
			object-fit: contain;
			transition: flex 400ms cubic-bezier(0.16, 1, 0.3, 1);
		}

		span {
			flex-shrink: 0;
			max-height: 0;
			overflow: hidden;
			opacity: 0;
			transition: max-height 400ms cubic-bezier(0.16, 1, 0.3, 1),
						opacity 400ms cubic-bezier(0.16, 1, 0.3, 1);
		}
	}

	// Nombres visibles cuando el wrapper tiene show-names
	.tech-marquee-wrap.show-names .tech-marquee-card span {
		max-height: 24px;
		opacity: 1;
	}

	@keyframes marquee-fwd {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	@keyframes marquee-bwd {
		from { transform: translateX(-50%); }
		to { transform: translateX(0); }
	}

	// ─── Accesibilidad ──────────────────────────────
	@media (prefers-reduced-motion: reduce) {
		.tech-icon,
		.tech-icon__logo,
		.tech-icon__svg,
		.tech-icon__text {
			transition: none;
		}
		.tech-marquee-track {
			animation: none;
		}
	}
</style>

<script>
	import { initTechWheel } from "../scripts/tech-wheel";
	import '../scripts/circle-reveal.ts';
	initTechWheel();

	// ─── Ojo mobile ───
	const mobileBtn = document.querySelector<HTMLButtonElement>('[data-toggle-names-mobile]');
	const marqueeWrap = document.querySelector<HTMLElement>('.tech-marquee-wrap');

	mobileBtn?.addEventListener('click', () => {
		const isActive = marqueeWrap?.classList.toggle('show-names');
		mobileBtn.setAttribute('aria-pressed', String(isActive));
	});
</script>
