---
import { getLang, useTranslations } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const techs = [
	{ name: "Laravel", slug: "laravel" },
	{ name: "Django", slug: "django" },
	{ name: "NodeJS", slug: "nodejs" },
	{ name: "Tailwind", slug: "tailwindcss" },
	{ name: "Docker", slug: "docker" },
	{ name: "CI/CD", slug: "github" },
	{ name: "SEO", slug: "google" },
	{ name: "Astro", slug: "astro" },
];

const total = techs.length;
---

<section id="tech" class="overflow-visible" aria-labelledby="tech-heading">

	<!-- ─── Desktop frame ─── -->
	<div class="tech-desktop-frame hidden xl:block">

	<!-- ─── Desktop heading ─── -->
	<div class="tech-header flex">
		<div class="tech-header-spacer pl-10 border-t border-secondary"></div>
		<h2 id="tech-heading" class="tech-cell tech-cell--title font-nord text-secondary border-y border-r border-secondary font-medium px-10 py-5">
			{t.techStack.heading}
		</h2>
		<div class="tech-cell tech-cell--typewriter text-mono-label-soft border-y border-r border-secondary" data-tech-typewriter data-phrases={JSON.stringify(t.techStack.typewriterPhrases)} aria-live="polite">
			<span class="tech-typewriter-text" data-tech-typewriter-text></span>
		</div>
		<button type="button" class="tech-cell tech-cell--eye tech-toggle-names border-y border-secondary" data-toggle-names data-reveal data-reveal-radius="32px" aria-pressed="false" aria-label={t.techStack.toggleShow}>
			<svg class="tech-toggle-eye" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z"></path></svg>
			<svg class="tech-toggle-eye-closed" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M228,175a8,8,0,0,1-10.92-3l-19-33.2A123.23,123.23,0,0,1,162,155.46l5.87,35.22a8,8,0,0,1-6.58,9.21A8.4,8.4,0,0,1,160,200a8,8,0,0,1-7.88-6.69l-5.77-34.58a133.06,133.06,0,0,1-36.68,0l-5.77,34.58A8,8,0,0,1,96,200a8.4,8.4,0,0,1-1.32-.11,8,8,0,0,1-6.58-9.21L94,155.46a123.23,123.23,0,0,1-36.06-16.69L39,172A8,8,0,1,1,25.06,164l20-35a153.47,153.47,0,0,1-19.3-20A8,8,0,1,1,38.22,99c16.6,20.54,45.64,45,89.78,45s73.18-24.49,89.78-45A8,8,0,1,1,230.22,109a153.47,153.47,0,0,1-19.3,20l20,35A8,8,0,0,1,228,175Z"></path></svg>
			<span class="tech-toggle-reveal reveal-layer" aria-hidden="true">
				<svg class="tech-toggle-eye" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z"></path></svg>
				<svg class="tech-toggle-eye-closed" xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 256 256"><path d="M228,175a8,8,0,0,1-10.92-3l-19-33.2A123.23,123.23,0,0,1,162,155.46l5.87,35.22a8,8,0,0,1-6.58,9.21A8.4,8.4,0,0,1,160,200a8,8,0,0,1-7.88-6.69l-5.77-34.58a133.06,133.06,0,0,1-36.68,0l-5.77,34.58A8,8,0,0,1,96,200a8.4,8.4,0,0,1-1.32-.11,8,8,0,0,1-6.58-9.21L94,155.46a123.23,123.23,0,0,1-36.06-16.69L39,172A8,8,0,1,1,25.06,164l20-35a153.47,153.47,0,0,1-19.3-20A8,8,0,1,1,38.22,99c16.6,20.54,45.64,45,89.78,45s73.18-24.49,89.78-45A8,8,0,1,1,230.22,109a153.47,153.47,0,0,1-19.3,20l20,35A8,8,0,0,1,228,175Z"></path></svg>
			</span>
		</button>
		<div class="tech-header-spacer pr-10 border-t border-secondary"></div>
	</div>
	<!-- Desktop: "Mis" vertical -->
	<div class="tech-vertical-wrap inline-flex">
		<div class="tech-header-spacer pl-10"></div>
		<div class="tech-cell tech-cell--vertical font-nord text-secondary font-medium py-10 px-5">
			{lang === 'en' ? 'My' : 'Mis'}
		</div>
	</div>

	<!-- Wheel: centrado -->
	<div class="tech-wheel-wrap flex items-center justify-center pb-30" style="margin-top: calc((var(--title-size) - 40px) * -1)">
		<div class="tech-wheel relative" data-tech-wheel>
			{techs.map((tech, i) => (
				<button
					type="button"
					class="tech-icon absolute top-1/2 left-1/2"
					style={`--i: ${i}; --total: ${total};`}
					data-tech={tech.name}
					aria-label={tech.name}
				>
					<div class="tech-icon__logo">
						<img class="tech-icon__svg tech-icon__svg--light" src={`/tech-icons/${tech.slug}-d.svg`} alt={tech.name} />
						<img class="tech-icon__svg tech-icon__svg--dark" src={`/tech-icons/${tech.slug}-l.svg`} alt={tech.name} />
					</div>
					<div class="tech-icon__text">
						<span class="text-mono-label-soft">{tech.name}</span>
					</div>
				</button>
			))}
		</div>
	</div>

	<!-- Footer bar -->
	<div class="tech-footer-bar"></div>

	</div><!-- /tech-desktop-frame -->

	<!-- ─── Mobile heading ─── -->
	<div class="tech-header-mobile xl:hidden">
		<div class="tech-header-mobile__top">
			<h2 class="tech-cell tech-cell--title font-nord text-secondary font-medium py-4 px-4 md:px-10" aria-label={t.techStack.heading}>
				{t.techStack.heading}
			</h2>
			<button type="button" class="tech-cell tech-cell--eye-mobile tech-toggle-names px-4 md:px-10" data-toggle-names-mobile aria-pressed="false" aria-label={t.techStack.toggleShow}>
				<svg class="tech-toggle-eye" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z"></path></svg>
				<svg class="tech-toggle-eye-closed" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 256 256"><path d="M228,175a8,8,0,0,1-10.92-3l-19-33.2A123.23,123.23,0,0,1,162,155.46l5.87,35.22a8,8,0,0,1-6.58,9.21A8.4,8.4,0,0,1,160,200a8,8,0,0,1-7.88-6.69l-5.77-34.58a133.06,133.06,0,0,1-36.68,0l-5.77,34.58A8,8,0,0,1,96,200a8.4,8.4,0,0,1-1.32-.11,8,8,0,0,1-6.58-9.21L94,155.46a123.23,123.23,0,0,1-36.06-16.69L39,172A8,8,0,1,1,25.06,164l20-35a153.47,153.47,0,0,1-19.3-20A8,8,0,1,1,38.22,99c16.6,20.54,45.64,45,89.78,45s73.18-24.49,89.78-45A8,8,0,1,1,230.22,109a153.47,153.47,0,0,1-19.3,20l20,35A8,8,0,0,1,228,175Z"></path></svg>
			</button>
		</div>
		<div class="tech-header-mobile__bottom">
			<div class="tech-cell tech-cell--vertical font-nord text-secondary font-medium py-4 px-4 md:py-10">
				{lang === 'en' ? 'My' : 'Mis'}
			</div>
			<div class="tech-cell tech-cell--typewriter-mobile text-mono-label-soft py-4 px-4 md:px-10" data-tech-typewriter-mobile data-phrases={JSON.stringify(t.techStack.typewriterPhrases)} aria-live="polite">
				<span class="tech-typewriter-text" data-tech-typewriter-text-mobile></span>
			</div>
		</div>
	</div>

	<!-- Mobile: marquee (2 filas, direcciones opuestas) -->
	<div class="tech-marquee-wrap xl:hidden pt-8 pb-16 md:pt-15 md:pb-30">
		<!-- Fila 1: primeros 4, izquierda → derecha -->
		<div class="tech-marquee-row">
			<div class="tech-marquee-track tech-marquee-track--fwd">
				{[0, 1, 2].map(() => (
					<div class="tech-marquee-group">
						{techs.slice(0,4).map((tech) => (
							<div class="tech-marquee-card">
								<img class="tech-icon__svg tech-icon__svg--light" src={`/tech-icons/${tech.slug}-d.svg`} alt={tech.name} />
								<img class="tech-icon__svg tech-icon__svg--dark" src={`/tech-icons/${tech.slug}-l.svg`} alt={tech.name} />
								<span class="text-mono-label-soft text-center">{tech.name}</span>
							</div>
						))}
					</div>
				))}
			</div>
		</div>
		<!-- Fila 2: últimos 4, derecha → izquierda -->
		<div class="tech-marquee-row">
			<div class="tech-marquee-track tech-marquee-track--bwd">
				{[0, 1, 2].map(() => (
					<div class="tech-marquee-group">
						{techs.slice(4).map((tech) => (
							<div class="tech-marquee-card">
								<img class="tech-icon__svg tech-icon__svg--light" src={`/tech-icons/${tech.slug}-d.svg`} alt={tech.name} />
								<img class="tech-icon__svg tech-icon__svg--dark" src={`/tech-icons/${tech.slug}-l.svg`} alt={tech.name} />
								<span class="text-mono-label-soft text-center">{tech.name}</span>
							</div>
						))}
					</div>
				))}
			</div>
		</div>
	</div>

</section>

<style lang="scss">
	// ─── Variables ───────────────────────────────────
	#tech {
		--title-size: clamp(35px, 8vw, 80px);
	}

	// ─── Shared ─────────────────────────────────────
	.tech-cell {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.tech-cell--title {
		flex-shrink: 0;
		justify-content: flex-start;
		font-size: var(--title-size);
		line-height: 1;
	}

	.tech-cell--vertical {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: var(--title-size);
		line-height: 1;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		border-left: 1px solid var(--secondary);
		border-top: 1px solid var(--secondary);
	}

	.tech-typewriter-text {
		&::after {
			content: '';
			display: inline-block;
			width: 1px;
			height: 1.1em;
			background: var(--secondary);
			vertical-align: middle;
			margin-left: 2px;
			animation: tech-cursor-blink 500ms step-end infinite;
		}
	}

	@keyframes tech-cursor-blink {
		50% { opacity: 0; }
	}

	// ─── Desktop frame ──────────────────────────────
	.tech-desktop-frame {
		position: relative;
		// Bordes laterales continuos
		&::before,
		&::after {
			content: '';
			position: absolute;
			top: 0;
			bottom: 0;
			width: 40px; // pl-10 / pr-10
			border-color: var(--secondary);
		}

		&::before {
			left: 0;
			border-right: 1px solid var(--secondary);
		}

		&::after {
			right: 0;
			border-left: 1px solid var(--secondary);
		}
	}

	.tech-footer-bar {
		margin: 0 40px;
		border-top: 1px solid var(--secondary);
		height: 40px;
	}

	// ─── Desktop heading ────────────────────────────
	.tech-header {
		align-items: stretch;
	}

	.tech-cell--eye {
		padding: 0 2rem;
		background: none;
		cursor: pointer;
	}

	.tech-cell--typewriter {
		flex: 1;
		min-width: 0;
		padding: 0 1.5rem;
		overflow: hidden;
	}

	.tech-vertical-wrap {
		align-items: stretch;
	}

	.tech-wheel-wrap {
		padding-left: 40px;
		padding-right: 40px;
	}

	// ─── Mobile heading ─────────────────────────────
	.tech-header-mobile {
		border-top: 1px solid var(--secondary);
	}

	.tech-header-mobile__top {
		display: flex;
		align-items: stretch;
		border-bottom: 1px solid var(--secondary);
	}

	.tech-header-mobile__top .tech-cell--title {
		flex: 1;
	}

	button.tech-cell--eye-mobile {
		flex-shrink: 0;
		border-left: 1px solid var(--secondary);
		background: none;
		cursor: pointer;
	}

	.tech-header-mobile__bottom {
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: 1fr;

		@media (min-width: 768px) {
			grid-template-rows: 1fr 1fr;
		}
	}

	.tech-header-mobile__bottom .tech-cell--vertical {
		grid-row: 1 / -1;
	}

	.tech-cell--typewriter-mobile {
		grid-row: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		border-bottom: 1px solid var(--secondary);
	}

	// ─── Toggle ojo (mostrar/ocultar nombres) ───────
	.tech-toggle-names {
		--reveal-extend: 30px;
		position: relative;
		cursor: pointer;
		color: var(--secondary);
		background: none;

		.tech-toggle-eye-closed { display: none; }

		&[aria-pressed="true"] {
			.tech-toggle-eye { display: none; }
			.tech-toggle-eye-closed { display: block; }
		}
	}

	.tech-toggle-reveal {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--secondary);
		color: var(--primary);
		padding: var(--reveal-extend);
	}

	// ─── Wheel (contenedor circular) ────────────────
	.tech-wheel {
		--radius: 300px;
		--icon-size: 140px;
		width: calc(var(--radius) * 2 + var(--icon-size));
		height: calc(var(--radius) * 2 + var(--icon-size));
	}

	// ─── Icon card ──────────────────────────────────
	.tech-icon {
		--angle: calc(360deg / var(--total) * var(--i));
		--_svg: 64px;
		width: var(--icon-size);
		height: var(--icon-size);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		border: 1px solid rgba(0, 0, 0, 0.05);
		background-color: var(--terciary);
		cursor: pointer;
		overflow: hidden;
		outline: none;
		&:focus-visible {
			outline: 2px solid var(--secondary);
			outline-offset: 2px;
		}
		// Transform gestionado 100% por JS
		opacity: 0;
		transform: translate(-50%, -50%);

		// Shine: barrido de luz al activar
		&::before {
			content: "";
			position: absolute;
			top: 0;
			left: -100%;
			width: 100%;
			height: 100%;
			background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.08), transparent);
			pointer-events: none;
		}

		:global(.dark) &::before {
			background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
		}

		&.is-placed {
			opacity: 1;
			z-index: 1;

			// Hover: solo estilos visuales, transform lo pone el JS
			&.is-active {
				z-index: 10;
				&::before { animation: shine 0.8s ease 0.4s forwards; }
				.tech-icon__text { opacity: 1; }
				.tech-icon__logo { transform: translateY(-8px); }
				.tech-icon__svg { --_svg: 50px; }
			}
		}
	}

	// Mostrar nombres (toggle global)
	.tech-wheel.show-names .tech-icon.is-placed {
		.tech-icon__text { opacity: 1; }
		.tech-icon__logo { transform: translateY(-8px); }
		.tech-icon__svg { --_svg: 56px; }
	}

	// ─── Icon: partes internas ──────────────────────
	.tech-icon__logo {
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
		z-index: 1;
	}

	.tech-icon__svg {
		width: var(--_svg);
		height: var(--_svg);
		object-fit: contain;
		transition: width 0.3s cubic-bezier(0.25, 0.8, 0.25, 1),
					height 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);

		&--dark { display: none; }
	}

	.tech-icon__text {
		position: absolute;
		bottom: 10px;
		left: 0;
		right: 0;
		display: flex;
		justify-content: center;
		text-align: center;
		opacity: 0;
		transition: opacity 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
		z-index: 1;
	}

	// ─── Dark mode overrides ────────────────────────
	:global(.dark) {
		.tech-toggle-reveal {
			background: var(--secondary);
			color: var(--primary);
		}

		.tech-icon__svg--light { display: none; }
		.tech-icon__svg--dark { display: block; }

		.tech-icon {
			background-color: var(--terciary);
			border-color: var(--quaternary);
		}
	}

	// ─── Keyframes ──────────────────────────────────
	@keyframes shine {
		to { left: 100%; }
	}

	// ─── Marquee mobile ─────────────────────────────
	.tech-marquee-wrap {
		flex-direction: column;
		gap: 16px;
		overflow: hidden;

		@media (min-width: 768px) {
			gap: 40px;
		}

		@media (max-width: 1279px) {
			display: flex;
		}
	}

	.tech-marquee-row {
		overflow: hidden;
	}

	.tech-marquee-track {
		display: flex;
		width: max-content;

		&--fwd {
			animation: marquee-fwd 20s linear infinite;
		}

		&--bwd {
			animation: marquee-bwd 20s linear infinite;
		}
	}

	.tech-marquee-group {
		display: flex;
		gap: 16px;
		flex-shrink: 0;
		padding-right: 16px;

		@media (min-width: 768px) {
			gap: 40px;
			padding-right: 40px;
		}
	}

	.tech-marquee-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		width: 26vw;
		aspect-ratio: 1;
		border-radius: 12px;
		background-color: var(--terciary);
		border: 1px solid color-mix(in srgb, var(--secondary) 8%, transparent);
		flex-shrink: 0;
		padding: 16px;

		@media (min-width: 768px) {
			width: 18vw;
			padding: 40px;
		}

		img {
			flex: 1;
			min-height: 0;
			width: 100%;
			object-fit: contain;
			transition: flex 400ms cubic-bezier(0.16, 1, 0.3, 1);
		}

		span {
			flex-shrink: 0;
			max-height: 0;
			overflow: hidden;
			opacity: 0;
			transition: max-height 400ms cubic-bezier(0.16, 1, 0.3, 1),
						opacity 400ms cubic-bezier(0.16, 1, 0.3, 1);
		}
	}

	// Nombres visibles cuando el wrapper tiene show-names
	.tech-marquee-wrap.show-names .tech-marquee-card span {
		max-height: 24px;
		opacity: 1;
	}

	@keyframes marquee-fwd {
		from { transform: translateX(0); }
		to { transform: translateX(-33.3333%); }
	}

	@keyframes marquee-bwd {
		from { transform: translateX(-33.3333%); }
		to { transform: translateX(0); }
	}

	// ─── Accesibilidad ──────────────────────────────
	@media (prefers-reduced-motion: reduce) {
		.tech-icon,
		.tech-icon__logo,
		.tech-icon__svg,
		.tech-icon__text {
			transition: none;
		}
		.tech-marquee-track {
			animation: none;
		}
	}
</style>

<script>
	import { initTechWheel } from "../scripts/tech-wheel";
	import '../scripts/circle-reveal.ts';
	initTechWheel();

	// ─── Ojo mobile ───
	const mobileBtn = document.querySelector<HTMLButtonElement>('[data-toggle-names-mobile]');
	const marqueeWrap = document.querySelector<HTMLElement>('.tech-marquee-wrap');

	mobileBtn?.addEventListener('click', () => {
		const isActive = marqueeWrap?.classList.toggle('show-names');
		mobileBtn.setAttribute('aria-pressed', String(isActive));
	});

	// ─── Typewriter loop ───
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const TYPE_MS = 50;
		const HOLD_MS = 2000;
		const DELETE_MS = 30;
		const PAUSE_MS = 500;

		function sleep(ms: number) {
			return new Promise(r => setTimeout(r, ms));
		}

		function initTypewriter(wrapperSelector: string, textSelector: string) {
			const wrapper = document.querySelector<HTMLElement>(wrapperSelector);
			const textEl = document.querySelector<HTMLElement>(textSelector);
			if (!wrapper || !textEl) return;

			const phrases: string[] = JSON.parse(wrapper.dataset.phrases || '[]');
			if (!phrases.length) return;

			async function loop() {
				let index = 0;
				while (true) {
					const text = phrases[index];
					for (let i = 0; i <= text.length; i++) {
						textEl!.textContent = text.slice(0, i);
						await sleep(TYPE_MS);
					}
					await sleep(HOLD_MS);
					for (let i = text.length; i >= 0; i--) {
						textEl!.textContent = text.slice(0, i);
						await sleep(DELETE_MS);
					}
					await sleep(PAUSE_MS);
					index = (index + 1) % phrases.length;
				}
			}

			loop();
		}

		initTypewriter('[data-tech-typewriter]', '[data-tech-typewriter-text]');
		initTypewriter('[data-tech-typewriter-mobile]', '[data-tech-typewriter-text-mobile]');
	}
</script>
