---
import { getLang, useTranslations, getLocalePath } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

// Pie de sección: enlace a trayectoria + metadato con nº de tecnologías.
const experiencePath = getLocalePath(lang, '/experience');

// Iconos en /public/tech-icons/ con convención {slug}-d.svg (claro) y {slug}-l.svg (oscuro).
const techs = [
	// Backend
	{ name: "Laravel",    slug: "laravel",      cat: "backend" },
	{ name: "Django",     slug: "django",       cat: "backend" },
	{ name: "PHP",        slug: "php",          cat: "backend" },
	{ name: "Python",     slug: "python",       cat: "backend" },
	{ name: "SQL",        slug: "sqldeveloper", cat: "backend" },
	// Frontend
	{ name: "JavaScript", slug: "js",           cat: "frontend" },
	{ name: "TypeScript", slug: "typescript",   cat: "frontend" },
	{ name: "React",      slug: "react",        cat: "frontend" },
	{ name: "Angular",    slug: "angular",      cat: "frontend" },
	{ name: "HTML",       slug: "html5",        cat: "frontend" },
	{ name: "CSS",        slug: "css3",         cat: "frontend" },
	{ name: "Tailwind",   slug: "tailwindcss",  cat: "frontend" },
	{ name: "Astro",      slug: "astro",        cat: "frontend" },
	// DevOps
	{ name: "Docker",     slug: "docker",       cat: "devops" },
	{ name: "CI/CD",      slug: "git",          cat: "devops" },
	// SEO
	{ name: "SEO",        slug: "google",       cat: "seo" },
];

// Tabs de filtrado (clave → label vía i18n)
const filters = [
	{ key: "all",      label: t.techStack.filters.all },
	{ key: "frontend", label: t.techStack.filters.frontend },
	{ key: "backend",  label: t.techStack.filters.backend },
	{ key: "devops",   label: t.techStack.filters.devops },
	{ key: "seo",      label: t.techStack.filters.seo },
];
---

<section id="tech" class="tech py-16 md:py-30" aria-labelledby="tech-heading">

	<!-- Título -->
	<div class="tech-head px-4 md:px-10">
		<h2 id="tech-heading" class="tech-title font-nord font-normal text-secondary">{t.techStack.heading}</h2>
	</div>

	<!-- Tabs en celdas, fila fija pegada encima del carrusel -->
	<div class="tech-tabs" role="tablist" aria-label={t.techStack.heading}>
		{filters.map((f, i) => (
			<button
				type="button"
				class:list={['tech-tab text-mono-label', { 'is-active': i === 0 }]}
				role="tab"
				aria-selected={i === 0 ? 'true' : 'false'}
				data-tech-filter={f.key}
			>{f.label}</button>
		))}
	</div>

	<!-- Carrusel horizontal: drag + cursor custom (scroll nativo de fondo) -->
	<div class="tech-carousel-wrap" data-tech-carousel>
		<div class="tech-carousel" data-tech-track role="list">
			{techs.map((tech, i) => (
				<article class="tech-cell" role="listitem" data-cat={tech.cat}>
					<!-- Cabecera: número + nombre -->
					<header class="tech-cell__head">
						<span class="tech-cell__no text-mono-label">{String(i + 1).padStart(2, '0')}</span>
						<span class="tech-cell__name text-mono-label">{tech.name}</span>
					</header>
					<!-- Icono -->
					<div class="tech-cell__media">
						<img class="tech-icon__svg tech-icon__svg--light" src={`/tech-icons/${tech.slug}-d.svg`} alt={tech.name} loading="lazy" draggable={false} />
						<img class="tech-icon__svg tech-icon__svg--dark" src={`/tech-icons/${tech.slug}-l.svg`} alt={tech.name} loading="lazy" draggable={false} />
					</div>
				</article>
			))}
		</div>

		<!-- Cursor custom (← →) -->
		<div class="tech-cursor" data-tech-cursor aria-hidden="true">
			<div class="tech-cursor__inner">
				<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M18 8L22 12L18 16"/>
					<path d="M6 8L2 12L6 16"/>
					<line x1="2" y1="12" x2="22" y2="12"/>
				</svg>
			</div>
		</div>
	</div>

	<!-- Pie de sección (fijo, no scrollea con el carrusel) -->
	<div class="tech-foot px-4 md:px-10">
		<span class="tech-foot__meta text-mono-label">{t.techStack.footMeta.replace('{count}', String(techs.length))}</span>
		<a href={experiencePath} class="tech-foot__note text-mono-label uppercase" data-reveal data-reveal-radius="24px">
			<span class="tech-foot__base">--{t.techStack.footNote}</span>
			<span class="tech-foot__reveal reveal-layer" aria-hidden="true">--{t.techStack.footNote}:</span>
		</a>
	</div>

</section>

<style lang="scss">
	.tech-head {
		margin-bottom: 2.5rem;
	}

	.tech-title {
		font-size: clamp(35px, 8vw, 80px);
		line-height: 1;
	}

	// ─── Tabs en celdas (fila fija, no scrollea con el carrusel) ───
	// Pegada justo encima de la fila de cabeceras del carrusel.
	.tech-tabs {
		display: flex;
		width: fit-content;
		// Borde superior solo bajo las celdas de tabs (no hasta el final)
		border-top: 1px solid var(--secondary);
	}

	.tech-tab {
		flex: 0 0 auto;
		background: none;
		border: none;
		border-right: 1px solid var(--secondary);
		padding: 0.75rem 1.25rem;
		cursor: pointer;
		color: var(--secondary);
		white-space: nowrap;
		transition:
			background-color 300ms cubic-bezier(0.22, 1, 0.36, 1),
			color 300ms cubic-bezier(0.22, 1, 0.36, 1);

		&:hover { background-color: var(--terciary); }

		// Activo: colores del tema invertidos (sólido)
		&.is-active {
			background-color: var(--secondary);
			color: var(--primary);
		}
	}

	// ─── Carrusel: wrapper con cursor custom ───
	.tech-carousel-wrap {
		position: relative;

		// Cursor nativo oculto solo si hay scroll (lo sustituye el custom)
		@media (hover: hover) and (pointer: fine) {
			&.is-scrollable { cursor: none; }
		}
	}

	.tech-carousel {
		display: flex;
		overflow-x: auto;
		// Marco superior/inferior que cierra la fila (estética catálogo)
		border-top: 1px solid var(--secondary);
		border-bottom: 1px solid var(--secondary);

		// Scrollbar oculta (la navegación es por drag)
		scrollbar-width: none;
		-ms-overflow-style: none;
		&::-webkit-scrollbar { display: none; }

		// Mientras se arrastra, sin selección de texto/imágenes
		&.is-dragging {
			cursor: none;
			user-select: none;
		}
	}

	// ─── Celda ───
	// Ancho fijo en variable (~4.5 celdas visibles → la 5ª queda cortada).
	.tech-cell {
		--cell-w: clamp(200px, 22vw, 300px);
		flex: 0 0 auto;
		width: var(--cell-w);
		display: flex;
		flex-direction: column;
		border-right: 1px solid var(--secondary);
		overflow: hidden;

		// Animación de contraer/expandir (transform → sin reflow del flex).
		transform-origin: center;
		transition:
			transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 240ms cubic-bezier(0.22, 1, 0.36, 1);

		@media (max-width: 767px) {
			--cell-w: 64vw;
		}

		// Contenido con ancho fijo (no se reajusta durante la animación)
		.tech-cell__head,
		.tech-cell__media {
			width: var(--cell-w);
		}

		// Fase 1 — contraída (salida) o estado inicial antes de expandir (entrada)
		&.is-collapsed {
			transform: scale(0.85);
			opacity: 0;
		}

		// Fase 2 — fuera del flujo (instantáneo, sin animar ancho)
		&.is-gone {
			display: none;
		}
	}

	.tech-cell__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--secondary);
	}

	.tech-cell__no {
		opacity: 0.5;
	}

	// ─── Media (icono centrado con aire) ───
	.tech-cell__media {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 3 / 4;
		padding: 2.5rem;

		// Móvil: celda menos alta + menos padding
		@media (max-width: 767px) {
			aspect-ratio: 1 / 1;
			padding: 1.5rem;
		}
	}

	.tech-icon__svg {
		width: clamp(56px, 7vw, 90px);
		height: clamp(56px, 7vw, 90px);
		object-fit: contain;

		// Móvil: iconos más grandes
		@media (max-width: 767px) {
			width: 80px;
			height: 80px;
		}

		&--dark { display: none; }
	}

	:global(.dark) {
		.tech-icon__svg--light { display: none; }
		.tech-icon__svg--dark { display: block; }
	}

	// ─── Cursor custom (← →) ───
	.tech-cursor {
		position: absolute;
		top: 0;
		left: 0;
		pointer-events: none;
		opacity: 0;
		transform: translate(-50%, -50%) scale(0.6);
		transition:
			opacity 400ms cubic-bezier(0.16, 1, 0.3, 1),
			transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 10;
		will-change: left, top;

		// Solo en dispositivos con puntero fino (desktop)
		@media (hover: none), (pointer: coarse) { display: none; }
	}

	.tech-carousel-wrap.is-scrollable:hover .tech-cursor {
		opacity: 1;
		transform: translate(-50%, -50%) scale(1);
	}

	.tech-cursor__inner {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: var(--secondary);
		color: var(--primary);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	// ─── Pie de sección ───
	.tech-foot {
		margin-top: 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.tech-foot__meta {
		opacity: 0.55;
	}

	// Nota con circle-reveal (clon de colores invertidos)
	.tech-foot__note {
		--reveal-extend: 24px;
		position: relative;
		color: var(--secondary);
		text-decoration: none;
		white-space: nowrap;
	}

	.tech-foot__reveal {
		display: block;
		padding: var(--reveal-extend);
		background: var(--secondary);
		color: var(--primary);
		white-space: nowrap;
	}
</style>

<script>
	const wrap = document.querySelector<HTMLElement>('[data-tech-carousel]');
	const track = document.querySelector<HTMLElement>('[data-tech-track]');
	const cursor = document.querySelector<HTMLElement>('[data-tech-cursor]');
	if (wrap && track && cursor) {
		// ── Cursor custom con lerp ──
		let cx = 0, cy = 0, tx = 0, ty = 0, raf: number | null = null;
		function tick() {
			cx += (tx - cx) * 0.18;
			cy += (ty - cy) * 0.18;
			cursor!.style.left = `${cx}px`;
			cursor!.style.top = `${cy}px`;
			if (Math.abs(cx - tx) > 0.3 || Math.abs(cy - ty) > 0.3) {
				raf = requestAnimationFrame(tick);
			} else { raf = null; }
		}
		wrap.addEventListener('mousemove', (e) => {
			const rect = wrap.getBoundingClientRect();
			tx = e.clientX - rect.left;
			ty = e.clientY - rect.top;
			if (!raf) raf = requestAnimationFrame(tick);
		});

		// ── Solo activar drag/cursor si el carrusel se puede scrollear ──
		const wrapEl = wrap, trackEl2 = track;
		function updateScrollable() {
			const scrollable = trackEl2.scrollWidth - trackEl2.clientWidth > 1;
			wrapEl.classList.toggle('is-scrollable', scrollable);
		}
		updateScrollable();
		window.addEventListener('resize', updateScrollable, { passive: true });

		// ── Drag para scrollear ──
		let isDown = false, startX = 0, startScroll = 0, moved = false;

		track.addEventListener('mousedown', (e) => {
			if (!wrapEl.classList.contains('is-scrollable')) return; // sin scroll, sin drag
			isDown = true;
			moved = false;
			startX = e.pageX;
			startScroll = track.scrollLeft;
			track.classList.add('is-dragging');
		});
		window.addEventListener('mousemove', (e) => {
			if (!isDown) return;
			const dx = e.pageX - startX;
			if (Math.abs(dx) > 3) moved = true;
			track.scrollLeft = startScroll - dx;
		});
		window.addEventListener('mouseup', () => {
			if (!isDown) return;
			isDown = false;
			track.classList.remove('is-dragging');
		});
		// Evita que un drag dispare clics/navegación accidental
		track.addEventListener('click', (e) => {
			if (moved) { e.preventDefault(); e.stopPropagation(); }
		}, true);

		// ── Filtrado por categoría (coreografía contraer → filtrar → expandir) ──
		const trackEl = track; // referencia no-nula para usar dentro de funciones
		const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tech-filter]'));
		const cells = Array.from(trackEl.querySelectorAll<HTMLElement>('.tech-cell'));
		const OUT_MS = 240; // debe coincidir con la transición de opacity de salida
		let filtering = false;
		let currentCat = 'all';

		const STEP = 35;        // ms de desfase entre celdas (stagger)
		const MAX_STAGGER = 5;  // tope de celdas que escalonan → desfase total acotado

		// El delay se acota: las celdas más allá de MAX_STAGGER comparten el último delay,
		// así el tiempo total no escala con 18 celdas (evita el parón en blanco).
		const stagger = (i: number) => Math.min(i, MAX_STAGGER) * STEP;
		const total = (n: number) => OUT_MS + Math.min(Math.max(0, n - 1), MAX_STAGGER) * STEP;

		function applyFilter(cat: string) {
			if (filtering || cat === currentCat) return;
			filtering = true;
			currentCat = cat;

			const matches = (cell: HTMLElement) => cat === 'all' || cell.dataset.cat === cat;

			// Fase 1: recogida escalonada de izquierda a derecha
			const visible = cells.filter((c) => !c.classList.contains('is-gone'));
			visible.forEach((cell, i) => {
				cell.style.transitionDelay = `${stagger(i)}ms`;
				cell.classList.add('is-collapsed');
			});

			setTimeout(() => {
				// Fase 2: reordenar visibilidad (instantáneo, todo invisible)
				cells.forEach((cell) => {
					cell.style.transitionDelay = '';
					if (matches(cell)) {
						cell.classList.remove('is-gone');
						cell.classList.add('is-collapsed');
					} else {
						cell.classList.add('is-gone');
					}
				});

				trackEl.scrollLeft = 0;

				// Fase 3: expansión escalonada de izquierda a derecha
				const entering = cells.filter(matches);
				requestAnimationFrame(() => {
					requestAnimationFrame(() => {
						entering.forEach((cell, i) => {
							cell.style.transitionDelay = `${stagger(i)}ms`;
							cell.classList.remove('is-collapsed');
						});
						// Libera el guard tras la última entrada
						setTimeout(() => {
							entering.forEach((cell) => { cell.style.transitionDelay = ''; });
							filtering = false;
							updateScrollable(); // recalcula si sigue habiendo scroll
						}, total(entering.length));
					});
				});
			}, total(visible.length));
		}

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const cat = tab.dataset.techFilter || 'all';
				tabs.forEach((t) => {
					const active = t === tab;
					t.classList.toggle('is-active', active);
					t.setAttribute('aria-selected', String(active));
				});
				applyFilter(cat);
			});
		});
	}

	// Circle-reveal para la nota del pie
	import '../scripts/circle-reveal.ts';
</script>
