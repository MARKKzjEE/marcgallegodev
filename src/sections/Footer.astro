---
import { getLang, useTranslations, getLocalePath } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const navItems = [
	{ label: t.footer.navExperience, href: getLocalePath(lang, '/experience') },
	{ label: t.footer.navProjects, href: getLocalePath(lang, '/projects') },
	{ label: t.footer.navContact, href: getLocalePath(lang, '/contact') },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer-section px-4 md:px-6 border-b border-secondary" data-reveal data-reveal-radius="32px">
	<!-- Capa base -->
	<div class="footer-base">
		<div class="footer-top">
			<h2 class="footer-title font-monoblock text-secondary tracking-[-0.05em] leading-12" data-reveal-trigger>{t.footer.headline}</h2>
			<div class="footer-contact">
				<a href="https://linkedin.com/in/marcgallegodev" target="_blank" rel="noopener noreferrer" class="footer-contact-link text-mono-label-soft text-[clamp(10px,1vw,14px)]" data-reveal-trigger>{t.footer.linkedinLabel}</a>
				<!-- Teléfono y email se rellenan en cliente (ver script): fuera del HTML para evitar scrapers -->
				<a class="footer-contact-link text-mono-label-soft text-[clamp(10px,1vw,14px)]" data-contact="tel" data-reveal-trigger hidden></a>
				<a class="footer-contact-link text-mono-label-soft text-[clamp(10px,1vw,14px)]" data-contact="email" data-reveal-trigger hidden></a>
			</div>
		</div>
		<nav class="footer-nav" aria-label={t.footer.navLabel}>
			{navItems.map((item) => (
				<a href={item.href} class="footer-nav-link text-mono-label text-[clamp(14px,1.5vw,16px)]" data-reveal-trigger>
					{item.label}
				</a>
			))}
		</nav>
		<div class="footer-bottom">
			<span class="footer-copyright text-mono-label-soft text-[clamp(10px,1vw,14px)]" data-reveal-trigger><span class="text-[1.3em] leading-none">&copy;</span>{currentYear} Marc Gallego<span class="footer-rights">. {t.footer.copyright}</span></span>
			<button type="button" class="footer-scroll-top text-mono-label-soft text-[clamp(10px,1vw,14px)]" aria-label={t.footer.scrollTop} data-scroll-top data-reveal-trigger>
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
				<span class="footer-scroll-label">{t.footer.scrollTop}</span>
			</button>
		</div>
	</div>

	<!-- Capa reveal (clon visual) -->
	<div class="footer-reveal reveal-layer" aria-hidden="true">
		<div class="footer-top">
			<h2 class="footer-title font-monoblock tracking-[-0.05em] leading-12">{t.footer.headlineReveal}</h2>
			<div class="footer-contact">
				<a href="https://linkedin.com/in/marcgallegodev" target="_blank" rel="noopener noreferrer" class="footer-contact-link text-mono-label-soft text-[clamp(10px,1vw,14px)]" tabindex="-1">{t.footer.linkedinLabel}</a>
				<a class="footer-contact-link text-mono-label-soft text-[clamp(10px,1vw,14px)]" data-contact="tel" tabindex="-1" hidden></a>
				<a class="footer-contact-link text-mono-label-soft text-[clamp(10px,1vw,14px)]" data-contact="email" tabindex="-1" hidden></a>
			</div>
		</div>
		<nav class="footer-nav">
			{navItems.map((item) => (
				<a href={item.href} class="footer-nav-link text-mono-label text-[clamp(14px,1.5vw,16px)]" tabindex="-1">
					{item.label}
				</a>
			))}
		</nav>
		<div class="footer-bottom">
			<span class="footer-copyright text-mono-label-soft text-[clamp(10px,1vw,14px)]"><span class="text-[1.3em] leading-none">&copy;</span>{currentYear} Marc Gallego<span class="footer-rights">. {t.footer.copyright}</span></span>
			<button class="footer-scroll-top text-mono-label-soft text-[clamp(10px,1vw,14px)]" tabindex="-1">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
				<span class="footer-scroll-label">{t.footer.scrollTop}</span>
			</button>
		</div>
	</div>
</footer>

<style lang="scss">
	.footer-section {
		--reveal-extend: 50px;
		position: relative;
		padding-top: 150px;

		@media (max-width: 767px) {
			padding-top: 64px;
		}
		padding-bottom: 24px;
		overflow: clip;
		border-top: 1px solid var(--secondary);
		background-color: var(--terciary);
	}

	// ── Zona superior ──
	.footer-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		padding-bottom: 48px;
	}

	.footer-title {
		font-size: clamp(40px, 6vw, 72px);
	}

	.footer-contact {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 4px;
	}

	.footer-contact-link,
	.footer-nav-link {
		text-decoration: none;
	}

	.footer-nav-link {
		text-transform: capitalize;
	}

	// ── Navegación ──
	.footer-nav {
		display: flex;
		justify-content: space-between;
		padding: 20px 0;
		border-top: 1px solid var(--secondary);
		border-bottom: 1px solid var(--secondary);
	}

	// ── Copyright ──
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 24px;
	}

	.footer-scroll-top {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		display: flex;
		align-items: center;
		gap: 6px;
	}

	// ── Reveal layer ──
	.footer-reveal {
		background: var(--secondary);
		padding: calc(150px + var(--reveal-extend)) calc(24px + var(--reveal-extend)) calc(24px + var(--reveal-extend));

		@media (max-width: 767px) {
			padding-top: calc(64px + var(--reveal-extend));
			padding-left: calc(1rem + var(--reveal-extend));
			padding-right: calc(1rem + var(--reveal-extend));
		}

		// Invertir todos los colores
		&, * {
			color: var(--primary) !important;
		}

		.footer-nav {
			border-color: var(--primary);
		}
	}

	:global(.dark) .footer-reveal {
		background: var(--secondary);

		&, * {
			color: var(--primary) !important;
		}

		.footer-nav {
			border-color: var(--primary);
		}
	}

	// ── Mobile ──
	@media (max-width: 767px) {
		.footer-top {
			flex-direction: column;
			align-items: stretch;
			gap: 16px;
			padding-bottom: 32px;
		}

		.footer-title {
			width: 100%;
		}

		.footer-contact {
			flex-direction: column;
			align-items: flex-end;
			gap: 12px;
		}

		.footer-nav {
			flex-direction: row;
			justify-content: space-between;
			padding: 16px 0;
		}

		.footer-bottom {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}

		.footer-rights,
		.footer-scroll-label {
			display: none;
		}
	}

</style>

<script>
	import '../scripts/circle-reveal.ts';

	document.querySelector('[data-scroll-top]')?.addEventListener('click', () => {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
	});

	// ─── Teléfono y email ───
	// No van en claro en el HTML (los scrapers de spam buscan patrones tipo
	// usuario@dominio o tel:+34...). Se montan aquí, en capa base y en el clon del reveal.
	const MAIL = ['mark.gallego.gines', 'gmail.com'];
	const TEL_REVERSED = '84040674643+';
	const email = MAIL.join('@');
	const tel = [...TEL_REVERSED].reverse().join('');
	const telLabel = tel.replace(/^(\+\d{2})(\d{3})(\d{2})(\d{2})(\d{2})$/, '$1 $2 $3 $4 $5');

	document.querySelectorAll<HTMLAnchorElement>('[data-contact]').forEach((link) => {
		const isMail = link.dataset.contact === 'email';
		link.href = isMail ? `mailto:${email}` : `tel:${tel}`;
		link.textContent = isMail ? email : telLabel;
		link.hidden = false;
	});
</script>
