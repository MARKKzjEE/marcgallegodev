---
import { getLang, useTranslations, getLocalePath } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const navItems = [
	{ label: t.footer.navExperience, href: getLocalePath(lang, '/experience') },
	{ label: t.footer.navProjects, href: getLocalePath(lang, '/projects') },
	{ label: t.footer.navContact, href: getLocalePath(lang, '/contact') },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer-section bg-primary px-4 md:px-6" data-reveal data-reveal-radius="32px">
	<!-- Capa base -->
	<div class="footer-base">
		<div class="footer-top">
			<h2 class="footer-title font-vogun text-secondary" data-reveal-trigger>{t.footer.headline}</h2>
			<div class="footer-contact">
				<a href="https://linkedin.com/in/marcgallegodev" target="_blank" rel="noopener noreferrer" class="footer-contact-link font-nord font-light" data-reveal-trigger>{t.footer.linkedinLabel}</a>
				<a href="tel:+34647604048" class="footer-contact-link font-nord font-light" data-reveal-trigger>+34 647 60 40 48</a>
				<a href="mailto:mark.gallego.gines@gmail.com" class="footer-contact-link font-nord font-light" data-reveal-trigger>mark.gallego.gines@gmail.com</a>
			</div>
		</div>
		<nav class="footer-nav" aria-label="Navegación del footer">
			{navItems.map((item) => (
				<a href={item.href} class="footer-nav-link font-nord" data-reveal-trigger>
					{item.label}
				</a>
			))}
		</nav>
		<div class="footer-bottom">
			<span class="footer-copyright font-nord font-light opacity-90" data-reveal-trigger>&copy;{currentYear} Marc Gallego. {t.footer.copyright}</span>
			<button class="footer-scroll-top font-nord font-light" data-scroll-top data-reveal-trigger>
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6L12 2L16 6"/><path d="M12 2V22"/></svg>
				{t.footer.scrollTop}
			</button>
		</div>
	</div>

	<!-- Capa reveal (clon visual) -->
	<div class="footer-reveal reveal-layer" aria-hidden="true">
		<div class="footer-top">
			<h2 class="footer-title font-vogun">{t.footer.headlineReveal}</h2>
			<div class="footer-contact">
				<a href="https://linkedin.com/in/marcgallegodev" target="_blank" rel="noopener noreferrer" class="footer-contact-link font-nord font-light" tabindex="-1">{t.footer.linkedinLabel}</a>
				<a href="tel:+34647604048" class="footer-contact-link font-nord font-light" tabindex="-1">+34 647 60 40 48</a>
				<a href="mailto:mark.gallego.gines@gmail.com" class="footer-contact-link font-nord font-light" tabindex="-1">mark.gallego.gines@gmail.com</a>
			</div>
		</div>
		<nav class="footer-nav">
			{navItems.map((item) => (
				<a href={item.href} class="footer-nav-link font-nord font-light" tabindex="-1">
					{item.label}
				</a>
			))}
		</nav>
		<div class="footer-bottom">
			<span class="footer-copyright font-nord font-light opacity-90">&copy;{currentYear} Marc Gallego. {t.footer.copyright}</span>
			<button class="footer-scroll-top font-nord font-light" tabindex="-1">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6L12 2L16 6"/><path d="M12 2V22"/></svg>
				{t.footer.scrollTop}
			</button>
		</div>
	</div>
</footer>

<style lang="scss">
	.footer-section {
		--reveal-extend: 50px;
		position: relative;
		padding-top: 150px;

		@media (max-width: 767px) {
			padding-top: 64px;
		}
		padding-bottom: 24px;
		overflow: clip;
		border-top: 1px solid var(--secondary);
		background-color: var(--quaternary);
	}

	// ── Zona superior ──
	.footer-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		padding-bottom: 48px;
	}

	.footer-title {
		font-size: clamp(3rem, 8vw, 5.5rem);
	}

	.footer-contact {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 4px;
	}

	.footer-contact-link {
		text-decoration: none;
	}

	// ── Navegación ──
	.footer-nav {
		display: flex;
		justify-content: space-between;
		padding: 20px 0;
		border-top: 1px solid var(--secondary);
		border-bottom: 1px solid var(--secondary);
	}

	.footer-nav-link {
		font-size: 14px;
		color: var(--secondary);
		text-decoration: none;
		text-transform: capitalize;
	}

	// ── Copyright ──
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 24px;
	}

	.footer-copyright,
	.footer-scroll-top,
	.footer-contact-link {
		font-size: 12px;
		color: var(--secondary);
	}

	.footer-scroll-top {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		display: flex;
		align-items: center;
		gap: 6px;
	}

	// ── Reveal layer ──
	.footer-reveal {
		background: var(--secondary);
		color: var(--primary);
		padding: calc(150px + var(--reveal-extend)) calc(24px + var(--reveal-extend)) calc(24px + var(--reveal-extend));

		.footer-title {
			color: var(--primary);
		}

		.footer-nav {
			border-color: var(--primary);
		}

		.footer-nav-link {
			color: var(--primary);
		}

		.footer-copyright,
		.footer-scroll-top {
			color: var(--primary);
		}

		.footer-contact-link {
			color: var(--primary);
		}
	}

	// ── Dark ──
	:global(.dark) .footer-section {
		background-color: #161616;
	}

	:global(.dark) {
		.footer-nav {
			border-color: var(--secondary);
		}

		.footer-reveal {
			background: var(--secondary);

			.footer-title,
			.footer-nav-link,
			.footer-copyright,
			.footer-scroll-top,
			.footer-contact-link {
				color: var(--primary);
			}

			.footer-nav {
				border-color: var(--primary);
			}
		}
	}

	// ── Mobile ──
	@media (max-width: 767px) {
		.footer-top {
			flex-direction: column;
			align-items: stretch;
			gap: 16px;
			padding-bottom: 32px;
		}

		.footer-title {
			width: 100%;
		}

		.footer-contact {
			flex-direction: column;
			align-items: flex-end;
			gap: 4px;
		}

		.footer-nav {
			flex-direction: row;
			justify-content: space-between;
			padding: 16px 0;
		}

		.footer-nav-link {
			font-size: 11px;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
		}

		.footer-copyright {
			font-size: 10px;
		}

		.footer-scroll-top {
			display: none;
		}
	}

</style>

<script>
	import '../scripts/circle-reveal.ts';

	document.querySelector('[data-scroll-top]')?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});
</script>
