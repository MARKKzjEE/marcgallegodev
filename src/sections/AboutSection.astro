---
import { Image } from 'astro:assets';
import profileLight from '../assets/me/hero-profile-light.png';
import profileDark from '../assets/me/hero-profile-dark.png';
import { getLang, useTranslations } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="about-section border-t border-secondary">

	<!-- ─── Desktop ─── -->
	<div class="about-frame hidden md:block">

		<!-- Fila título -->
		<div class="about-row about-row--header">
			<div class="about-cell about-cell--title border-b border-secondary px-10 py-5">
				<h2 class="about-title font-nord font-normal text-secondary">{t.about.title}</h2>
			</div>
			<div class="about-cell about-cell--sidebar-header border-b border-secondary"></div>
		</div>

		<!-- Fila contenido -->
		<div class="about-row about-row--content">
			<div class="about-cell about-cell--body px-10 py-8">
				<div class="about-cols">
					<div class="about-col">
						<p class="text-cottor-body leading-8" set:html={t.about.bioDesktop1.replace(/\n\n/g, '<br><br>')} />
					</div>
					<div class="about-col">
						<p class="text-cottor-body leading-8" set:html={t.about.bioDesktop2.replace(/\n\n/g, '<br><br>')} />
					</div>
				</div>
				<div data-parallax-wrap class="about-image rounded-lg overflow-hidden">
					<Image src={profileDark} alt={t.about.profileAlt} widths={[600, 900]} sizes="(max-width: 1400px) 600px, 900px" format="webp" quality={92} loading="lazy" class="about-profile-img h-full w-full object-cover object-center dark:hidden" />
					<Image src={profileLight} alt={t.about.profileAlt} widths={[600, 900]} sizes="(max-width: 1400px) 600px, 900px" format="webp" quality={92} loading="lazy" class="about-profile-img hidden h-full w-full object-cover object-center dark:block" />
				</div>
			</div>
			<div class="about-cell about-cell--sidebar border-l border-secondary">
				<p class="font-monoblock font-medium text-secondary text-[10px] [writing-mode:vertical-rl] rotate-180 whitespace-nowrap uppercase">{t.about.tagline} <span class="inline-block rotate-90">™</span></p>
			</div>
		</div>

		<!-- Borde inferior -->
		<div class="border-b border-secondary"></div>

	</div>

	<!-- ─── Mobile ─── -->
	<div class="about-mobile md:hidden">
		<div class="px-4 py-4 border-b border-secondary">
			<h2 class="about-title font-nord font-normal text-secondary">{t.about.title}</h2>
		</div>
		<div class="px-4 py-6">
			<div class="about-photo rounded-lg overflow-hidden">
				<Image src={profileDark} alt={t.about.profileAlt} widths={[600]} sizes="100vw" format="webp" quality={92} loading="lazy" class="w-full object-cover object-center dark:hidden" />
				<Image src={profileLight} alt={t.about.profileAlt} widths={[600]} sizes="100vw" format="webp" quality={92} loading="lazy" class="hidden w-full object-cover object-center dark:block" />
			</div>
			<p class="text-cottor-body mt-6 leading-6">
				{t.about.bioMobile}
			</p>
		</div>
		<div class="border-b border-secondary"></div>
	</div>

</section>

<style lang="scss">
	.about-section {
		position: relative;
		width: 100%;
		background-color: var(--primary);
	}

	.about-title {
		font-size: clamp(35px, 8vw, 80px);
		line-height: 1;
	}

	// ── Desktop frame (celdas con bordes) ──
	.about-row {
		display: flex;
	}

	.about-cell--title {
		flex: 1;
	}

	.about-cell--sidebar-header {
		width: 40px;
		flex-shrink: 0;
	}

	.about-cell--body {
		flex: 1;
		display: flex;
		gap: 2rem;
		align-items: stretch;
	}

	.about-cell--sidebar {
		width: 40px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	// ── Texto bio más grande que el body estándar ──
	.about-cols .text-cottor-body {
		font-size: clamp(14px, 1.2vw, 17px);
		text-align: justify;
		hyphens: auto;
		-webkit-hyphens: auto;
		word-break: break-word;
	}

	// ── Columnas de texto ──
	.about-cols {
		flex: 2;
		display: flex;
		gap: 2rem;
	}

	.about-col {
		flex: 1;
		display: flex;
		align-items: flex-start;
	}

	.about-col:last-child {
		align-items: flex-end;
	}

	.about-image {
		flex: 1;
		max-height: 600px;
		min-height: 400px;

		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}

	// ── Mobile ──
	.about-photo {
		width: 100%;
		min-height: 500px;

		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}
</style>

<script>
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const section = document.getElementById('about');
		const wrap = section?.querySelector<HTMLElement>('[data-parallax-wrap]');
		if (wrap) {
			const imgs = wrap.querySelectorAll<HTMLImageElement>('img');
			imgs.forEach(img => {
				img.style.willChange = 'transform';
				img.style.transition = 'transform 0.8s cubic-bezier(0.22, 1, 0.36, 1)';
			});

			const update = () => {
				const rect = wrap.getBoundingClientRect();
				const vh = window.innerHeight;
				const progress = 1 - (rect.bottom / (vh + rect.height));
				const clamped = Math.max(0, Math.min(1, progress));
				const scale = 1.0 + 0.15 * Math.abs(clamped * 2 - 1);
				imgs.forEach(img => { img.style.transform = `scale(${scale})`; });
			};

			let ticking = false;
			window.addEventListener('scroll', () => {
				if (!ticking) { ticking = true; requestAnimationFrame(() => { update(); ticking = false; }); }
			}, { passive: true });
			update();
		}
	}
</script>
