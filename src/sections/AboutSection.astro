---
import { Image } from 'astro:assets';
import AboutContent from '../components/AboutContent.astro';
import gradientBg from '../assets/gradients/fqm-gradient.png';
import gradientBgDark from '../assets/gradients/fqm-gradient-dark.png';
---

<section id="about" class="about-section border-t border-secondary">
	<Image src={gradientBg} alt="" class="about-section__bg dark:opacity-0 transition-opacity duration-500" quality={80} loading="lazy" aria-hidden="true" />
	<Image src={gradientBgDark} alt="" class="about-section__bg opacity-0 dark:opacity-100 transition-opacity duration-500" quality={80} loading="lazy" aria-hidden="true" />
	<div class="about-section__content">
		<AboutContent />
	</div>
</section>

<style lang="scss">
	.about-section {
		position: relative;
		width: 100%;
		margin-top: 96px;
		background-color: var(--primary);
	}

	.about-section__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
		z-index: 0;
		pointer-events: none;
	}

	:global(.dark) .about-section__bg.dark\:opacity-100 {
		filter: brightness(0.5);
	}

	.about-section__content {
		position: relative;
		z-index: 1;
	}
</style>

<script>
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const section = document.getElementById('about');
		const wrap = section?.querySelector<HTMLElement>('[data-parallax-wrap]');
		if (wrap) {
			const imgs = wrap.querySelectorAll<HTMLImageElement>('img');
			imgs.forEach(img => {
				img.style.willChange = 'transform';
				img.style.transition = 'transform 0.8s cubic-bezier(0.22, 1, 0.36, 1)';
			});

			const update = () => {
				const rect = wrap.getBoundingClientRect();
				const vh = window.innerHeight;
				const progress = 1 - (rect.bottom / (vh + rect.height));
				const clamped = Math.max(0, Math.min(1, progress));
				const scale = 1.0 + 0.15 * Math.abs(clamped * 2 - 1);
				imgs.forEach(img => { img.style.transform = `scale(${scale})`; });
			};

			let ticking = false;
			window.addEventListener('scroll', () => {
				if (!ticking) { ticking = true; requestAnimationFrame(() => { update(); ticking = false; }); }
			}, { passive: true });
			update();
		}
	}
</script>
