---
import { getLang, useTranslations } from '../i18n/index';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const paragraphs = t.whatWeDo.text.split('\n\n').map((p: string) => p.split(' '));
let wordOffset = 0;
const paragraphsWithIndex = paragraphs.map((words: string[]) => {
	const result = words.map((word: string, i: number) => ({ word, index: wordOffset + i }));
	wordOffset += words.length;
	return result;
});
---

<section id="what-we-do" class="what-we-do py-16 md:py-24" aria-labelledby="what-we-do-heading">
	<div class="px-4 md:px-10">
		<div class="grid md:grid-cols-[320px_1fr] gap-8 md:gap-16 items-start">

			<!-- Label izquierda -->
			<h2 id="what-we-do-heading" class="what-we-do__label font-nord text-secondary uppercase tracking-widest">{t.whatWeDo.label}</h2>

			<!-- Texto con reveal por palabra -->
			<div class="what-we-do__content" data-scroll-reveal>
				{paragraphsWithIndex.map((words) => (
					<p class="what-we-do__text font-cottor font-light leading-[1.15] text-justify mb-8">
						{words.map(({ word, index }) => (
							<span class="reveal-word" style={`--word-index: ${index}`}>{word} </span>
						))}
					</p>
				))}
			</div>

		</div>
	</div>
</section>

<style lang="scss">
	.what-we-do__text {
		font-size: clamp(28px, 4vw, 52px);
	}

	.what-we-do__label {
		font-size: clamp(12px, 1.2vw, 18px);
	}

	.reveal-word {
		color: color-mix(in srgb, var(--secondary) 20%, transparent);
		transition: color 0.3s ease;
	}

	.reveal-word.is-visible {
		color: var(--secondary);
	}
</style>

<script>
	function initScrollReveal() {
		const container = document.querySelector<HTMLElement>('[data-scroll-reveal]');
		if (!container) return;

		const words = container.querySelectorAll<HTMLElement>('.reveal-word');
		const totalWords = words.length;

		function update() {
			const rect = container!.getBoundingClientRect();
			const viewH = window.innerHeight;

			// Progress: 0 when section enters bottom, 1 when section is centered
			const start = viewH * 1.0;
			const end = viewH * 0;
			const progress = Math.min(Math.max((start - rect.top) / (start - end), 0), 1);

			// Map progress to word index
			const revealCount = Math.floor(progress * totalWords);

			words.forEach((word, i) => {
				word.classList.toggle('is-visible', i < revealCount);
			});

		}

		let ticking = false;
		window.addEventListener('scroll', () => {
			if (!ticking) {
				requestAnimationFrame(() => {
					update();
					ticking = false;
				});
				ticking = true;
			}
		}, { passive: true });

		update();
	}

	initScrollReveal();
</script>
