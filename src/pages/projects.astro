---
import Layout from "../layouts/Layout.astro";
import Header from "../sections/Header.astro";
import Projects from "../sections/Projects.astro";
import Footer from "../sections/Footer.astro";
---

<Layout
	title="Proyectos | Marc Gallego — Desarrollador Full Stack Barcelona"
	description="Portfolio de proyectos de Marc Gallego: plataformas web, SaaS, apps móviles y soluciones digitales a medida desarrolladas en Barcelona."
	keywords="proyectos web Marc Gallego, portfolio desarrollador Barcelona, SaaS, plataformas web, apps móviles, desarrollo a medida"
>
	<Header />
	<script is:inline type="application/ld+json">{JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://marcgallego.com/" },
			{ "@type": "ListItem", "position": 2, "name": "Proyectos", "item": "https://marcgallego.com/projects/" }
		]
	})}</script>
	<main class="min-h-screen bg-primary pt-14">
		<Projects />
	</main>
	<Footer />
</Layout>
