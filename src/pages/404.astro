---
import Layout from '../layouts/Layout.astro';
import Header from '../sections/Header.astro';
import { useTranslations, getLocalePath } from '../i18n/index';

// Vercel sirve esta única 404 para cualquier URL. Se genera en español y,
// si la URL es /en/..., el script de abajo la pasa a inglés antes de pintar.
const es = useTranslations('es');
const en = useTranslations('en');

// Textos del Header ES → EN (mismas claves en ambos diccionarios)
const headerText = Object.fromEntries(
	Object.keys(es.header).map((key) => [es.header[key as keyof typeof es.header], en.header[key as keyof typeof en.header]])
);
// Rutas ES → EN de los links del Header
const headerHref = Object.fromEntries(
	['/', '/experience', '/projects', '/contact'].map((path) => [getLocalePath('es', path), getLocalePath('en', path)])
);
const enPage = { ...en.notFound, home: getLocalePath('en', '/') };
---

<Layout
	title={es.notFound.title}
	description={es.notFound.description}
	noindex
>
	<Header />
	<main class="notfound">
		<p class="notfound__code font-nord">404</p>
		<h1 class="notfound__title font-nord font-light text-secondary" data-404-title>{es.notFound.heading}</h1>
		<a href="/" class="notfound__link font-nord text-secondary" data-404-link>{es.notFound.backHome}</a>
	</main>

	<script is:inline define:vars={{ enPage, headerText, headerHref }}>
		if (location.pathname.startsWith('/en/') || location.pathname === '/en') {
			document.documentElement.lang = 'en';
			document.title = enPage.title;
			document.querySelector('meta[name="description"]')?.setAttribute('content', enPage.description);

			var title = document.querySelector('[data-404-title]');
			var link = document.querySelector('[data-404-link]');
			if (title) title.textContent = enPage.heading;
			if (link) {
				link.textContent = enPage.backHome;
				link.setAttribute('href', enPage.home);
			}

			var header = document.querySelector('[data-site-header]');
			if (header) {
				header.querySelectorAll('*').forEach(function (el) {
					var label = el.getAttribute('aria-label');
					if (label && headerText[label]) el.setAttribute('aria-label', headerText[label]);
					var href = el.getAttribute('href');
					if (href && headerHref[href] && !el.hasAttribute('hreflang')) el.setAttribute('href', headerHref[href]);
					if (el.children.length === 0 && headerText[el.textContent.trim()]) el.textContent = headerText[el.textContent.trim()];
				});
				// Selector de idioma: marcar EN como activo
				header.querySelectorAll('[hreflang]').forEach(function (el) {
					el.classList.toggle('lang-active', el.getAttribute('hreflang') === 'en');
				});
			}
		}
	</script>
</Layout>

<style lang="scss">
	.notfound {
		min-height: calc(100vh - 56px);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		padding: 2rem;
		text-align: center;
	}

	.notfound__code {
		font-size: clamp(80px, 15vw, 160px);
		font-weight: 900;
		color: color-mix(in srgb, var(--secondary) 8%, transparent);
	}

	.notfound__title {
		font-size: clamp(28px, 4vw, 52px);
	}

	.notfound__link {
		font-size: 13px;
		font-weight: 500;

		opacity: 0.7; // ≥ 4.5:1 de contraste en texto pequeño
		transition: opacity 300ms;
		&:hover { opacity: 1; }
	}
</style>
