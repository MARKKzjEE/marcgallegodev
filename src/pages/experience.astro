---
import Layout from "../layouts/Layout.astro";
import Header from "../sections/Header.astro";
import Footer from "../sections/Footer.astro";
import { Image } from 'astro:assets';
import imgDoko from '../assets/clients/dokostudio.png';
import imgLateua from '../assets/clients/lateua.png';
import imgLoyic from '../assets/clients/loyic.png';
import imgSociallabs from '../assets/clients/sociallabs.png';
import imgUab from '../assets/clients/uab.png';
import imgPlanit from '../assets/clients/planit.png';
import { useTranslations } from '../i18n/index';

const t = useTranslations('es');
const exp = t.experience;
const jobImgs = [imgDoko, imgLateua, imgLoyic, imgSociallabs];
---

<Layout
	title={t.meta.experienceTitle}
	description={t.meta.experienceDescription}
	keywords={t.meta.experienceKeywords}
>
	<Header />
	<script is:inline type="application/ld+json">{JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://marcgallegodev.com/" },
			{ "@type": "ListItem", "position": 2, "name": "Experiencia", "item": "https://marcgallegodev.com/experience/" }
		]
	})}</script>
	<script is:inline type="application/ld+json">{JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Person",
		"name": "Marc Gallego",
		"url": "https://marcgallegodev.com",
		"jobTitle": "Full Stack Software Engineer",
		"worksFor": { "@type": "Organization", "name": "Doko Studio" },
		"alumniOf": { "@type": "EducationalOrganization", "name": "Universitat Autònoma de Barcelona" },
		"knowsAbout": ["Laravel", "Django", "React", "Angular", "Node.js", "Docker", "CI/CD", "Astro", "TypeScript"],
		"hasCredential": {
			"@type": "EducationalOccupationalCredential",
			"name": "Grado en Ingeniería Informática",
			"credentialCategory": "degree",
			"recognizedBy": { "@type": "EducationalOrganization", "name": "Universitat Autònoma de Barcelona" }
		}
	})}</script>
	<main class="min-h-screen bg-primary pt-14">
		<div class="cv container mx-auto px-4 md:px-10 py-16 md:py-24">

			<!-- Título -->
			<div class="cv__name-row">
				<h1 class="cv__name font-vogun font-light text-secondary">{exp.pageTitle}</h1>
				<a href={exp.cvFile} download class="cv__download" aria-label={exp.downloadAriaLabel}>
					<svg class="cv__download-icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
					<span class="cv__download-label font-nord">{exp.downloadLabel}</span>
				</a>
			</div>

			<!-- Separador -->
			<hr class="cv__rule" />

			<!-- Resumen -->
			<section class="cv__section">
				<h2 class="cv__heading">{exp.sections.summary}</h2>
				<p class="cv__body">{exp.summary}</p>
			</section>

			<hr class="cv__rule" />

			<!-- Experiencia -->
			<section class="cv__section">
				<h2 class="cv__heading">{exp.sections.experience}</h2>
				{exp.jobs.map((job, i) => (
					<div class="cv__entry">
						<div class="cv__entry-icon">
							<Image class="cv__entry-img" src={jobImgs[i]} alt={job.logoAlt} />
							<div class="cv__entry-line"></div>
						</div>
						<div class="cv__entry-body">
							<div class="cv__entry-header">
								<div>
									<h3 class="cv__entry-title">{job.company}</h3>
									<p class="cv__entry-subtitle">{job.role}</p>
									<div class="cv__tags">
										{job.tags.map(tag => <span class="cv__tag">{tag}</span>)}
									</div>
								</div>
								<div class="cv__entry-meta">
									<span class="cv__entry-date">{job.period}</span>
									<span class="cv__entry-location">{job.location}</span>
								</div>
							</div>
							<ul class="cv__list">
								{job.bullets.map(b => <li>{b}</li>)}
							</ul>
						</div>
					</div>
				))}
			</section>

			<hr class="cv__rule" />

			<!-- Educación -->
			<section class="cv__section">
				<h2 class="cv__heading">{exp.sections.education}</h2>
				{exp.education.map(edu => (
					<div class="cv__entry">
						<div class="cv__entry-icon">
							<Image class="cv__entry-img" src={imgUab} alt={edu.logoAlt} />
						</div>
						<div class="cv__entry-body">
							<div class="cv__entry-header">
								<div>
									<h3 class="cv__entry-title">{edu.title}</h3>
									<p class="cv__entry-subtitle">{edu.subtitle}</p>
								</div>
								<div class="cv__entry-meta">
									<span class="cv__entry-date">{edu.period}</span>
									<span class="cv__entry-location">{edu.location}</span>
								</div>
							</div>
						</div>
					</div>
				))}
			</section>

			<hr class="cv__rule" />

			<!-- Idiomas -->
			<section class="cv__section">
				<h2 class="cv__heading">{exp.sections.languages}</h2>
				<div class="cv__tags">
					{exp.languages.map(l => <span class="cv__tag">{l}</span>)}
				</div>
			</section>

			<hr class="cv__rule" />

			<!-- Extracurricular -->
			<section class="cv__section">
				<h2 class="cv__heading">{exp.sections.extracurricular}</h2>
				{exp.extracurricular.map(item => (
					<div class="cv__entry">
						<div class="cv__entry-icon">
							<Image class="cv__entry-img" src={imgPlanit} alt={item.logoAlt} />
							<div class="cv__entry-line"></div>
						</div>
						<div class="cv__entry-body">
							<div class="cv__entry-header">
								<div>
									<h3 class="cv__entry-title">{item.company}</h3>
									<p class="cv__entry-subtitle">{item.role}</p>
								</div>
								<div class="cv__entry-meta">
									<span class="cv__entry-date">{item.period}</span>
									<span class="cv__entry-location">{item.location}</span>
								</div>
							</div>
							<ul class="cv__list">
								{item.bullets.map(b => <li>{b}</li>)}
							</ul>
						</div>
					</div>
				))}
			</section>

		</div>
	</main>
	<Footer />
</Layout>

<style lang="scss">
	.cv {
		color: var(--secondary);
		line-height: 1.6;
	}

	// ── Name row ──
	.cv__name-row {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 24px;
	}

	.cv__name {
		font-size: clamp(48px, 5vw, 80px);
		line-height: 1.1;
	}

	.cv__download {
		position: absolute;
		right: 0;
		top: 0;
		height: 100%;
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		gap: 4px;
		color: var(--secondary);
		text-decoration: none;
		transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
		&:hover {
			transform: scale(1.1);
		}

		@media (max-width: 767px) {
			position: fixed;
			right: 1.5rem;
			bottom: 1.5rem;
			top: auto;
			height: auto;
			background-color: color-mix(in srgb, var(--secondary) 10%, transparent);
			backdrop-filter: blur(20px) saturate(180%);
			-webkit-backdrop-filter: blur(20px) saturate(180%);
			border: 1px solid color-mix(in srgb, var(--secondary) 20%, transparent);
			color: var(--secondary);
			width: 52px;
			height: 52px;
			border-radius: 50%;
			justify-content: center;
			z-index: 30;
			box-shadow: 0 4px 24px color-mix(in srgb, var(--secondary) 10%, transparent);
		}
	}

	.cv__download-icon {
		width: 32px;
		height: 32px;

		@media (max-width: 767px) {
			width: 22px;
			height: 22px;
		}
	}

	.cv__download-label {
		font-size: 8px;
		text-transform: uppercase;
		letter-spacing: 0.05em;

		@media (max-width: 767px) {
			display: none;
		}
	}

	// ── Horizontal rule ──
	.cv__rule {
		border: none;
		border-top: 1px solid var(--secondary);
		margin: 0;
	}

	// ── Section ──
	.cv__section {
		padding: 24px 0;
	}

	.cv__heading {
		font-family: var(--font-nord);
		font-weight: 700;
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--secondary);
		margin-bottom: 20px;
	}

	// ── Body text ──
	.cv__body {
		font-family: var(--font-cottor);
		font-size: 16px;
		font-weight: 300;
		color: var(--secondary);
	}

	// ── Entry (job / education) ──
	.cv__entry {
		display: flex;
		gap: 20px;

		& + .cv__entry {
			margin-top: 28px;
		}

		@media (max-width: 767px) {
			gap: 12px;
		}
	}

	// ── Icon column (image + line) ──
	.cv__entry-icon {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex-shrink: 0;
	}

	.cv__entry-img {
		width: 64px;
		height: 64px;
		border-radius: 4px;
		border: 1px solid color-mix(in srgb, var(--secondary) 25%, transparent);
		flex-shrink: 0;
		object-fit: contain;

		@media (max-width: 767px) {
			width: 48px;
			height: 48px;
		}
	}

	.cv__entry-line {
		width: 1px;
		flex: 1;
		background-color: color-mix(in srgb, var(--secondary) 25%, transparent);
		margin-top: 8px;
	}

	// ── Entry body ──
	.cv__entry-body {
		flex: 1;
		min-width: 0;
	}

	.cv__entry-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		margin-bottom: 8px;

		@media (max-width: 600px) {
			flex-direction: column;
			gap: 10px;
		}
	}

	.cv__entry-title {
		font-family: var(--font-cottor);
		font-weight: 600;
		font-size: 20px;
		color: var(--secondary);
	}

	.cv__entry-subtitle {
		font-family: var(--font-monoblock);
		letter-spacing: 0.1em;
		font-weight: 400;
		font-size: 12px;
		//font-style: italic;
		color: var(--secondary);
		opacity: 0.8;
	}

	// ── Tech tags ──
	.cv__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 8px;
	}

	.cv__tag {
		font-family: var(--font-nord);
		font-weight: 500;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 3px 10px;
		border-radius: 4px;
		background-color: color-mix(in srgb, var(--secondary) 10%, transparent);
		color: var(--secondary);
		border: 1px solid color-mix(in srgb, var(--secondary) 20%, transparent);
	}

	.cv__entry-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		flex-shrink: 0;

		@media (max-width: 600px) {
			align-items: flex-start;
		}
	}

	.cv__entry-date {
		font-family: var(--font-nord);
		font-weight: 500;
		font-size: 13px;
		color: var(--secondary);
	}

	.cv__entry-location {
		font-family: var(--font-cottor);
		font-weight: 400;
		font-size: 14px;
		font-style: italic;
		color: var(--secondary);
		opacity: 0.7;
	}

	// ── Bullet list ──
	.cv__list {
		list-style: disc;
		padding-left: 20px;
		margin: 0;

		li {
			font-family: var(--font-cottor);
			font-size: 15px;
			font-weight: 300;
			color: var(--secondary);
			line-height: 1.7;
			padding: 1px 0;

			}
	}

</style>
