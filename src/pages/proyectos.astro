---
import Layout from "../layouts/Layout.astro";
import Header from "../sections/Header.astro";
import Projects from "../sections/Projects.astro";
import Footer from "../sections/Footer.astro";
import { useTranslations } from '../i18n/index';

const t = useTranslations('es');
---

<Layout
	title={t.meta.projectsTitle}
	description={t.meta.projectsDescription}
	keywords={t.meta.projectsKeywords}
>
	<Header />
	<script is:inline type="application/ld+json">{JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://marcgallego.com/" },
			{ "@type": "ListItem", "position": 2, "name": "Proyectos", "item": "https://marcgallego.com/proyectos/" }
		]
	})}</script>
	<main class="min-h-screen bg-primary pt-14">
		<Projects />
	</main>
	<Footer />
</Layout>
