---
import Layout from "../../layouts/Layout.astro";
import Header from "../../sections/Header.astro";
import ProjectsSection from "../../sections/Projects.astro";
import Footer from "../../sections/Footer.astro";
import { useTranslations } from '../../i18n/index';

const t = useTranslations('en');
---

<Layout
	title={t.meta.projectsTitle}
	description={t.meta.projectsDescription}
	keywords={t.meta.projectsKeywords}
	lang="en"
>
	<Header />
	<script is:inline type="application/ld+json">{JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://marcgallego.com/en/" },
			{ "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://marcgallego.com/en/projects/" }
		]
	})}</script>
	<main class="min-h-screen bg-primary pt-14">
		<ProjectsSection />
	</main>
	<Footer />
</Layout>
