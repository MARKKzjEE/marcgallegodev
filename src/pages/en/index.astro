---
import Layout from '../../layouts/Layout.astro';
import Header from '../../sections/Header.astro';
import Hero from '../../sections/Hero.astro';
import TechStack from '../../sections/TechStack.astro';
import WhatIDo from '../../sections/WhatIDo.astro';
import HomeProjects from '../../sections/HomeProjects.astro';
import Partners from '../../sections/Partners.astro';
import FAQ from '../../sections/FAQ.astro';
import AboutSection from '../../sections/AboutSection.astro';
import MarqueeBands from '../../sections/MarqueeBands.astro';
import Projects from '../../sections/Projects.astro';
import Footer from '../../sections/Footer.astro';
import { useTranslations } from '../../i18n/index';

const t = useTranslations('en');
---

<Layout
	title={t.meta.indexTitle}
	description={t.meta.indexDescription}
	keywords={t.meta.indexKeywords}
	lang="en"
>
	<Header />
	<main>
		<Hero />
		<WhatIDo />
		<HomeProjects />
		<TechStack />
		<Partners />
		<FAQ />
	</main>
	<Footer />
</Layout>
