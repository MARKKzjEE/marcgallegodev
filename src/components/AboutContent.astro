---
import { Image } from 'astro:assets';
import profileLight from '../assets/me/hero-profile-light.png';
import profileDark from '../assets/me/hero-profile-dark.png';
import { getLang, useTranslations } from '../i18n/index';

interface Props {
	showClose?: boolean;
}

const { showClose = false } = Astro.props;
const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<!-- ─── Mobile layout ─── -->
<div class="md:hidden">
	<!-- Título + close -->
	<div class="border-b border-secondary p-4 flex items-start justify-between">
		<h2 class="font-nord font-black text-secondary" style="font-size: clamp(44px, 8vw, 96px)">{t.about.title}</h2>
		{showClose && (
			<button class="about-close flex items-center justify-center w-10 h-10 shrink-0 cursor-pointer bg-transparent mt-2" data-about-close aria-label="Cerrar">
				<span class="about-close-line about-close-x"></span>
				<span class="about-close-line about-close-y"></span>
			</button>
		)}
	</div>
	<!-- Foto + texto -->
	<div class="p-4 flex flex-col gap-6">
		<div class="rounded-lg overflow-hidden">
			<Image src={profileDark} alt={t.about.profileAlt} widths={[600]} sizes="100vw" format="webp" quality={92} loading="lazy" class="w-full object-cover object-center dark:hidden" />
			<Image src={profileLight} alt={t.about.profileAlt} widths={[600]} sizes="100vw" format="webp" quality={92} loading="lazy" class="hidden w-full object-cover object-center dark:block" />
		</div>
		<p class="font-cottor font-light text-secondary text-[16px]">
			{t.about.bioMobile}
		</p>
	</div>
</div>

<!-- ─── Desktop layout ─── -->
<div class="hidden md:flex md:flex-col">

<!-- Zona superior: contenido + columna derecha -->
<div class="flex flex-1 min-h-0">
	<!-- Contenido principal (izquierda) -->
	<div class="flex flex-1 min-h-0 p-8 gap-8 max-w-350 mx-auto">
		<!-- Izquierda: textos -->
		<div class="flex flex-3 flex-col min-h-0">
			<div class="flex-1 flex gap-6 p-6">
				<div class="flex-1 flex items-start">
					<p class="font-cottor font-light text-secondary text-[18px]" set:html={t.about.bioDesktop1.replace(/\n\n/g, '<br><br>')} />
				</div>
				<div class="font-cottor font-light text-secondary flex-1 flex items-end">
					<p class="text-[18px]" set:html={t.about.bioDesktop2.replace(/\n\n/g, '<br><br>')} />
				</div>
			</div>
		</div>
		<!-- Derecha: imagen -->
		<div data-parallax-wrap class="relative flex-2 rounded-lg overflow-hidden min-h-0 mt-2 mx-2">
			<Image src={profileDark} alt={t.about.profileAlt} widths={[600, 900]} sizes="(max-width: 1400px) 600px, 900px" format="webp" quality={92} loading="lazy" class="about-profile-img h-full w-full object-cover object-center dark:hidden" />
			<Image src={profileLight} alt={t.about.profileAlt} widths={[600, 900]} sizes="(max-width: 1400px) 600px, 900px" format="webp" quality={92} loading="lazy" class="about-profile-img hidden h-full w-full object-cover object-center dark:block" />
		</div>
	</div>
	<!-- Columna lateral: close + tagline vertical -->
	<div class="flex flex-col border-l border-secondary w-10 shrink-0">
		{showClose && (
			<button class="about-close flex items-center justify-center w-10 h-10 shrink-0 border-b border-secondary cursor-pointer bg-transparent" data-about-close aria-label="Cerrar">
				<span class="about-close-line about-close-x"></span>
				<span class="about-close-line about-close-y"></span>
			</button>
		)}
		<div class="flex flex-1 items-center justify-center overflow-hidden">
			<p class="font-nord font-light text-secondary text-[10px] [writing-mode:vertical-rl] rotate-180">{t.about.tagline} <span class="inline-block rotate-90">™</span></p>
		</div>
	</div>
</div>
<!-- SOBRE MI: ancho completo abajo -->
<div class="flex border-t border-secondary py-4">
	<h3 class="font-nord font-black text-secondary mx-4 text-[125px]" aria-hidden="true">{t.about.titleDecorative}</h3>
</div>

</div><!-- end desktop layout -->

<style lang="scss">
	.about-close {
		position: relative;
	}

	.about-close-line {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 18px;
		height: 1.5px;
		background-color: var(--secondary);
	}

	.about-close-x {
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.about-close-y {
		transform: translate(-50%, -50%) rotate(-45deg);
	}
</style>
