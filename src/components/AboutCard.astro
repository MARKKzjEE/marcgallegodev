---
import '../styles/about-card.scss';
import { Image, getImage } from 'astro:assets';
import profileLight from '../assets/hero-profile-light.png';
import profileDark from '../assets/hero-profile-dark.png';

const optimizedLight = await getImage({ src: profileLight, format: 'webp', quality: 92, width: 900 });
const optimizedDark = await getImage({ src: profileDark, format: 'webp', quality: 92, width: 900 });
---

<link rel="preload" href={optimizedLight.src} as="image" type="image/webp" />
<link rel="preload" href={optimizedDark.src} as="image" type="image/webp" />

<div class="about-backdrop fixed inset-0 z-60 opacity-0 pointer-events-none" data-about-backdrop hidden aria-hidden="true"></div>

<div data-about-slot>
	<div id="about-card-panel" class="card-glass about-card relative outline-none" data-about-card tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="about-title" aria-expanded="false">
		<div class="about-compact p-8 flex flex-col justify-center" data-about-compact>
			<h1 id="about-title" class="font-nord font-bold text-white text-[125px] leading-[0.9] uppercase flex flex-col items-center">
				<span>Marc</span>
				<span>Gallego</span>
			</h1>
			<p class="font-monoblock font-normal text-white text-[18px] tracking-[0.3em] flex flex-col items-center mt-3">Esto es solo el principio</p>
		</div>
		<div class="about-expanded flex-1 flex-col min-h-0" data-about-expanded>
			<!-- Zona superior: contenido + columna derecha -->
			<div class="flex flex-1 min-h-0">
				<!-- Contenido principal (izquierda) -->
				<div class="flex flex-1 min-h-0 p-8 gap-8">
					<!-- Izquierda: textos + contenido -->
					<div class="flex flex-3 flex-col min-h-0">
						<div class="flex-1 flex gap-6 p-6">
							<div class="flex-1 flex items-start">
								<p class="font-cottor font-light text-secondary leading-7 text-justify">
									Me apasiona la tecnología y su evolución constante. Disfruto aprendiendo y probando nuevas herramientas, siempre con criterio y pensando en qué aporta realmente valor al proyecto.
									<br><br>Soy exigente con mi trabajo y cuido los detalles. No busco solo que algo funcione, sino que esté bien pensado y bien construido.
									<br><br>Trabajo con transparencia porque creo que es la base de cualquier buena colaboración: claridad en lo que se hace, por qué se hace y hacia dónde vamos.
								</p>
							</div>
							<div class="font-cottor font-light text-secondary flex-1 flex items-end">
								<p class="leading-7 text-justify">
									Más allá del desarrollo, podrás ver una clara referencia al mar, mi equilibrio. Es el lugar donde desconecto, ordeno ideas y vuelvo con claridad. 
									<br><br>También me mueve la moda y la creatividad contemporánea: me inspira cómo el arte y la identidad se mezclan y se expresan sin límites. Esa forma de entender la creatividad también define mi trabajo: no solo construyo soluciones, busco que tengan carácter.</p>
							</div>
						</div>
					</div>
					<!-- Derecha: imagen -->
					<div class="relative flex-2 rounded-lg overflow-hidden min-h-0 m-2">
						<Image src={profileDark} alt="Marc Gallego" widths={[600, 900]} sizes="(max-width: 1400px) 600px, 900px" format="webp" quality={92} class="h-full w-full object-cover object-top dark:hidden" />
						<Image src={profileLight} alt="Marc Gallego" widths={[600, 900]} sizes="(max-width: 1400px) 600px, 900px" format="webp" quality={92} class="hidden h-full w-full object-cover object-top dark:block" />
					</div>
				</div>
				<!-- Columna derecha con bordes -->
				<div class="flex flex-col border-l border-secondary">
					<button type="button" class="about-close relative w-10 h-10 border-b border-secondary cursor-pointer opacity-0 pointer-events-none transition-[opacity,background-color] duration-200" data-about-close aria-label="Cerrar sobre mi">
						<span class="about-close-x absolute top-1/2 left-1/2 w-4 h-0.5 bg-secondary" aria-hidden="true"></span>
						<span class="about-close-y absolute top-1/2 left-1/2 w-4 h-0.5 bg-secondary" aria-hidden="true"></span>
					</button>
					<div class="flex flex-1 items-center justify-center">
						<p class="font-nord font-light text-secondary text-[10px] uppercase tracking-[0.2em] [writing-mode:vertical-rl] rotate-180">Diseño creativo & desarrollo digital desde 2018 <span class="inline-block rotate-90">™</span></p>
					</div>
				</div>
			</div>
			<!-- SOBRE MI: ancho completo abajo -->
			<div class="flex border-t border-secondary py-4">
				<h3 class="font-nord font-black text-secondary mx-4 text-9xl tracking-tighter" aria-hidden="true">SOBRE MI</h3>
			</div>
		</div>
	</div>
</div>

<script>
	import { initAboutCard } from "../scripts/about-card";

	initAboutCard();
</script>
