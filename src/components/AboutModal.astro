---
import AboutContent from './AboutContent.astro';
---

<!-- Backdrop -->
<div class="about-backdrop fixed inset-0 z-60 opacity-0 pointer-events-none" data-about-backdrop aria-hidden="true"></div>

<!-- Panel modal -->
<div
	class="about-panel"
	data-about-panel
	role="dialog"
	aria-modal="true"
	aria-expanded="false"
	aria-label="Sobre mi"
	tabindex="-1"
>
	<!-- Expanded content (se muestra mid-animation) -->
	<div class="about-expanded" data-about-expanded aria-hidden="true">
		<AboutContent showClose />
	</div>
</div>

<style lang="scss">
	// ─── Backdrop ───
	.about-backdrop {
		transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1);
		background-color: rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);

		&.is-visible {
			opacity: 1;
			pointer-events: auto;
		}
	}

	// ─── Panel ───
	.about-panel {
		position: fixed;
		top: var(--about-gap, 24px);
		bottom: var(--about-gap, 24px);
		left: var(--about-gap, 24px);
		right: var(--about-gap, 24px);
		max-width: 1400px;
		max-height: 900px;
		margin: auto;
		z-index: 70;
		overflow: hidden;
		border-radius: 8px;
		display: flex;
		flex-direction: column;
		background-color: rgba(0, 0, 0, 0.10);
		outline: none;
		visibility: hidden;
		pointer-events: none;
		transition:
			transform 550ms cubic-bezier(0.22, 1, 0.36, 1),
			border-radius 550ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 500ms cubic-bezier(0.22, 1, 0.36, 1);

		&.no-transition {
			transition: none !important;
		}

		&.is-expanded {
			visibility: visible;
			pointer-events: auto;
		}

		&.is-morphing {
			background-color: var(--terciary);
			overflow-y: auto;
		}

		@media (max-width: 767px) {
			--about-gap: 12px;
			max-height: none;
		}
	}

	// ─── Expanded content ───
	.about-expanded {
		display: flex;
		flex: 1;
		min-height: 0;
		visibility: hidden;
		opacity: 0;
		transform: translateY(6px);
		pointer-events: none;
		transition:
			opacity 280ms ease-out,
			transform 280ms ease-out,
			visibility 0ms linear 280ms;

		&.is-visible {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
			transition:
				opacity 280ms ease-out,
				transform 280ms ease-out,
				visibility 0ms linear 0ms;
		}
	}
</style>

<script>
	import { initAboutModal } from '../scripts/about-modal';
	initAboutModal();
</script>
