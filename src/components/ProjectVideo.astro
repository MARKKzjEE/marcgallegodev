---
import type { ProjectVideo } from '../data/projects';

// Miniatura animada de un proyecto: vídeo en bucle, sin sonido, encima de su
// imagen (que va en el mismo contenedor, con posición relativa). Es solo
// decoración: la imagen lleva el alt. Se ve cuando ya se está reproduciendo
// (.is-playing, scripts/project-video.ts); antes, con reduced motion o si no
// carga, se queda la imagen.
//   play="view"  (por defecto) arranca al verse.
//   play="hover" arranca al pasar el ratón por su tarjeta, el ancestro con
//                `data-hover-target`.

interface Props {
	video: ProjectVideo;
	play?: 'view' | 'hover';
}

const { video, play = 'view' } = Astro.props;
---

<video
	class="project-video"
	muted
	loop
	playsinline
	preload="none"
	aria-hidden="true"
	tabindex="-1"
	data-play-in-view={play === 'view' ? '' : undefined}
	data-play-on-hover={play === 'hover' ? '' : undefined}
>
	<source src={video.av1} type='video/mp4; codecs="av01.0.05M.08"' />
	<source src={video.src} type="video/mp4" />
</video>

<style lang="scss">
	.project-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
		opacity: 0;
		transition:
			opacity 400ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);

		&.is-playing { opacity: 1; }

		@media (prefers-reduced-motion: reduce) { display: none; }
	}
</style>

<script>
	import '../scripts/project-video.ts';
</script>
